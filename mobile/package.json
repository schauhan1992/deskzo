{
  "name": "deskzo-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.17",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.9",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.18",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android:dev": "node scripts/android.js",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "lint": "expo lint",
    "test": "jest",
    "ios:dev": "node scripts/ios.js dev",
    "ios:check": "node scripts/ios.js check",
    "ios:build:preview": "npx eas-cli@latest build --platform ios --profile preview",
    "ios:build:production": "npx eas-cli@latest build --platform ios --profile production"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-secure-store",
          "expo-splash-screen"
        ]
      },
      "ios": {
        "exclude": [
          "@bacons/apple-targets"
        ]
      }
    }
  },
  "private": true
}
