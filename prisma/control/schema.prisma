// The control plane: the platform's own database, apart from every workspace's.
//
// Which workspaces exist, where each one's database is, the keys its secrets are sealed under,
// which addresses reach it. One per installation, at CONTROL_DATABASE_URL. Workspace data never
// lives here, and nothing here is readable from a workspace's database.
//
//   npm run control:generate   the client, into node_modules/@wroffy/control-client — a package of
//                              its own, like Prisma's main client, so Next loads it as-is instead
//                              of bundling it (next.config.ts, serverExternalPackages)
//   npm run control:migrate    apply migrations to CONTROL_DATABASE_URL

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@wroffy/control-client"
}

datasource db {
  provider = "postgresql"
  url      = env("CONTROL_DATABASE_URL")
}

enum TenantStatus {
  /// Being set up: its database is not ready yet. Reaches nothing.
  PROVISIONING
  ACTIVE
  /// Held — unpaid, or by staff. Reaches a notice, not the app.
  SUSPENDED
  /// A migration is running or failed on it. Held at the maintenance page until retried.
  MIGRATING
  /// Its database is gone. Kept for the record.
  DEPROVISIONED
}

enum DomainKind {
  /// An address of the customer's own, pointed at the platform.
  CUSTOM
  /// An address from before workspaces existed, kept reaching the first one.
  LEGACY
}

/// A customer of the SaaS: one database, one set of keys, one or more addresses.
model Tenant {
  id     String       @id @default(cuid())
  /// The subdomain: `<slug>.<PLATFORM_DOMAIN>`. Lower-case, 3–40, never reserved.
  slug   String       @unique
  name   String
  status TenantStatus @default(PROVISIONING)

  /// The workspace scripts and check suites act as when nothing else says — the one adopted from
  /// the installation that existed before workspaces. At most one (a partial unique index).
  isDefault Boolean @default(false)

  region String @default("in")
  /// The database's name on its server, for the operator. The URL itself is only ever sealed. Empty
  /// while the workspace is being set up.
  dbName      String?
  /// The database URL, sealed under the platform key with the tenant id as associated data. Empty
  /// while the workspace is being set up, and after it is deprovisioned.
  dbUrlCipher String?
  /// The database's own login role, for the operator and for dropping it.
  dbRole      String?

  /// The workspace's keys (stored secrets, fingerprints, links, render passes, cookies, sessions),
  /// sealed under the platform key with the tenant id as associated data — see src/lib/tenancy/keys.ts.
  keyBundleCipher  String
  keyBundleVersion Int    @default(1)

  /// The newest migration applied to its database, as last seen.
  schemaVersion String?

  /// Defaults for its legal entities, until those exist.
  country  String @default("IN")
  currency String @default("INR")
  timezone String @default("Asia/Kolkata")

  ownerEmail String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  suspendedAt     DateTime?
  deprovisionedAt DateTime?

  domains          TenantDomain[]
  deviceRoutes     BiometricDeviceRoute[]
  auditLog         PlatformAuditLog[]
  provisioningJobs ProvisioningJob[]
  handoffTickets   PlatformHandoffTicket[]
  migrationRuns    TenantMigrationRun[]

  @@map("tenants")
}

/// An address other than the workspace's own subdomain.
model TenantDomain {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Normalised: lower-case, with the port when there is one ("erp.acme.com", "localhost:3000").
  host      String     @unique
  kind      DomainKind
  /// Links in emails and documents are built on this one, when set; otherwise on the subdomain.
  isPrimary Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([tenantId])
  @@map("tenant_domains")
}

/// Which workspace a biometric terminal belongs to, by its serial number — for terminals that
/// reach the server on a bare IP address, which names no workspace.
model BiometricDeviceRoute {
  serial     String    @id
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  @@index([tenantId])
  @@map("biometric_device_routes")
}

enum PlatformActorKind {
  /// A script run by the operator on the server.
  SCRIPT
  /// The platform itself: a job, a webhook.
  SYSTEM
  /// A member of staff, in the console.
  STAFF
}

/// What was done to a workspace from outside it.
model PlatformAuditLog {
  id        String            @id @default(cuid())
  at        DateTime          @default(now())
  actorKind PlatformActorKind
  /// Who: a staff member's id, a script's name.
  actor     String
  action    String
  tenantId  String?
  tenant    Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  detail    Json?

  @@index([tenantId, at])
  @@map("platform_audit_log")
}

/// A scheduled job running for one workspace — so two schedulers (the platform's fan-out and an
/// older per-workspace cron) never run the same job for the same workspace at once, and the
/// console can see when each last ran and how it went. Not tied to a Tenant row: workspaces read
/// from the environment (check suites) are leased the same way.
model TenantJobLease {
  tenantId       String
  /// e.g. "marketing-tick", "backup-tick".
  job            String
  /// Nobody else may start it before this. Longer than the job's own time limit.
  leasedUntil    DateTime
  /// Which process holds it: host and pid, for the log.
  holder         String
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lastOk         Boolean?
  /// The failure, in a line. Cleared by the next success.
  lastError      String?

  @@id([tenantId, job])
  @@map("tenant_job_leases")
}

enum ProvisioningStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// Setting one workspace up: its database, its first owner, its organisation. Taken by the platform
/// worker (scripts/platform-worker.ts), one at a time per job, with SKIP LOCKED.
model ProvisioningJob {
  id         String             @id @default(cuid())
  tenantId   String
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status     ProvisioningStatus @default(PENDING)
  /// Where it has got to, in words — what the signup progress page shows.
  step       String             @default("Waiting to start")
  attempts   Int                @default(0)
  runAfter   DateTime           @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?

  /// The first owner. The password arrives already hashed, and the hash is cleared once they exist.
  ownerName         String
  ownerEmail        String
  ownerPasswordHash String?
  /// The organisation's legal name, and its country (ISO 3166-1 alpha-2).
  companyName String
  country     String

  createdAt DateTime @default(now())

  @@index([status, runAfter])
  @@index([tenantId])
  @@map("provisioning_jobs")
}

/// A database made and migrated ahead of time, so a signup does not wait for either.
model WarmDatabase {
  id                String    @id @default(cuid())
  dbName            String    @unique
  dbRole            String
  /// Its address, sealed for the platform until a workspace takes it and it is sealed for that one.
  dbUrlCipher       String
  schemaVersion     String?
  createdAt         DateTime  @default(now())
  claimedAt         DateTime?
  claimedByTenantId String?

  @@index([claimedAt])
  @@map("warm_databases")
}

/// An invitation to sign up — the only way in until billing is live.
model SignupInvite {
  /// SHA-256 of the code; the code itself is shown once, to whoever made it.
  codeHash  String    @id
  note      String?
  maxUses   Int       @default(1)
  uses      Int       @default(0)
  expiresAt DateTime?
  createdBy String?
  createdAt DateTime  @default(now())

  @@map("signup_invites")
}

/// A signup between the form and the workspace: waiting for its email code, then provisioning.
model PendingSignup {
  id           String    @id @default(cuid())
  email        String
  ownerName    String
  companyName  String
  slug         String
  country      String
  /// bcrypt, as the owner's account will hold it.
  passwordHash String
  inviteCodeHash String
  /// SHA-256 of the code emailed to prove the address.
  codeHash      String
  codeExpiresAt DateTime
  attempts      Int       @default(0)
  /// SHA-256 of the secret in the signing-up browser's cookie: only that browser follows the progress
  /// and is signed in at the end.
  browserSecretHash String
  verifiedAt DateTime?
  tenantId   String?   @unique
  /// When the owner was handed to their workspace — once.
  handedOffAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([slug])
  @@map("pending_signups")
}

/// A one-time pass that signs somebody into a workspace without a password: the owner straight after
/// signing up, and later support staff. Good for sixty seconds, once.
model PlatformHandoffTicket {
  /// SHA-256 of the ticket; the ticket itself travels once, in a redirect.
  tokenHash String    @id
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String
  /// "owner-signup" or "support".
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId])
  @@map("platform_handoff_tickets")
}

/// One migration of one database in one run of `npm run tenants:migrate`.
model TenantMigrationRun {
  id          String    @id @default(cuid())
  /// Groups one invocation.
  runId       String
  /// "reference", "warm:<database>", or the workspace's slug.
  target      String
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  ok          Boolean?
  fromVersion String?
  toVersion   String?
  /// The tail of Prisma's output, for a failure.
  output      String?

  @@index([runId])
  @@index([tenantId, startedAt])
  @@map("tenant_migration_runs")
}

enum StaffRole {
  /// Everything, including managing staff.
  OWNER
  /// Workspaces: hold, reopen, close; plans; the platform's data.
  ADMIN
  /// Looking at workspaces, and entering one on its super admin's grant.
  SUPPORT
  /// Plans, subscriptions and invoices.
  BILLING
  /// Looking only.
  READONLY
}

/// Somebody who works on the platform — signs in to the console (admin.<domain>), never to a workspace
/// directly. Two-factor is required: enrolled at the first sign-in, before anything else opens.
model PlatformUser {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  role             StaffRole
  passwordHash     String
  /// SHA-256 of a one-time link to choose a password: a new staff member's first, or a reset. It
  /// works until `passwordSetupExpiresAt`, once.
  passwordSetupHash      String?   @unique
  passwordSetupExpiresAt DateTime?
  /// The authenticator secret, sealed under the platform key. Null until enrolment starts.
  totpSecretCipher String?
  /// When enrolment finished. Until then only the enrolment page opens.
  totpEnabledAt    DateTime?
  active           Boolean   @default(true)
  lastSignInAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions PlatformSession[]

  @@map("platform_users")
}

/// One staff sign-in. Checked on every console request: thirty minutes idle, twelve hours at most,
/// and revocable from the console.
model PlatformSession {
  /// SHA-256 of the cookie's token; the token itself is only ever in the cookie.
  id         String       @id
  userId     String
  user       PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  lastSeenAt DateTime     @default(now())
  expiresAt  DateTime
  /// When the second factor was passed in this session. Null: only enrolment opens.
  mfaAt      DateTime?
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  @@index([userId])
  @@map("platform_sessions")
}

enum SupportAccessLevel {
  /// Every "view" permission, nothing else.
  READONLY
  /// An administrator's permissions — never the super admin's.
  ADMIN
}

/// A workspace's super admin letting platform support in, for a while. Given and ended from the
/// workspace's own Security settings; staff can see it and use it, never make one.
model SupportAccessGrant {
  id              String             @id @default(cuid())
  tenantId        String
  level           SupportAccessLevel
  reason          String
  /// Who in the workspace gave it — their id and name there, for the record.
  grantedByUserId String
  grantedByName   String
  createdAt       DateTime           @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?

  @@index([tenantId, expiresAt])
  @@map("support_access_grants")
}
