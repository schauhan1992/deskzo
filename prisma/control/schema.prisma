// The control plane: the platform's own database, apart from every workspace's.
//
// Which workspaces exist, where each one's database is, the keys its secrets are sealed under,
// which addresses reach it. One per installation, at CONTROL_DATABASE_URL. Workspace data never
// lives here, and nothing here is readable from a workspace's database.
//
//   npm run control:generate   the client, into node_modules/@deskzo/control-client — a package of
//                              its own, like Prisma's main client, so Next loads it as-is instead
//                              of bundling it (next.config.ts, serverExternalPackages)
//   npm run control:migrate    apply migrations to CONTROL_DATABASE_URL

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@deskzo/control-client"
}

datasource db {
  provider = "postgresql"
  url      = env("CONTROL_DATABASE_URL")
}

enum TenantStatus {
  /// Being set up: its database is not ready yet. Reaches nothing.
  PROVISIONING
  ACTIVE
  /// Held — unpaid, or by staff. Reaches a notice, not the app.
  SUSPENDED
  /// A migration is running or failed on it. Held at the maintenance page until retried.
  MIGRATING
  /// Its database is gone. Kept for the record.
  DEPROVISIONED
}

enum DomainKind {
  /// An address of the customer's own, pointed at the platform.
  CUSTOM
  /// An address from before workspaces existed, kept reaching the first one.
  LEGACY
}

/// Whether an address is served. Only ACTIVE ones reach a workspace or are used for its links.
enum DomainStatus {
  /// Added by its workspace, waiting for its DNS records to prove the domain is theirs. Several
  /// workspaces may be waiting on the same address; whichever's record is found first gets it.
  PENDING
  /// Verified (or a legacy address, which needs none): served, and may be the address links use.
  ACTIVE
  /// Was active, but its records stopped checking out for longer than the grace period. Not served
  /// until a check passes again.
  BROKEN
}

/// A customer of the SaaS: one database, one set of keys, one or more addresses.
model Tenant {
  id     String       @id @default(cuid())
  /// The subdomain: `<slug>.<PLATFORM_DOMAIN>`. Lower-case, 3–40, never reserved.
  slug   String       @unique
  name   String
  status TenantStatus @default(PROVISIONING)

  /// The workspace scripts and check suites act as when nothing else says — the one adopted from
  /// the installation that existed before workspaces. At most one (a partial unique index).
  isDefault Boolean @default(false)

  region String @default("in")
  /// The database's name on its server, for the operator. The URL itself is only ever sealed. Empty
  /// while the workspace is being set up.
  dbName      String?
  /// The database URL, sealed under the platform key with the tenant id as associated data. Empty
  /// while the workspace is being set up, and after it is deprovisioned.
  dbUrlCipher String?
  /// The database's own login role, for the operator and for dropping it.
  dbRole      String?

  /// The workspace's keys (stored secrets, fingerprints, links, render passes, cookies, sessions),
  /// sealed under the platform key with the tenant id as associated data — see src/lib/tenancy/keys.ts.
  keyBundleCipher  String
  keyBundleVersion Int    @default(1)

  /// The newest migration applied to its database, as last seen.
  schemaVersion String?

  /// Defaults for its legal entities, until those exist.
  country  String @default("IN")
  currency String @default("INR")
  timezone String @default("Asia/Kolkata")

  ownerEmail String?

  /// What it may use — its plans' modules and limits, with staff overrides — worked out whenever one
  /// of those changes (src/lib/platform/entitlements.ts) and read from here with the rest of the
  /// workspace, so no request queries plans to ask "is this module in the plan". Null: never worked
  /// out, which means the core only.
  entitlements         Json?
  /// Staff overrides of the plans' limits, for this workspace alone. Null: the plans decide.
  seatOverride         Int?
  copilotTokenOverride Int?
  /// Staff override of how many custom domains it may have. Null: the plans decide.
  customDomainOverride Int?

  /// Why it is held, when it is. A billing hold lets its owner reach the billing page and nothing
  /// else, and is lifted by paying; a staff hold only by staff.
  suspendedFor       SuspendedFor?
  /// Where billing mail goes (the owner's address until they give another), and the tax number put on
  /// its invoices — a GSTIN in India, a VAT number elsewhere.
  billingEmail       String?
  taxId              String?
  /// Its customer at each gateway, once it has been one.
  stripeCustomerId   String?       @unique
  razorpayCustomerId String?       @unique

  /// Staff labels: lower-case, 1–24 chars, at most ten (a CHECK in the migration). Never read by the workspace.
  tags String[] @default([])

  /// The partner it belongs to now — kept in step with tenant_attributions in the same transaction.
  partnerId String?
  partner   Partner? @relation("TenantPartner", fields: [partnerId], references: [id], onDelete: Restrict)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  suspendedAt     DateTime?
  deprovisionedAt DateTime?

  domains          TenantDomain[]
  deviceRoutes     BiometricDeviceRoute[]
  auditLog         PlatformAuditLog[]
  provisioningJobs ProvisioningJob[]
  handoffTickets   PlatformHandoffTicket[]
  migrationRuns    TenantMigrationRun[]
  subscriptions    Subscription[]
  moduleOverrides  TenantModuleOverride[]
  invoices         Invoice[]
  usage            TenantUsage[]
  billingNotices   BillingNotice[]
  notes            TenantNote[]
  supportRequests  SupportRequest[]

  /// The partner programme: who it belonged to, what was earned on it, deals naming it.
  attributions      TenantAttribution[]
  commissionEntries CommissionEntry[]
  deals             DealRegistration[]

  /// Linked sign-in: its accounts in link groups, links asked from and to it, switches into it, its own
  /// switch-in rule, and the "find my workspace" index of its members' addresses.
  linkMembers       LinkMember[]
  linkIntentsOut    LinkIntent[]       @relation("LinkIntentSource")
  linkIntentsIn     LinkIntent[]       @relation("LinkIntentTarget")
  linkSwitchTickets LinkSwitchTicket[]
  signInPolicy      TenantSignInPolicy?
  emailIndex        WorkspaceEmail[]

  @@index([tags], type: Gin)
  @@index([partnerId])
  @@map("tenants")
}

/// An address other than the workspace's own subdomain.
model TenantDomain {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Normalised: lower-case, with the port when there is one ("erp.acme.com", "localhost:3000").
  /// Unique among addresses that are not PENDING (a partial unique index in the migration).
  host      String
  kind      DomainKind
  status    DomainStatus @default(ACTIVE)
  /// Links in emails and documents are built on this one, when set and ACTIVE; otherwise on the
  /// subdomain.
  isPrimary Boolean      @default(false)
  /// The value of the TXT record at `_domain-verify.<host>` that proves the workspace controls the
  /// domain. Kept after verification: the daily re-check reads it again. None for a LEGACY address.
  verifyToken    String?
  verifiedAt     DateTime?
  lastCheckedAt  DateTime?
  /// What the last check found wrong, in words for the workspace's owner; null when it passed.
  lastCheckError String?
  /// Since when an ACTIVE address's checks have been failing; cleared when one passes.
  failingSince   DateTime?
  /// Who added it: a workspace person's email, or "staff:<email>".
  addedBy        String?
  createdAt      DateTime     @default(now())

  @@unique([tenantId, host])
  @@index([host])
  @@index([tenantId])
  @@index([status])
  @@map("tenant_domains")
}

/// Which workspace a biometric terminal belongs to, by its serial number — for terminals that
/// reach the server on a bare IP address, which names no workspace.
model BiometricDeviceRoute {
  serial     String    @id
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  @@index([tenantId])
  @@map("biometric_device_routes")
}

enum PlatformActorKind {
  /// A script run by the operator on the server.
  SCRIPT
  /// The platform itself: a job, a webhook.
  SYSTEM
  /// A member of staff, in the console.
  STAFF
}

/// What was done to a workspace from outside it.
model PlatformAuditLog {
  id        String            @id @default(cuid())
  at        DateTime          @default(now())
  actorKind PlatformActorKind
  /// Who: a staff member's id, a script's name.
  actor     String
  action    String
  tenantId  String?
  tenant    Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  detail    Json?

  @@index([tenantId, at])
  // The console's audit explorer: everything newest first, one action's, one actor's.
  @@index([at])
  @@index([action, at])
  @@index([actor, at])
  @@map("platform_audit_log")
}

/// A scheduled job running for one workspace — so two schedulers (the platform's fan-out and an
/// older per-workspace cron) never run the same job for the same workspace at once, and the
/// console can see when each last ran and how it went. Not tied to a Tenant row: workspaces read
/// from the environment (check suites) are leased the same way.
model TenantJobLease {
  tenantId       String
  /// e.g. "marketing-tick", "backup-tick".
  job            String
  /// Nobody else may start it before this. Longer than the job's own time limit.
  leasedUntil    DateTime
  /// Which process holds it: host and pid, for the log.
  holder         String
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lastOk         Boolean?
  /// The failure, in a line. Cleared by the next success.
  lastError      String?

  @@id([tenantId, job])
  @@map("tenant_job_leases")
}

enum ProvisioningStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// Setting one workspace up: its database, its first owner, its organisation. Taken by the platform
/// worker (scripts/platform-worker.ts), one at a time per job, with SKIP LOCKED.
model ProvisioningJob {
  id         String             @id @default(cuid())
  tenantId   String
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status     ProvisioningStatus @default(PENDING)
  /// Where it has got to, in words — what the signup progress page shows.
  step       String             @default("Waiting to start")
  attempts   Int                @default(0)
  runAfter   DateTime           @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?

  /// The first owner. The password arrives already hashed, and the hash is cleared once they exist.
  ownerName         String
  ownerEmail        String
  ownerPasswordHash String?
  /// The organisation's legal name, and its country (ISO 3166-1 alpha-2).
  companyName String
  country     String
  /// The plan it starts on — its invitation's, or the default plan's when null.
  planKey     String?
  /// The industry template chosen at signup (src/lib/industry-templates), applied as the workspace is set up.
  industryTemplate String?

  createdAt DateTime @default(now())

  @@index([status, runAfter])
  @@index([tenantId])
  @@map("provisioning_jobs")
}

/// A database made and migrated ahead of time, so a signup does not wait for either.
model WarmDatabase {
  id                String    @id @default(cuid())
  dbName            String    @unique
  dbRole            String
  /// Its address, sealed for the platform until a workspace takes it and it is sealed for that one.
  dbUrlCipher       String
  schemaVersion     String?
  createdAt         DateTime  @default(now())
  claimedAt         DateTime?
  claimedByTenantId String?

  @@index([claimedAt])
  @@map("warm_databases")
}

/// An invitation to sign up — the only way in until billing is live.
model SignupInvite {
  /// SHA-256 of the code; the code itself is shown once, to whoever made it.
  codeHash  String    @id
  note      String?
  maxUses   Int       @default(1)
  uses      Int       @default(0)
  expiresAt DateTime?
  createdBy String?
  /// The plan a workspace set up with it starts on; null: the default plan.
  planKey   String?
  createdAt DateTime  @default(now())
  /// A partner's invitation code: the workspace it sets up is attributed to that partner.
  partnerId String?
  partner   Partner?  @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  /// The code's last four characters, so a partner can tell its codes apart.
  codeHint  String?
  /// An address staff hold for the customer this invitation is for: nobody else may take it while
  /// the invitation is open, and a signup with this code gets exactly it — without the signup rules
  /// (eight letters, made from the registered name). Never a platform address, never one taken.
  heldSlug              String?  @unique
  /// The held address may also be a reserved word or a blocked name (an owner or admin's choice).
  heldSlugSkipsReserved Boolean  @default(false)

  @@index([partnerId, createdAt])
  @@map("signup_invites")
}

/// What a staff rule about workspace names does.
enum NameRuleKind {
  /// Refused: exactly this name.
  BLOCK_EXACT
  /// Refused: any name with this word in it.
  BLOCK_WORD
  /// A built-in reserved word, or our name or a competitor's, that staff have let through.
  RELEASE
}

/// Staff's own rules for workspace names, on top of the built-in ones (src/lib/workspace-names.ts):
/// names and words they block, and built-in words they release. A platform address
/// (src/lib/tenancy/host.ts) can never be released.
model WorkspaceNameRule {
  id        String       @id @default(cuid())
  /// Lower-case. A name for BLOCK_EXACT; a word of letters and digits for BLOCK_WORD and RELEASE.
  value     String
  kind      NameRuleKind
  /// Why — shown in the console, never to a customer.
  reason    String
  /// The staff member's id.
  createdBy String
  createdAt DateTime     @default(now())

  @@unique([kind, value])
  @@map("workspace_name_rules")
}

/// A signup between the form and the workspace: waiting for its email code, then provisioning.
model PendingSignup {
  id           String    @id @default(cuid())
  email        String
  ownerName    String
  companyName  String
  slug         String
  country      String
  /// bcrypt, as the owner's account will hold it.
  passwordHash String
  /// The invitation it came with — none once signup is open to everybody.
  inviteCodeHash String?
  /// SHA-256 of the code emailed to prove the address.
  codeHash      String
  codeExpiresAt DateTime
  attempts      Int       @default(0)
  /// SHA-256 of the secret in the signing-up browser's cookie: only that browser follows the progress
  /// and is signed in at the end.
  browserSecretHash String
  verifiedAt DateTime?
  tenantId   String?   @unique
  /// When the owner was handed to their workspace — once.
  handedOffAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())
  /// A partner's referral code on the form, and how it got there: "link" | "cookie" | "typed" (informational).
  referralCode String?
  referralVia  String?
  /// The industry template chosen on the form, if any — src/lib/industry-templates/catalogue.ts keys.
  industryTemplate String?

  @@index([email])
  @@index([slug])
  @@index([createdAt])
  @@map("pending_signups")
}

/// A one-time pass that signs somebody into a workspace without a password: the owner straight after
/// signing up, and later support staff. Good for sixty seconds, once.
model PlatformHandoffTicket {
  /// SHA-256 of the ticket; the ticket itself travels once, in a redirect.
  tokenHash String    @id
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String
  /// "owner-signup" or "support".
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId])
  @@map("platform_handoff_tickets")
}

/// One migration of one database in one run of `npm run tenants:migrate`.
model TenantMigrationRun {
  id          String    @id @default(cuid())
  /// Groups one invocation.
  runId       String
  /// "reference", "warm:<database>", or the workspace's slug.
  target      String
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  ok          Boolean?
  fromVersion String?
  toVersion   String?
  /// The tail of Prisma's output, for a failure.
  output      String?

  @@index([runId])
  @@index([tenantId, startedAt])
  @@map("tenant_migration_runs")
}

enum StaffRole {
  /// Everything, including managing staff.
  OWNER
  /// Workspaces: hold, reopen, close; plans; the platform's data.
  ADMIN
  /// Looking at workspaces, and entering one on its super admin's grant.
  SUPPORT
  /// Plans, subscriptions and invoices.
  BILLING
  /// Looking only.
  READONLY
}

/// Somebody who works on the platform — signs in to the console (admin.<domain>), never to a workspace
/// directly. Two-factor is required: enrolled at the first sign-in, before anything else opens.
model PlatformUser {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  role             StaffRole
  passwordHash     String
  /// SHA-256 of a one-time link to choose a password: a new staff member's first, or a reset. It
  /// works until `passwordSetupExpiresAt`, once.
  passwordSetupHash      String?   @unique
  passwordSetupExpiresAt DateTime?
  /// The authenticator secret, sealed under the platform key. Null until enrolment starts.
  totpSecretCipher String?
  /// When enrolment finished. Until then only the enrolment page opens.
  totpEnabledAt    DateTime?
  active           Boolean   @default(true)
  lastSignInAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions PlatformSession[]
  /// Support requests assigned to them, and what they wrote on requests (src/lib/support).
  assignedSupportRequests SupportRequest[] @relation("SupportAssignee")
  supportEntries          SupportEntry[]   @relation("SupportEntryAuthor")

  @@map("platform_users")
}

/// One staff sign-in. Checked on every console request: thirty minutes idle, twelve hours at most,
/// and revocable from the console.
model PlatformSession {
  /// SHA-256 of the cookie's token; the token itself is only ever in the cookie.
  id         String       @id
  userId     String
  user       PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  lastSeenAt DateTime     @default(now())
  expiresAt  DateTime
  /// When the second factor was passed in this session. Null: only enrolment opens.
  mfaAt      DateTime?
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  @@index([userId])
  @@map("platform_sessions")
}

enum SupportAccessLevel {
  /// Every "view" permission, nothing else.
  READONLY
  /// An administrator's permissions — never the super admin's.
  ADMIN
}

/// A workspace's super admin letting platform support in, for a while. Given and ended from the
/// workspace's own Security settings; staff can see it and use it, never make one.
model SupportAccessGrant {
  id              String             @id @default(cuid())
  tenantId        String
  level           SupportAccessLevel
  reason          String
  /// Who in the workspace gave it — their id and name there, for the record.
  grantedByUserId String
  grantedByName   String
  createdAt       DateTime           @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?

  @@index([tenantId, expiresAt])
  @@map("support_access_grants")
}

// ─── Plans and what a workspace may use (M7) ─────────────────────────────────────────────────────

enum PlanKind {
  /// A workspace's base: the modules it runs on and the people included.
  EDITION
  /// Several modules sold together, on top of an edition.
  BUNDLE
  /// One more thing: a module, more seats, more copilot.
  ADDON
  /// Never sold: the installation's own workspace, and workspaces staff use for testing.
  INTERNAL
}

/// Something a workspace can be on. Prices, and the gateways that charge them, arrive with billing.
model Plan {
  id          String   @id @default(cuid())
  /// Stable, for invitations and scripts: "crm-starter", "internal-everything".
  key         String   @unique
  name        String
  kind        PlanKind
  description String?
  /// Every module there is, including ones added later.
  allModules  Boolean  @default(false)
  /// ISO 3166-1 alpha-2 codes of the countries it is sold in; empty: everywhere. A module sold only
  /// in some countries (src/lib/modules.ts) is left out elsewhere whatever the plan says.
  countries   String[] @default([])
  /// People included, for each unit of quantity. Null: no limit.
  seats         Int?
  /// AI copilot tokens a month, for each unit of quantity. Null: no limit; 0: none.
  copilotTokens Int?
  /// The product it sells (src/lib/products.ts: crm, books, … or one for the whole suite). A workspace
  /// holds at most one plan per product; Deskzo One holds every product, so no other with it. Null: an
  /// add-on, a bundle or an internal plan, which belongs to no product.
  productKey    String?
  /// Custom domains a workspace may add, for each unit of quantity. Null: no limit; 0: none (the
  /// default, so a plan offers them only when staff say so).
  customDomains Int?    @default(0)
  /// New workspaces start on it unless their invitation names another. At most one (a partial
  /// unique index).
  isDefault   Boolean  @default(false)
  /// Retired plans stay on the workspaces already on them, but are not given to any more.
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  /// The product its Stripe prices hang off, made with the first of them.
  stripeProductId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules PlanModule[]
  items   SubscriptionItem[]
  prices  PlanPrice[]

  @@index([productKey])
  @@map("plans")
}

model PlanModule {
  planId    String
  plan      Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// A key from src/lib/modules.ts.
  moduleKey String

  @@id([planId, moduleKey])
  @@map("plan_modules")
}

enum SubscriptionStatus {
  /// Made at a gateway but not yet paid for or authorised — gives nothing yet.
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum BillingGateway {
  /// Given by staff from the console: no gateway charges it.
  MANUAL
  STRIPE
  RAZORPAY
}

/// A workspace's plans, and how they are paid for. Every live subscription (trialing, active or past
/// due) counts towards what it may use.
model Subscription {
  id               String             @id @default(cuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status           SubscriptionStatus @default(ACTIVE)
  gateway          BillingGateway     @default(MANUAL)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  /// Ends when the period it is in ends, rather than renewing.
  cancelAtPeriodEnd Boolean           @default(false)
  /// When a payment first failed, for the grace period; cleared once it is paid.
  pastDueSince     DateTime?
  /// The subscription at the gateway (Stripe's sub_…, Razorpay's sub_…), and its customer there.
  externalId         String?          @unique
  externalCustomerId String?
  currency           String?
  interval           BillingInterval?
  /// Last read from the gateway — by a webhook, or by the daily reconcile.
  syncedAt           DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  items    SubscriptionItem[]
  invoices Invoice[]

  @@index([tenantId, status])
  @@map("subscriptions")
}

model SubscriptionItem {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  /// How many of it: an add-on of five seats bought twice is ten.
  quantity       Int          @default(1)
  /// The price it is charged at, when a gateway charges it.
  priceId        String?
  price          PlanPrice?   @relation(fields: [priceId], references: [id], onDelete: SetNull)
  /// Stripe's subscription item (si_…).
  externalId     String?      @unique
  createdAt      DateTime     @default(now())

  @@unique([subscriptionId, planId])
  @@map("subscription_items")
}

/// Staff adding a module to one workspace, or taking one away, whatever its plans say — a pilot, a
/// favour, a dispute. Kept with who and why.
model TenantModuleOverride {
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleKey     String
  granted       Boolean
  reason        String
  byStaffId     String
  createdAt     DateTime @default(now())

  @@id([tenantId, moduleKey])
  @@map("tenant_module_overrides")
}

// ─── Billing (M8) ─────────────────────────────────────────────────────────────────────────────────

enum SuspendedFor {
  STAFF
  BILLING
}

enum BillingInterval {
  MONTH
  YEAR
}

/// What a plan costs at one gateway, in one currency, each month or year — made at the gateway when
/// it is made here (a Stripe price, a Razorpay plan) and never changed there: a new price replaces an
/// old one, and the old one stays on the subscriptions already paying it.
model PlanPrice {
  id         String          @id @default(cuid())
  planId     String
  plan       Plan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  gateway    BillingGateway
  /// ISO 4217, upper case: INR, USD, EUR.
  currency   String
  interval   BillingInterval
  /// In the currency's smallest unit (paise, cents), for one unit of quantity.
  amount     Int
  /// Charged per person: the quantity is the seats wanted.
  perSeat    Boolean         @default(false)
  /// The gateway's own id for it.
  externalId String?         @unique
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())

  items SubscriptionItem[]

  @@index([planId])
  @@map("plan_prices")
}

/// Every webhook a gateway sent, once each — its id is the key, so a second delivery is a no-op.
model BillingEvent {
  id          String         @id @default(cuid())
  gateway     BillingGateway
  eventId     String
  type        String
  tenantId    String?
  receivedAt  DateTime       @default(now())
  processedAt DateTime?
  error       String?
  payload     Json

  @@unique([gateway, eventId])
  @@index([receivedAt])
  @@index([tenantId, receivedAt])
  @@map("billing_events")
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

/// A gateway's invoice to a workspace, as the gateway reported it.
model Invoice {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gateway     BillingGateway
  externalId  String
  number      String?
  status      InvoiceStatus
  currency    String
  /// Smallest units.
  subtotal    Int
  tax         Int            @default(0)
  total       Int
  amountPaid  Int            @default(0)
  periodStart DateTime?
  periodEnd   DateTime?
  issuedAt    DateTime
  paidAt      DateTime?
  hostedUrl   String?
  pdfUrl      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  /// The subscription it bills, when the gateway said.
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  /// [{ planKey | null, amount }]. Null: not known — written before the partner programme, or lines that did not fit.
  planLines      Json?
  /// Smallest units, refunded and credited back so far.
  amountRefunded Int           @default(0)
  amountCredited Int           @default(0)
  refundedAt     DateTime?

  commissionEntries CommissionEntry[]
  commissionState   CommissionInvoiceState?

  @@unique([gateway, externalId])
  @@index([tenantId, issuedAt])
  // The commission engine's scan: invoices changed since it last looked.
  @@index([updatedAt])
  @@map("invoices")
}

/// A workspace's use, a day at a time — people with an account, and copilot tokens this month so far.
model TenantUsage {
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  day           DateTime @db.Date
  seatsUsed     Int
  seatsLimit    Int?
  copilotTokens Int
  recordedAt    DateTime @default(now())

  @@id([tenantId, day])
  @@map("tenant_usage")
}

/// The platform's own settings, set from the console. Secrets — gateway keys — are sealed under the
/// platform key and never shown back.
model PlatformSetting {
  key          String   @id
  value        String?
  secretCipher String?
  updatedBy    String?
  updatedAt    DateTime @updatedAt

  @@map("platform_settings")
}

/// A billing reminder already sent — its key names the date it was about, so it goes once.
model BillingNotice {
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key      String
  sentAt   DateTime @default(now())

  @@id([tenantId, key])
  @@map("billing_notices")
}

// ─── Console (the redesign) ──────────────────────────────────────────────────────────────────────

enum AnnouncementTone {
  INFO
  WARNING
  /// Not dismissible; audience ALL or CRITICAL needs an owner's "publish".
  CRITICAL
}

enum AnnouncementAudience {
  ALL
  /// targets: tenant ids
  TENANTS
  /// targets: ISO 3166-1 alpha-2 codes
  COUNTRIES
  /// targets: plan keys (matched against Tenant.entitlements.plans)
  PLANS
}

/// Staff's own notes on a workspace: context the audit log is not for. Plain text; never in audit detail.
model TenantNote {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// PlatformUser.id (a soft reference, like the audit actor).
  authorId  String
  /// 1–4000 characters (a CHECK in the migration).
  body      String
  pinned    Boolean   @default(false)
  editedBy  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Deleted notes are kept, hidden, for the record.
  deletedAt DateTime?
  deletedBy String?

  @@index([tenantId, createdAt])
  @@map("tenant_notes")
}

/// An alert a staff member has dealt with, or put off — keyed by the alert's stable key.
model PlatformAlertAck {
  key         String    @id
  ackedBy     String
  ackedAt     DateTime  @default(now())
  /// Null: acknowledged for good (instance alerts only). Set: hidden until then.
  snoozeUntil DateTime?
  note        String?

  @@map("platform_alert_acks")
}

/// A notice shown at the top of workspaces' pages. Plain text only.
model PlatformAnnouncement {
  id          String               @id @default(cuid())
  /// 3–120 characters, and the body 1–1000 (a CHECK in the migration).
  title       String
  body        String
  tone        AnnouncementTone     @default(INFO)
  audience    AnnouncementAudience @default(ALL)
  /// What the audience is matched against; empty for ALL.
  targets     String[]             @default([])
  startsAt    DateTime             @default(now())
  /// Null: until archived. Otherwise after startsAt (a CHECK in the migration).
  endsAt      DateTime?
  dismissible Boolean              @default(true)
  createdBy   String
  updatedBy   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  archivedAt  DateTime?

  @@index([archivedAt, startsAt])
  @@map("platform_announcements")
}

// ─── Help and What's new from Deskzo ─────────────────────────────────────────────────────────────
//
// Published once from the console and shown, read-only, in every workspace they apply to
// (src/lib/platform/help-content.ts). A workspace's own guides and company news are its own rows in
// its own database (HelpLink, Announcement); the two are shown apart and never mixed.

enum PlatformHelpKind {
  /// Something to read.
  ARTICLE
  /// A walkthrough to watch — linked, never uploaded or embedded.
  VIDEO
}

/// One of Deskzo's help articles or walkthrough videos. Only the link is kept: the page lives on an
/// allowlisted host, or is a path inside the app.
model PlatformHelpLink {
  id          String           @id @default(cuid())
  kind        PlatformHelpKind
  /// 3–120 characters; the description at most 300 (a CHECK in the migration).
  title       String
  /// https:// or an in-app path beginning with "/", at most 2000 characters (a CHECK in the
  /// migration); the console also holds it to the host allowlist.
  url         String
  description String?
  /// Lower first, within its kind; 0–9999.
  sortOrder   Int              @default(0)
  /// Module keys (src/lib/modules.ts): shown where the plan has any of them. Empty: every workspace.
  modules     String[]         @default([])
  /// ISO 3166-1 alpha-2 codes. Empty: every country.
  countries   String[]         @default([])
  /// Null: a draft. Later than now: scheduled. Live from then until archived.
  publishedAt DateTime?
  archivedAt  DateTime?
  /// PlatformUser ids (soft references, like the audit actor).
  createdById String
  updatedById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([archivedAt, publishedAt])
  @@map("platform_help_links")
}

/// What's new from Deskzo: a release note. Plain text, line breaks kept. Who has read it is kept in
/// each workspace, per person (User.deskzoUpdatesSeenAt), never here.
model PlatformUpdate {
  id          String    @id @default(cuid())
  /// 3–120 characters, and the body 1–4000 (a CHECK in the migration).
  title       String
  body        String
  /// An optional "read more", held to the same rule as a help link's url.
  linkUrl     String?
  /// Shown above the rest while it is live.
  pinned      Boolean   @default(false)
  /// As on PlatformHelpLink: empty is everybody.
  modules     String[]  @default([])
  countries   String[]  @default([])
  /// Null: a draft. Later than now: scheduled. Live from then until archived.
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String
  updatedById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([archivedAt, publishedAt])
  @@map("platform_updates")
}

/// Monthly recurring revenue at the gateways, one row per currency per day — written by the tick's daily chores.
model PlatformRevenueSnapshot {
  day           DateTime @db.Date
  /// ISO 4217, upper case.
  currency      String
  /// Minor units a month, before tax. BigInt: an INR sum passes 2^31 paise at Rs 2.1 crore.
  mrr           BigInt
  subscriptions Int
  workspaces    Int
  recordedAt    DateTime @default(now())

  @@id([day, currency])
  @@map("platform_revenue_snapshots")
}

// ─── The website CMS (cms.<PLATFORM_DOMAIN>) ─────────────────────────────────────────────────────
//
// The public website's content and the small app that edits it. Its accounts are its own — never a
// staff member's, never a workspace member's — and nothing here is about a workspace.

enum CmsRole {
  /// Everything, including CMS accounts and the CMS's security settings.
  ADMIN
  /// Edits and publishes pages, posts, media, navigation and settings; works the leads.
  EDITOR
  /// Drafts pages and posts and uploads media; publishes nothing, deletes nobody else's work.
  AUTHOR
  /// Looking only, leads included.
  VIEWER
}

/// Somebody who edits the public website, at cms.<domain>. The password is only ever chosen by the
/// person, through an emailed one-time link.
model CmsUser {
  id             String    @id @default(cuid())
  /// Lower-case (a CHECK in the migration).
  email          String    @unique
  name           String
  role           CmsRole
  /// bcrypt. Null until they choose one through their setup link.
  passwordHash   String?
  /// SHA-256 of a one-time link to choose a password — the first, or a reset. Works until
  /// setupExpiresAt, once.
  setupTokenHash String?   @unique
  setupExpiresAt DateTime?
  /// The authenticator secret, sealed under the platform key ("cms-totp"). Null until enrolment starts.
  totpSecretCipher String?
  /// When enrolment finished.
  totpEnabledAt  DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /// Who made it: "staff:<id>", "cms:<id>" or "script".
  createdBy      String
  lastSignInAt   DateTime?

  sessions CmsSession[]
  posts    SitePost[]

  @@map("cms_users")
}

/// One CMS sign-in: sixty minutes idle, twelve hours at most, revocable.
model CmsSession {
  /// SHA-256 of the cookie's token; the token itself is only ever in the cookie.
  id         String    @id
  userId     String
  user       CmsUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  /// When the second factor was passed in this session, when one was asked for.
  mfaAt      DateTime?
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  @@index([userId])
  @@map("cms_sessions")
}

/// The CMS's own settings ("two-factor": "optional" | "required"). Not the website's content.
model CmsSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String

  @@map("cms_settings")
}

enum SitePageStatus {
  DRAFT
  PUBLISHED
}

/// A page of the public website, built from typed blocks (src/components/site/blocks/types.ts). The
/// home page's slug is "home". The draft is what editors change; the site shows only `published`.
model SitePage {
  id          String         @id @default(cuid())
  /// Lower-case words and hyphens, "/" between levels (a CHECK in the migration).
  slug        String         @unique
  title       String
  status      SitePageStatus @default(DRAFT)
  /// The page document: { title, seo, blocks }.
  draft       Json
  published   Json?
  publishedAt DateTime?
  publishedBy String?
  createdAt   DateTime       @default(now())
  createdBy   String
  updatedAt   DateTime       @updatedAt
  updatedBy   String
  archivedAt  DateTime?

  versions SitePageVersion[]

  @@map("site_pages")
}

/// A page as it was published (or saved as a version) — for history and restore.
model SitePageVersion {
  id        String   @id @default(cuid())
  pageId    String
  page      SitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  document  Json
  note      String?
  createdAt DateTime @default(now())
  createdBy String

  @@index([pageId, createdAt])
  @@map("site_page_versions")
}

enum SitePostStatus {
  DRAFT
  /// Published, from publishAt on — the public site shows it once that has passed; no job runs.
  SCHEDULED
  PUBLISHED
}

/// A blog or news post. The body is blocks, like a page's.
model SitePost {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  excerpt      String?
  /// A SiteMedia id (a soft reference: deleting media in use is refused by the app).
  coverMediaId String?
  body         Json
  /// Superseded by `tagLinks` (SiteTag records). Kept for one release (expand/contract): the app no
  /// longer reads or writes it; the taxonomy migration copied it into site_tags/site_post_tags.
  tags         String[]       @default([])
  status       SitePostStatus @default(DRAFT)
  publishAt    DateTime?
  publishedAt  DateTime?
  seo          Json?
  authorId     String
  author       CmsUser        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  updatedBy    String
  archivedAt   DateTime?

  categories SitePostCategory[]
  tagLinks   SitePostTag[]

  @@index([status, publishAt])
  @@map("site_posts")
}

/// A blog category: a curated list ADMIN and EDITOR manage, nested one level at most (a parent, then
/// children — the app keeps it to one level). Its archive is /blog/category/<slug>, and includes its
/// children's posts.
model SiteCategory {
  id          String             @id @default(cuid())
  /// Lower-case words and hyphens, 1–60 (a CHECK in the migration).
  slug        String             @unique
  /// 1–60 (a CHECK in the migration).
  name        String
  /// Plain text, at most 500 (a CHECK in the migration).
  description String?
  /// Never its own id (a CHECK in the migration).
  parentId    String?
  /// Deleting a category that still has children is refused.
  parent      SiteCategory?      @relation("SiteCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    SiteCategory[]     @relation("SiteCategoryTree")
  position    Int                @default(0)
  /// { title?, description?, imageMediaId? }, as pages and posts store theirs.
  seo         Json?
  posts       SitePostCategory[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  updatedBy   String

  @@index([parentId, position])
  @@map("site_categories")
}

/// A blog tag. ADMIN, EDITOR and AUTHOR create them while writing; only ADMIN and EDITOR rename,
/// merge or delete. Its archive is /blog/tag/<slug>.
model SiteTag {
  id          String        @id @default(cuid())
  /// Lower-case words and hyphens, 1–60 (a CHECK in the migration).
  slug        String        @unique
  /// 1–40 (a CHECK in the migration).
  name        String
  /// Plain text, at most 500 (a CHECK in the migration).
  description String?
  /// { title?, description?, imageMediaId? }, as pages and posts store theirs.
  seo         Json?
  posts       SitePostTag[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  updatedBy   String

  @@map("site_tags")
}

/// A post in a category. A category in use cannot be deleted from under its posts (Restrict): the app
/// removes these rows first.
model SitePostCategory {
  postId     String
  post       SitePost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  categoryId String
  category   SiteCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// The lowest is the post's main category (breadcrumbs).
  position   Int          @default(0)

  @@id([postId, categoryId])
  @@index([categoryId])
  @@map("site_post_categories")
}

/// A post's tag.
model SitePostTag {
  postId String
  post   SitePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    SiteTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("site_post_tags")
}

enum SiteRedirectMatch {
  /// `fromPath` is the whole path.
  EXACT
  /// `fromPath` ends in "/*" and matches everything under it; the rest carries over to a target that
  /// also ends in "/*".
  PREFIX
}

/// A redirect on the public site's own host (root and www) only, applied in the proxy before the
/// platform-site rewrite. Managed by ADMIN and EDITOR; an external (https://) target is ADMIN only.
model SiteRedirect {
  id        String            @id @default(cuid())
  /// Normalised: starts with "/", lower-case, no query, no trailing slash except "/" itself; a PREFIX
  /// one, and only a PREFIX one, ends in "/*". At most 2000 (CHECKs in the migration).
  fromPath  String            @unique
  /// A site path (not "//…") or an absolute https:// URL; no spaces. Ends in "/*" only on a PREFIX
  /// one. At most 2000 (CHECKs in the migration).
  toUrl     String
  /// 301, 302, 307 or 308 (a CHECK in the migration).
  status    Int               @default(301)
  match     SiteRedirectMatch @default(EXACT)
  enabled   Boolean           @default(true)
  /// Made by a published post's or page's slug change, not by hand.
  automatic Boolean           @default(false)
  /// At most 500 (a CHECK in the migration).
  note      String?
  /// Counted in batches, one write per redirect per minute. Never negative (a CHECK in the migration).
  hits      Int               @default(0)
  lastHitAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  updatedBy String

  @@map("site_redirects")
}

/// An image in the website's media library, served publicly at /media/<id>. List queries never
/// select `data`.
model SiteMedia {
  id        String   @id @default(cuid())
  filename  String
  /// image/png, image/jpeg, image/webp or image/gif (a CHECK in the migration).
  mime      String
  size      Int
  width     Int?
  height    Int?
  alt       String   @default("")
  data      Bytes
  /// Of the bytes: the same image uploaded twice is one row.
  sha256    String   @unique
  createdAt DateTime @default(now())
  createdBy String

  @@index([createdAt])
  @@map("site_media")
}

/// The website's settings — site name, tagline, emails, social links, default SEO, header and footer
/// navigation — in the site's SiteSettings shape. One row, key "site".
model SiteSettings {
  key         String    @id
  draft       Json
  published   Json?
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt
  updatedBy   String

  @@map("site_settings")
}

enum SiteLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  SPAM
}

/// What the SEO Intelligence dashboard scores: a page (by slug), a post, a category, a tag, or the
/// blog's index.
enum SeoEntityType {
  PAGE
  POST
  CATEGORY
  TAG
  BLOG_INDEX
}

/// The latest SEO / AEO / GEO scores of one piece of the website, for the SEO Intelligence
/// dashboard (src/lib/seo, the CMS's scoring engine).
///
/// A cache, never the source of truth: the page, post or archive is. A row is stale when its
/// content changed after `contentUpdatedAt`, when the site settings were published after
/// `calculatedAt`, or when `engineVersion` is older than the engine's; the dashboard recalculates
/// stale rows in batches. Nothing on the public site reads this table.
model SeoScore {
  id               String        @id @default(cuid())
  entityType       SeoEntityType
  /// A page's slug, a post's, category's or tag's id, or "blog" for the blog's index.
  entityKey        String
  path             String
  title            String
  /// published | draft | default (a built-in page on its default content) | scheduled
  status           String
  /// False for a page, post or archive deliberately kept out of search (noindex) — or not live.
  indexable        Boolean
  seoScore         Int
  aeoScore         Int
  geoScore         Int
  overallScore     Int
  critical         Int
  warnings         Int
  missingMetadata  Boolean
  missingSchema    Boolean
  missingKeywords  Boolean
  /// The whole calculation: every check with its status, points, message and recommendation.
  breakdown        Json
  engineVersion    Int
  contentUpdatedAt DateTime?
  calculatedAt     DateTime      @default(now())

  @@unique([entityType, entityKey])
  @@index([overallScore])
  @@index([calculatedAt])
  @@map("seo_scores")
}

/// A request from the website's contact form.
model SiteLead {
  id        String         @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  topic     String
  message   String
  status    SiteLeadStatus @default(NEW)
  notes     String?
  /// Only when the caller's address is known.
  ip        String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  /// Who last changed its status or notes: "cms:<id>".
  handledBy String?

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("site_leads")
}

/// What was done in the CMS, by whom. Ids, slugs, titles and counts — never a document's body.
model CmsAuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  /// The CMS user's id; null for a script or the public site.
  actorId    String?
  actorLabel String
  action     String
  entity     String
  entityId   String?
  detail     Json?

  @@index([at])
  @@index([actorId, at])
  @@index([entity, entityId])
  @@map("cms_audit_log")
}

// ─── Contact Support (the platform's own support desk) ──────────────────────────────────────────
//
// A workspace user asking the platform for help, from inside their workspace, and staff answering
// from the console's Support page. Not a workspace's own helpline (HelpDesk, in the workspace's
// database). Files live on disk under SUPPORT_DIR, never in a row (src/lib/support/storage.ts).

enum SupportStatus {
  OPEN
  /// Staff are on it: set by the first reply, or by hand.
  IN_PROGRESS
  /// Waiting on the customer.
  WAITING
  RESOLVED
  CLOSED
}

enum SupportPriority {
  /// "Just a question"
  LOW
  /// "Something isn't working"
  NORMAL
  /// "It's blocking my work"
  HIGH
  /// "Critical — our business is stopped"
  URGENT
}

enum SupportAttachmentKind {
  FILE
  /// A screen recording, made with the requester's consent.
  RECORDING
}

enum SupportEntryKind {
  /// Emailed to the requester.
  REPLY
  /// Staff only; never leaves the console.
  NOTE
  STATUS
  PRIORITY
  ASSIGN
}

/// A request for help from somebody signed in to a workspace. Shown as SR-<number>.
model SupportRequest {
  id              String          @id @default(cuid())
  /// SR-1001 onwards: the sequence restarts at 1001 in the migration.
  number          Int             @unique @default(autoincrement())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// The workspace's User.id — opaque here, never joined. Name, email and role as they were when sent.
  requesterUserId String
  requesterName   String
  requesterEmail  String
  requesterRole   String?
  mobile          String?
  /// 1–150 characters, one line (a CHECK in the migration).
  subject         String
  /// 1–5000 characters of plain text (a CHECK in the migration). Never rendered as HTML.
  body            String
  priority        SupportPriority @default(NORMAL)
  status          SupportStatus   @default(OPEN)
  assigneeId      String?
  assignee        PlatformUser?   @relation("SupportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// What was collected with every request, as the dialog says: the workspace and the person (from the
  /// server), the page, browser, screen, time zone and language (from the browser, capped), and the
  /// page-load timings when a recording was consented to.
  context         Json
  /// Browser console errors and warnings during a recording — only with the recording's consent.
  consoleLog      Json?
  recordingConsentAt DateTime?
  /// Only when the caller's address is known (src/lib/client-ip.ts).
  ip              String?
  createdAt       DateTime        @default(now())
  /// Every change and every entry touches it: the inbox's "last activity".
  updatedAt       DateTime        @updatedAt
  /// The first reply that reached the requester by email.
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  /// Retention counts from here: files of requests closed longer ago than support.retentionDays go.
  closedAt        DateTime?

  attachments SupportAttachment[]
  entries     SupportEntry[]

  @@index([status, priority, createdAt])
  @@index([tenantId, createdAt])
  @@index([assigneeId, status])
  @@map("support_requests")
}

/// A file or recording sent with a request. The bytes are on disk at SUPPORT_DIR/<storageKey>.
model SupportAttachment {
  id         String                @id @default(cuid())
  requestId  String
  request    SupportRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind       SupportAttachmentKind
  /// Sanitised display name.
  filename   String
  /// The type its bytes were sniffed as on upload — never the browser's claim.
  mime       String
  /// Bytes, never negative (a CHECK in the migration).
  size       Int
  sha256     String
  /// <tenantId>/<requestId>/<attachmentId>, relative to SUPPORT_DIR.
  storageKey String
  /// Recordings only.
  durationMs Int?
  /// The file was removed by retention; the row stays, for the record.
  purgedAt   DateTime?
  createdAt  DateTime              @default(now())

  @@index([requestId])
  @@map("support_attachments")
}

/// One thing on a request's timeline: a reply, an internal note, or a change of status, priority or
/// assignee. `meta`: STATUS / PRIORITY / ASSIGN {from, to}; REPLY {emailed, to, error?}.
model SupportEntry {
  id        String           @id @default(cuid())
  requestId String
  request   SupportRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind      SupportEntryKind
  /// REPLY and NOTE text, 1–5000 characters (a CHECK in the migration).
  body      String?
  authorId  String?
  author    PlatformUser?    @relation("SupportEntryAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  meta      Json?
  createdAt DateTime         @default(now())

  @@index([requestId, createdAt])
  @@map("support_entries")
}

// ─── The partner programme (partners.<PLATFORM_DOMAIN>) ──────────────────────────────────────────
//
// Companies that sell the platform — distributors and resellers — and the commission they earn. The
// platform bills every customer; partners only earn, and are paid by hand against monthly statements.
// The portal's accounts are its own — never a staff member's, never a workspace member's.

enum PartnerKind {
  /// Holds a territory; may have resellers under it.
  DISTRIBUTOR
  /// Sells on its own, or under one distributor.
  RESELLER
}

enum PartnerStatus {
  /// Signs in, cannot sell yet; keeps earning on customers it has.
  ONBOARDING
  ACTIVE
  /// Signs in, cannot sell; keeps earning.
  SUSPENDED
  /// Cannot sign in; earns nothing on invoices paid from terminatedAt on.
  TERMINATED
}

enum PartnerRole {
  /// Everything, including the team, the profile and requests.
  ADMIN
  /// Commissions, statements, the payout mask and payout requests.
  FINANCE
  /// Customers, invitations, links and deals.
  SALES
  /// Reads customers, invitations and deals.
  VIEWER
}

enum AttributionSource {
  /// The partner's invitation code.
  SIGNUP_INVITE
  /// A referral code on the signup form.
  REFERRAL_LINK
  /// An approved deal registration for the signup email's domain.
  DEAL_REGISTRATION
  /// A distributor's default for direct signups from its territories.
  TERRITORY
  /// Assigned by staff, with a reason.
  STAFF
}

enum DealStatus {
  /// Waiting for staff.
  PENDING
  /// Protected until expiresAt.
  APPROVED
  DECLINED
  /// The company signed up, and the workspace is on the deal.
  WON
  EXPIRED
  /// Taken back by the partner.
  WITHDRAWN
}

enum CommissionKind {
  /// On the partner's own customer's invoice.
  DIRECT
  /// A distributor's cut of its resellers' customers' invoices.
  OVERRIDE
  /// Entered by staff, with a reason.
  ADJUSTMENT
}

enum CommissionStatus {
  /// Owed; on no approved statement yet.
  PENDING
  /// On an approved statement.
  APPROVED
  /// Its statement was paid.
  PAID
  /// Voided by staff while pending.
  VOID
}

enum StatementStatus {
  DRAFT
  APPROVED
  /// Marked paid by staff, with the transfer's reference.
  PAID
  /// Its entries went back to pending, unattached.
  VOID
}

enum PartnerRequestKind {
  /// A change to the partner's own details.
  PROFILE
  /// New bank details.
  PAYOUT
  /// A reseller proposed by a distributor.
  NEW_RESELLER
}

enum PartnerRequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// Taken back by the partner, or ended by its termination.
  WITHDRAWN
}

enum PartnerApplicationStatus {
  NEW
  REVIEWING
  /// Made into a partner.
  ACCEPTED
  DECLINED
  SPAM
}

enum PartnerActorKind {
  /// A partner user, in the portal.
  PARTNER
  /// A member of staff, in the console.
  STAFF
  /// The platform itself: signup, the tick.
  SYSTEM
  /// A script run by the operator on the server.
  SCRIPT
  /// Somebody on the public site: an application.
  PUBLIC
}

/// A company in the programme: a distributor or a reseller.
model Partner {
  id              String        @id @default(cuid())
  /// Lower-case, 3–40, like a workspace name; never "new" or "requests" (the console's own routes).
  slug            String        @unique
  kind            PartnerKind
  status          PartnerStatus @default(ONBOARDING)
  /// A reseller's distributor. Only a reseller has one, and it is always a distributor (checked in the app).
  parentId        String?
  parent          Partner?      @relation("PartnerResellers", fields: [parentId], references: [id], onDelete: Restrict)
  resellers       Partner[]     @relation("PartnerResellers")
  legalName       String
  displayName     String
  /// Where it is established — its tax home (ISO 3166-1 alpha-2).
  country         String
  /// The countries it may sell in (ISO 3166-1 alpha-2), at least one.
  territories     String[]
  contactName     String
  contactEmail    String
  contactPhone    String?
  website         String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  region          String?
  postalCode      String?
  /// [{ kind: "GSTIN" | "PAN" | "VAT" | "GST" | "ABN" | "EIN" | "TIN" | "OTHER", value }] — at most four.
  taxIds          Json          @default("[]")
  /// Bank details, sealed under the platform key bound to this partner ("partner-payout"). Never selected by a loader.
  payoutCipher    String?
  /// What may be shown of them: { method, accountHolder, bankName, country, currency, last4, ifsc?, swift? }.
  payoutMask      Json?
  payoutUpdatedAt DateTime?
  /// Staff's own notes. Never shown in the portal.
  notes           String?
  /// Listed on the public "Find a partner" page (only while ACTIVE).
  publicListing   Boolean       @default(false)
  publicBlurb     String?
  statusReason    String?
  /// "staff:<id>" or "script".
  createdBy       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  activatedAt     DateTime?
  suspendedAt     DateTime?
  terminatedAt    DateTime?

  terms        PartnerTerms[]
  users        PartnerUser[]
  tenants      Tenant[]              @relation("TenantPartner")
  attributions TenantAttribution[]
  invites      SignupInvite[]
  links        PartnerReferralLink[]
  deals        DealRegistration[]
  entries      CommissionEntry[]
  statements   PartnerStatement[]
  requests     PartnerRequest[]
  applications PartnerApplication[]
  auditLog     PartnerAuditLog[]

  @@index([parentId])
  @@index([status, kind])
  @@map("partners")
}

/// A partner's commission rates from `effectiveFrom` on — a new row replaces the old from its date; rows are never edited.
model PartnerTerms {
  id              String   @id @default(cuid())
  partnerId       String
  partner         Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  effectiveFrom   DateTime
  /// Basis points: 1500 is 15 %.
  defaultRateBp   Int
  /// While the customer is new (its first `newMonths` months from its first paid invoice), and after.
  newRateBp       Int?
  renewalRateBp   Int?
  newMonths       Int      @default(12)
  /// Commission stops this many months after it started for this partner and customer; null: the customer's lifetime.
  durationMonths  Int?
  /// A distributor's cut of its resellers' customers' invoices, on top of the reseller's own.
  overrideRateBp  Int?
  /// A distributor's rate on direct signups from its territories attributed to it by default; null: no territory default.
  territoryRateBp Int?
  /// [{ planKey, rateBp }] — replaces the rate for that plan's share of an invoice.
  planRates       Json     @default("[]")
  /// [{ country, rateBp }] — replaces the rate for customers in that country.
  countryRates    Json     @default("[]")
  note            String?
  createdBy       String
  createdAt       DateTime @default(now())

  @@unique([partnerId, effectiveFrom])
  @@map("partner_terms")
}

/// Somebody who signs in to the partner portal for one partner.
model PartnerUser {
  id               String      @id @default(cuid())
  partnerId        String
  partner          Partner     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  /// Lower-case, unique across the portal.
  email            String      @unique
  name             String
  role             PartnerRole
  passwordHash     String?
  setupTokenHash   String?     @unique
  setupExpiresAt   DateTime?
  /// Sealed under the platform key ("partner-totp").
  totpSecretCipher String?
  totpEnabledAt    DateTime?
  active           Boolean     @default(true)
  /// "staff:<id>", "partner:<userId>" or "script".
  createdBy        String
  lastSignInAt     DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  sessions PartnerSession[]

  @@index([partnerId])
  @@map("partner_users")
}

/// One portal sign-in: sixty minutes idle, twelve hours at most, revocable.
model PartnerSession {
  /// SHA-256 of the cookie's token.
  id         String      @id
  userId     String
  user       PartnerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  lastSeenAt DateTime    @default(now())
  expiresAt  DateTime
  mfaAt      DateTime?
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  @@index([userId])
  @@map("partner_sessions")
}

/// Which partner a workspace belonged to, from when to when, and how; one current row each (a partial unique index).
model TenantAttribution {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Null: staff made it direct.
  partnerId      String?
  partner        Partner?          @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  source         AttributionSource
  /// What led to it: "invite:<first 8 of the hash>", "link:<code>", "deal:<id>", "territory:<country>"; null for staff.
  reference      String?
  /// Staff's reason (required for STAFF). Never shown in the portal.
  reason         String?
  commissionable Boolean           @default(true)
  /// { outsideTerritory?: true, conflicts?: [{ partnerId, source }] } — what staff should look at.
  flags          Json?
  reviewedAt     DateTime?
  reviewedBy     String?
  validFrom      DateTime          @default(now())
  validTo        DateTime?
  /// "signup", "staff:<id>", "script".
  createdBy      String
  createdAt      DateTime          @default(now())

  @@index([tenantId, validFrom])
  @@index([partnerId, validTo])
  @@map("tenant_attributions")
}

/// A partner's public referral code: /signup?ref=<code>.
model PartnerReferralLink {
  id        String    @id @default(cuid())
  code      String    @unique
  partnerId String
  partner   Partner   @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  label     String?
  /// The plan a workspace signing up with it starts its trial on; null: the default plan.
  planKey   String?
  expiresAt DateTime?
  endedAt   DateTime?
  /// Signups verified with this code on the form, whoever they were finally attributed to.
  signups   Int       @default(0)
  createdBy String
  createdAt DateTime  @default(now())

  @@index([partnerId, createdAt])
  @@map("partner_referral_links")
}

/// A partner's claim on a prospect company, by its email domain.
model DealRegistration {
  id              String     @id @default(cuid())
  partnerId       String
  partner         Partner    @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  companyName     String
  /// Lower-case, never a free-mail domain.
  domain          String
  country         String
  contactName     String?
  contactEmail    String?
  expectedPlanKey String?
  note            String?
  status          DealStatus @default(PENDING)
  /// The partner user's id.
  submittedBy     String
  decidedBy       String?
  decidedAt       DateTime?
  decisionNote    String?
  expiresAt       DateTime?
  tenantId        String?
  tenant          Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([partnerId, status])
  @@index([domain])
  @@map("partner_deals")
}

/// One line of money owed to a partner, or clawed back from it.
model CommissionEntry {
  id          String            @id @default(cuid())
  partnerId   String
  partner     Partner           @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  /// Null only for an adjustment not about one customer.
  tenantId    String?
  tenant      Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// Null only for an adjustment.
  invoiceId   String?
  invoice     Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  kind        CommissionKind
  status      CommissionStatus  @default(PENDING)
  currency    String
  /// The invoice's net amount this entry is on (a reversal: the part reversed), minor units, never negative.
  base        Int
  /// The rate applied (effective, over the whole base); 0 for an adjustment.
  rateBp      Int
  /// Minor units: positive owed, negative clawed back. Never 0.
  amount      Int
  /// How it was worked out (spec §5.8). No secrets, no personal data.
  basis       Json
  /// The idempotency key (spec §5.7).
  sourceKey   String            @unique
  reversesId  String?
  reverses    CommissionEntry?  @relation("CommissionReversals", fields: [reversesId], references: [id], onDelete: Restrict)
  reversals   CommissionEntry[] @relation("CommissionReversals")
  /// Accrual: the invoice's paidAt. Reversal: when the refund was seen. Adjustment: staff's date.
  earnedAt    DateTime
  statementId String?
  statement   PartnerStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)
  /// An adjustment's reason. Shown to the partner.
  note        String?
  /// "engine" or "staff:<id>".
  createdBy   String
  createdAt   DateTime          @default(now())
  voidedAt    DateTime?
  voidedBy    String?
  /// Staff only.
  voidReason  String?

  @@index([partnerId, status, earnedAt])
  @@index([statementId])
  @@index([tenantId, earnedAt])
  @@index([invoiceId])
  @@map("commission_entries")
}

/// What the commission engine last made of one invoice — so each is looked at again only when it changes.
model CommissionInvoiceState {
  invoiceId         String        @id
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  status            InvoiceStatus
  /// total − tax when it was paid, minor units.
  base              Int
  /// How much of `base` has been reversed so far.
  reversedBase      Int           @default(0)
  /// The DIRECT outcome: "accrued" | "no-partner" | "not-commissionable" | "no-terms" | "outside-duration" | "terminated" | "exempt" | "zero".
  outcome           String
  /// The invoice's updatedAt when it was processed: a later one means look again.
  seenUpdatedAt     DateTime
  processedAt       DateTime      @default(now())
  /// A refund came after the clawback window (partners.clawbackMonths): its PAID entries were not reversed.
  clawbackExpiredAt DateTime?

  @@map("commission_invoice_states")
}

/// One month's entries for one partner in one currency — what a payout is made against.
model PartnerStatement {
  id                   String          @id @default(cuid())
  /// "<SLUG>-<YYYY-MM>-<CUR>", upper case; a regenerated one after a void gets "-2", "-3".
  number               String          @unique
  partnerId            String
  partner              Partner         @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  currency             String
  /// The IST month, "2026-09".
  period               String
  periodStart          DateTime
  periodEnd            DateTime
  status               StatementStatus @default(DRAFT)
  entryCount           Int
  /// Minor units: accruals, reversals (≤ 0), adjustments, and their sum.
  earned               BigInt
  reversed             BigInt
  adjustments          BigInt
  total                BigInt
  /// [{ label, kind: "ADD" | "WITHHOLD", rateBp?, amount }] — entered by staff for the accountant; no tax is worked out here.
  taxLines             Json            @default("[]")
  netPayable           BigInt
  /// The partner as it was: { legalName, displayName, country, address, taxIds, payout: mask | null }.
  partnerSnapshot      Json
  /// The partner's own invoice number for this statement, entered in the portal.
  partnerInvoiceNumber String?
  generatedAt          DateTime        @default(now())
  /// "tick" or "staff:<id>".
  generatedBy          String
  approvedAt           DateTime?
  approvedBy           String?
  paidAt               DateTime?
  paidBy               String?
  paymentReference     String?
  paymentNote          String?
  voidedAt             DateTime?
  voidedBy             String?
  voidReason           String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  entries CommissionEntry[]

  @@index([partnerId, period])
  @@index([status, generatedAt])
  @@map("partner_statements")
}

/// Something a partner asked staff to decide: a profile change, new payout details, a new reseller.
model PartnerRequest {
  id              String               @id @default(cuid())
  partnerId       String
  partner         Partner              @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  kind            PartnerRequestKind
  status          PartnerRequestStatus @default(PENDING)
  /// PROFILE: the fields asked for; NEW_RESELLER: the proposed reseller; PAYOUT: the new mask only.
  payload         Json
  /// PAYOUT only, while PENDING: the new details, sealed ("partner-payout-request", bound to the partner); cleared on decision.
  payloadCipher   String?
  requestedBy     String
  decidedBy       String?
  decidedAt       DateTime?
  decisionNote    String?
  /// NEW_RESELLER approved: the partner made.
  resultPartnerId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([partnerId, createdAt])
  @@map("partner_requests")
}

/// "Become a partner", from the public site.
model PartnerApplication {
  id           String                   @id @default(cuid())
  companyName  String
  website      String?
  country      String
  kindWanted   PartnerKind
  contactName  String
  contactEmail String
  contactPhone String?
  message      String
  status       PartnerApplicationStatus @default(NEW)
  notes        String?
  /// Only when the caller's address is known (src/lib/client-ip.ts).
  ip           String?
  partnerId    String?
  partner      Partner?                 @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  handledBy    String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([status, createdAt])
  @@map("partner_applications")
}

/// What was done in or to the partner programme. Ids, names, counts — never a secret, code, token or bank detail.
model PartnerAuditLog {
  id               String           @id @default(cuid())
  at               DateTime         @default(now())
  /// Null: a public application.
  partnerId        String?
  partner          Partner?         @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  actorKind        PartnerActorKind
  actorId          String?
  actorLabel       String
  action           String
  entity           String
  entityId         String?
  detail           Json?
  /// Shown on the partner's own Activity page.
  visibleToPartner Boolean          @default(true)

  @@index([partnerId, at])
  @@index([at])
  @@index([action, at])
  @@map("partner_audit_log")
}

// ─── Linked sign-in (one person, several workspaces) ─────────────────────────────────────────────

enum LinkSwitchStage {
  /// Seen at the target once; being checked.
  PRESENTED
  /// The target asked for a two-factor code, in the browser that saw it.
  CODE
  /// Every check passed: the "linked" sign-in may spend it, once.
  READY
  DONE
  /// Sent to Microsoft sign-in instead; nothing more to spend.
  SSO
  REFUSED
}

/// One person's accounts in several workspaces, each joined by signing in to that workspace under its own
/// rules. Being signed in as any member lets the person switch into the others, as each target allows.
/// Deleted once fewer than two members remain.
model LinkGroup {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  members   LinkMember[]

  @@map("link_groups")
}

/// One workspace account in a group — by its id there, never by its address. An account is in at most one
/// group; a group holds at most one account per workspace.
model LinkMember {
  id               String    @id @default(cuid())
  groupId          String
  group            LinkGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// User.id in that workspace's database.
  userId           String
  /// The account's address and name there when last proven or switched into — shown to the person only,
  /// never matched on.
  email            String
  name             String
  /// HMAC of the account's id, address and password hash when proven (spec §4.4). Stale: unlinked.
  stamp            String
  provenAt         DateTime
  lastSwitchedInAt DateTime?
  createdAt        DateTime  @default(now())

  @@unique([tenantId, userId])
  @@unique([groupId, tenantId])
  @@map("link_members")
}

/// "Add a workspace": asked for at the source, proven at the target, finished back at the source — ten
/// minutes from asking to proving. The proof's way back lasts a minute and is spent on first sight.
model LinkIntent {
  /// SHA-256 of the token's random part; the token travels once, to the target, in the address fragment.
  tokenHash         String    @id
  sourceTenantId    String
  sourceTenant      Tenant    @relation("LinkIntentSource", fields: [sourceTenantId], references: [id], onDelete: Cascade)
  sourceUserId      String
  /// The sign-in (sid) of the session that asked — only it can finish.
  sourceSid         String
  /// Where it was asked from (the host the person was on) — the proof returns there, and only if that host
  /// still reaches the source workspace.
  sourceOrigin      String
  sourceStamp       String
  sourceEmail       String
  sourceName        String
  /// SHA-256 of the secret in the asking browser's cookie at the source.
  browserSecretHash String
  targetTenantId    String
  targetTenant      Tenant    @relation("LinkIntentTarget", fields: [targetTenantId], references: [id], onDelete: Cascade)
  expiresAt         DateTime
  /// Opened at the target — once, by one browser, whose cookie secret this is the SHA-256 of.
  presentedAt       DateTime?
  targetBrowserHash String?   @unique
  /// The account that signed in at the target and confirmed.
  targetUserId      String?
  targetEmail       String?
  targetName        String?
  targetStamp       String?
  provenAt          DateTime?
  /// SHA-256 of the one-minute token that carries the proof back; spent the first time it is seen.
  completionHash    String?   @unique
  completionSeenAt  DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  /// Why it ended unfinished: a LinkRefusal code (spec §8.1).
  failure           String?
  ip                String?
  createdAt         DateTime  @default(now())

  @@index([sourceTenantId, sourceUserId, createdAt])
  @@index([targetTenantId, createdAt])
  @@index([expiresAt])
  @@map("link_intents")
}

/// A switch between linked accounts: made at the source, spent at the target. Sixty seconds to its first
/// sight, once; then five minutes, in the browser that saw it, while the target asks for a code.
model LinkSwitchTicket {
  tokenHash      String           @id
  targetTenantId String
  targetTenant   Tenant           @relation(fields: [targetTenantId], references: [id], onDelete: Cascade)
  /// User.id at the target — never an address.
  targetUserId   String
  /// The target's LinkMember and group when made (re-checked at the target).
  memberId       String
  groupId        String
  sourceTenantId String
  sourceUserId   String
  sourceSid      String
  expiresAt      DateTime
  /// Its first sight at the target.
  usedAt         DateTime?
  /// SHA-256 of the secret in the cookie of the browser that saw it: only that browser finishes.
  presentHash    String?          @unique
  stage          LinkSwitchStage?
  attempts       Int              @default(0)
  finishBy       DateTime?
  completedAt    DateTime?
  /// A SwitchRefusal code (spec §8.1).
  refusal        String?
  ip             String?
  createdAt      DateTime         @default(now())

  @@index([targetTenantId, createdAt])
  @@index([sourceTenantId, sourceUserId, createdAt])
  @@index([expiresAt])
  @@map("link_switch_tickets")
}

/// A workspace's own rule for linked sign-in, set from its Security settings. No row: the defaults.
model TenantSignInPolicy {
  tenantId        String   @id
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// "Allow switching into this workspace from linked accounts".
  allowSwitchIn   Boolean  @default(true)
  updatedByUserId String?
  updatedByName   String?
  updatedAt       DateTime @updatedAt

  @@map("tenant_sign_in_policies")
}

/// Which workspaces an address is an active member of, for "find my workspaces" only — the address kept as an
/// HMAC under the platform key ("email-index"), never in the clear. Linked sign-in never reads it.
model WorkspaceEmail {
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// User.id there.
  userId    String
  emailHmac String
  updatedAt DateTime @updatedAt

  @@id([tenantId, userId])
  @@index([emailHmac])
  @@map("workspace_emails")
}
