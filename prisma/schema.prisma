generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * A role, as data rather than as an enum.
 * It was an enum, which meant adding "Regional Manager" was a schema change, a migration and a
 * deploy — so in practice nobody added one, and people were given a near-enough role plus a pile of
 * personal exceptions. That is the failure this replaces: an exception is for the individual case,
 * and a role that everybody needs three exceptions on is a role that should have existed.
 * ## The key is the identity, the name is the label
 * `key` is the primary key and never changes. It is what `users.role` and `role_permissions.role`
 * point at, what the thirty-odd `role === "ADMIN"` comparisons in the application compare against,
 * and what the built-in presets are written in terms of. Renaming is therefore free and completely
 * safe: it changes `name`, and nothing in the code or the database is keyed on that.
 * The key is generated from the name once, at creation. After that the two are independent — call
 * the role whatever you like, as often as you like.
 */
model Role {
  /**
   * Immutable, upper snake case, e.g. REGIONAL_MANAGER. Referenced by every user and permission row.
   */
  key         String  @id
  /**
   * What people see, and may rename at will.
   */
  name        String
  description String?

  /**
   * True for the eight roles the application shipped with.
   * They can be renamed and their permissions changed like any other. They cannot be deleted:
   * ADMIN because the permission resolver and the super-admin constraint both name it, and the rest
   * because the built-in presets are written against them and would quietly stop applying.
   */
  isSystem  Boolean @default(false)
  sortOrder Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  permissions  RolePermission[]
  candidates   Candidate[]
  formGrants   FormAccessGrant[]
  accessPolicy RoleAccessPolicy?

  @@map("roles")
}

