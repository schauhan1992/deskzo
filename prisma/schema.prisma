model Company {
  id                  String                  @id @default(cuid())
  /**
   * The short number people quote at each other — COM-000123.
   * `id` is a cuid: correct, unique, and unsayable over the phone. Ten other records already carry
   * a sequence for exactly this reason (orders, leads, contacts, tickets, payments…), and a company
   * was the conspicuous exception — so the only way to refer to one unambiguously was its name,
   * which is mutable and, in a country with three "Evergreen Logistics", not unique either.
   * Backfilled in creation order rather than in whatever order the table happened to scan, so the
   * oldest account is COM-000001 and the numbering means something.
   */
  companySeq          Int                     @unique @default(autoincrement())
  name                String
  normalizedName      String                  @unique
  industryId          String?
  industry            Industry?               @relation(fields: [industryId], references: [id])
  category            String?
  /**
   * Where this customer sits — a category, or a sub-category under one — shown as an icon chip beside
   * their name wherever it appears. See src/lib/customers/categories.ts.
   */
  customerCategoryId  String?
  customerCategory    CustomerCategory?       @relation("CompanyCustomerCategory", fields: [customerCategoryId], references: [id], onDelete: SetNull)
  companyType         CompanyType?
  relationshipType    CompanyRelationshipType @default(CLIENT)
  vendorStatus        VendorStatus?
  vendorCode          String?
  /**
   * Set when this company is a RESELLER's end customer: the reseller owns the relationship, so we
   * never call or email them directly and they stay out of the Companies/Customer pools. Treat a
   * non-null value as a hard do-not-contact and do-not-market flag (see src/lib/reseller.ts) —
   * marketing automation must exclude these companies and their contacts.
   */
  managedByResellerId String?
  managedByReseller   Company?                @relation("ResellerEndCustomers", fields: [managedByResellerId], references: [id])
  endCustomers        Company[]               @relation("ResellerEndCustomers")
  /**
   * Payout/compliance details for a non-CLIENT company we pay (vendor or commission party) — null/unused for CLIENT companies.
   */
  panNumber           String?
  bankAccountName     String?
  bankAccountNumber   String?
  bankIfsc            String?
  bankName            String?
  website             String?
  linkedinUrl         String?
  employeeCount       Int?
  /// Advance by default — most customers of a reseller pay before the licence is ordered.
  paymentTerms        PaymentTerms            @default(ADVANCE)
  /// The most this customer may owe at once, set by somebody who can override credit. Null means
  /// the engine's suggestion applies (src/lib/credit/engine.ts). A reseller's lives on its profile.
  creditLimit         Decimal?                @db.Decimal(14, 2)
  /// The last computed rating, kept so lists can filter and sort by it. Decisions never read this —
  /// they recompute from the payment history — so a stale copy can mislead a list, never an approval.
  creditRating        CreditRating?
  creditScore         Int?
  creditScoredAt      DateTime?
  dunsNumber          String?
  tags                String[]                @default([])
  source              CompanySource           @default(OTHER)
  stage               CompanyStage            @default(PROSPECT)
  createdById         String
  createdBy           User                    @relation("CompanyCreatedBy", fields: [createdById], references: [id])
  ownerUserId         String?
  owner               User?                   @relation("CompanyOwner", fields: [ownerUserId], references: [id])
  assignedToUserId    String?
  assignedTo          User?                   @relation("CompanyAssignedTo", fields: [assignedToUserId], references: [id])
  assignedByUserId    String?
  assignedBy          User?                   @relation("CompanyAssignedBy", fields: [assignedByUserId], references: [id])
  assignedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  contacts               Contact[]
  leads                  Lead[]
  creditDecisions        CreditDecision[]
  feedbackRequests       FeedbackRequest[]       @relation("FeedbackCompany")
  journeyEnrolments      JourneyEnrolment[]      @relation("JourneyCompany")
  marketingMessages      MarketingMessage[]      @relation("MarketingMessageCompany")
  formSubmissions        FormSubmission[]        @relation("FormSubmissionCompany")
  formInvites            FormInvite[]            @relation("FormInviteCompany")
  products               CompanyProduct[]
  vendorOrders           CompanyProduct[]        @relation("CompanyProductVendor")
  vendorStatements       VendorStatement[]       @relation("VendorStatementVendor")
  vendorStatementMapping VendorStatementMapping? @relation("VendorStatementMappingVendor")
  reconcileMatches       VendorStatementLine[]   @relation("ReconcileMatchedCompany")

  /**
   * Whether this customer gets a portal, overriding the global setting.
   * Three states and all three are needed: true is "yes, even though the default is off", false is
   * "no, even though the default is on", and **null is "whatever the default says"** — which is the
   * one that matters, because it means switching the default from SELECTED to ALL actually reaches
   * everybody rather than only the companies nobody has ever touched.
   */
  portalEnabled           Boolean?
  portalLogins            PortalLogin[]            @relation("PortalLoginCompany")
  portalRequests          PortalRequest[]          @relation("PortalRequestCompany")
  commissionsPaid         OrderExpense[]           @relation("OrderExpensePayee")
  tradeDocuments          TradeDocument[]          @relation("TradeDocumentParty")
  /**
   * Orders a reseller placed on this company's behalf — the order itself belongs to the reseller.
   */
  ordersAsEndCustomer     CompanyProduct[]         @relation("OrderEndCustomer")
  payments                Payment[]
  locations               CompanyLocation[]
  visits                  Visit[]
  expenses                Expense[]                @relation("ExpenseCompany")
  tickets                 Ticket[]
  tasks                   Task[]
  /**
   * Only meaningful when this company IS a commission party — its multiple payee accounts (PAN/bank/UPI) it can be paid into.
   */
  commissionPartyAccounts CommissionPartyAccount[]
  /**
   * Onboarding + commercial terms, created automatically for every RESELLER company.
   */
  resellerProfile         ResellerProfile?
  /**
   * Negotiated per-item prices for this reseller.
   */
  resellerItemPrices      ResellerItemPrice[]
  /**
   * Only meaningful when this company IS a commission party — the customer companies it's linked to (referral source).
   */
  linkedCustomers         CommissionPartyLink[]    @relation("CommissionPartyLinkParty")
  /**
   * Only meaningful when this company is a CLIENT (customer) — the commission parties linked to it.
   */
  linkedCommissionParties CommissionPartyLink[]    @relation("CommissionPartyLinkCompany")

  journalEntries     JournalEntry[]        @relation("CompanyJournal")
  journalLines       JournalLine[]         @relation("JournalLineParty")
  calls              CallLog[]
  domainProfile      DomainProfile?
  workbookRecords    WorkbookRecord[]
  verifications      ContactVerification[]
  assetsSupplied     FixedAsset[]          @relation("AssetVendor")
  assetsOwned        Asset[]               @relation("AssetOwner")
  assetsOnSite       Asset[]               @relation("AssetSite")
  itAssetsSupplied   Asset[]               @relation("ITAssetVendor")
  assetMovementsFrom AssetMovement[]       @relation("AssetMovementFrom")
  assetMovementsTo   AssetMovement[]       @relation("AssetMovementTo")
  consignmentsTo     Consignment[]         @relation("ConsignmentTo")
  stickyNotes        StickyNote[]          @relation("StickyNoteCompany")
  projects           Project[]             @relation("ProjectCompany")

  vaultCredentials VaultCredential[] @relation("VaultCredentialCompany")
  /**
   * Companies merged into this one — their old links find it through these.
   */
  mergedFrom       CompanyMerge[]    @relation("CompanyMergedInto")
  visitorCompanies VisitorCompany[]  @relation("VisitorCompanyOrigin")

  @@index([stage])
  @@index([assignedToUserId])
  // Added with the RBAC work: `scopeUserIds` turns "only your team's records" into
  // `ownerUserId: { in: [...] }`, which puts this column on the hot path of every scoped list.
  // `assignedToUserId` was already indexed; this one was not, and both are filtered the same way.
  @@index([ownerUserId])
  @@index([managedByResellerId])
  @@index([creditRating])
  @@index([customerCategoryId])
  @@map("companies")
}

/**
 * A reseller's onboarding state and commercial terms. Created automatically with every RESELLER
 * company so it's never missing. Deliberately holds only what isn't already on Company: the
 * partner's PAN lives on `Company.panNumber`, GSTIN on the primary `CompanyLocation.gstNumber`, and
 * payment terms on `Company.paymentTerms` — this model doesn't duplicate them.
 */
model ResellerProfile {
  id        String                   @id @default(cuid())
  companyId String                   @unique
  company   Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status    ResellerOnboardingStatus @default(ONBOARDING)

  /**
   * Partner agreement — the date it was signed, an internal reference, and who at Wroffy approved it.
   */
  agreementSignedOn         DateTime?
  agreementReference        String?
  agreementApprovedByUserId String?
  agreementApprovedBy       User?     @relation("ResellerAgreementApprovedBy", fields: [agreementApprovedByUserId], references: [id])

  /**
   * Credit they may carry at any time, in rupees — compared against their unpaid order balance.
   */
  creditLimit Decimal? @db.Decimal(12, 2)

  tier            ResellerTier?
  /**
   * Standard discount off catalog price for this tier, overridden per item by `ResellerItemPrice`.
   */
  discountPercent Decimal?      @db.Decimal(5, 2)

  activatedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("reseller_profiles")
}

/**
 * A price negotiated with one reseller for one item — beats their tier discount, which in turn
 * beats the catalog price (see src/lib/reseller-pricing.ts).
 */
model ResellerItemPrice {
  id         String   @id @default(cuid())
  resellerId String
  reseller   Company  @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /**
   * Per-unit price for this reseller, before GST.
   */
  price      Decimal  @db.Decimal(12, 2)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([resellerId, itemId])
  @@index([resellerId])
  @@index([itemId])
  @@map("reseller_item_prices")
}

/**
 * Explicit many-to-many link between a Commission Party company and the customer company/companies
 * it's associated with — set up front (before any order/commission exists), since a referral
 * relationship is what generates the order, not the other way around. One commission party can be
 * linked to multiple customers, and one customer can have multiple commission parties.
 */
model CommissionPartyLink {
  id                String   @id @default(cuid())
  commissionPartyId String
  commissionParty   Company  @relation("CommissionPartyLinkParty", fields: [commissionPartyId], references: [id], onDelete: Cascade)
  companyId         String
  company           Company  @relation("CommissionPartyLinkCompany", fields: [companyId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([commissionPartyId, companyId])
  @@index([commissionPartyId])
  @@index([companyId])
  @@map("commission_party_links")
}

/**
 * One of a commission party's payee accounts — a commission party may want to be paid into
 * different accounts for different deals (their own account, a firm account, a family member's
 * account, etc.), so this is a list rather than a single set of fields on Company.
 */
model CommissionPartyAccount {
  id                String   @id @default(cuid())
  commissionPartyId String
  commissionParty   Company  @relation(fields: [commissionPartyId], references: [id], onDelete: Cascade)
  label             String
  accountHolderName String?
  panNumber         String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?
  upiId             String?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  expensesPaid OrderExpense[]

  @@index([commissionPartyId])
  @@map("commission_party_accounts")
}

model CompanyLocation {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label        String
  address      String?
  city         String?
  state        String?
  country      String?
  /**
   * Required by the IRP on any e-invoiced document, so it is captured on the location itself.
   */
  pincode      String?
  gstNumber    String?
  gstTreatment GstTreatment @default(UNREGISTERED)
  isPrimary    Boolean      @default(false)

  /**
   * What this address is used for on a document.
   * Two flags rather than one field because they are not exclusive: most customers bill and ship
   * to the same place, and forcing a choice would mean recording that address twice. Unlike
   * `isPrimary` there is no at-most-one constraint — a customer with three warehouses has three
   * shipping addresses, and which one a document uses is picked on the document.
   */
  isBilling  Boolean  @default(false)
  isShipping Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders             CompanyProduct[]
  tradeDocuments     TradeDocument[]
  visits             Visit[]
  assets             Asset[]
  assetMovementsFrom AssetMovement[]  @relation("AssetMovementFromLocation")
  assetMovementsTo   AssetMovement[]  @relation("AssetMovementToLocation")
  consignments       Consignment[]

  @@index([companyId])
  @@map("company_locations")
}

model Contact {
  id          String             @id @default(cuid())
  companyId   String
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  /**
   * Stable identity for exports and migrations.
   * `email` is nullable and unconstrained here, `phone` likewise, so a contact with neither falls
   * back to (company, name) — which collides on common names inside exactly the large customers
   * where it matters. Moving somebody between companies also re-keys them, so the same person
   * arrives in a target system twice.
   */
  contactSeq  Int                @unique @default(autoincrement())
  designation ContactDesignation @default(OTHER)
  email       String?
  phone       String?
  linkedinUrl String?
  isPrimary   Boolean            @default(false)
  /**
   * Gets the invoices, proposals and credit notes — pre-selected when somebody presses Mail on a
   * document for this company. See src/actions/document-mail.ts.
   */
  receivesDocuments Boolean      @default(false)

  /**
   * The last verdict on this email address — see src/lib/email-verification.ts.
   * `emailCheckedValue` is the address the verdict belongs to, and the UI compares it with
   * `email` before showing anything. Without it, editing an address would inherit the previous
   * green tick, and every write path in the app would have to remember to clear these fields.
   */
  emailStatus          EmailCheckStatus  @default(UNCHECKED)
  emailCheckedValue    String?
  emailCheckedAt       DateTime?
  emailCheckMethod     EmailCheckMethod?
  emailCheckDetail     String?
  emailCheckedByUserId String?
  emailCheckedBy       User?             @relation("ContactEmailCheckedBy", fields: [emailCheckedByUserId], references: [id])
  /**
   * The preference-centre link. Long-lived rather than one-time — somebody has to be able to come
   * back and change their mind — and generated lazily, so a contact nobody has ever mailed has none.
   * Null, too, for contacts added before this was tracked.
   */
  preferenceToken      String?           @unique
  /**
   * Preference links of contacts combined into this one when two companies were merged — mail
   * already sent carries them, and an unsubscribe link has to keep working after the person it was
   * sent to became somebody else's record. See src/lib/companies/merge.ts.
   */
  formerPreferenceTokens String[]        @default([])
  createdByUserId      String?
  createdBy            User?             @relation("ContactCreatedBy", fields: [createdByUserId], references: [id])
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  leads             Lead[]
  tickets           Ticket[]
  visits            Visit[]
  feedbackRequests  FeedbackRequest[]     @relation("FeedbackContact")
  journeyEnrolments JourneyEnrolment[]    @relation("JourneyContact")
  marketingMessages MarketingMessage[]    @relation("MarketingMessageContact")
  consents          ContactConsent[]      @relation("ContactConsent")
  marketingLists    MarketingListMember[] @relation("MarketingListMemberContact")
  formSubmissions   FormSubmission[]      @relation("FormSubmissionContact")
  formInvites       FormInvite[]          @relation("FormInviteContact")

  calls            CallLog[]
  verifications    ContactVerification[]
  assetsHeld       Asset[]               @relation("AssetHolder")
  assetMovementsTo AssetMovement[]       @relation("AssetMovementToContact")
  consignments     Consignment[]         @relation("ConsignmentContact")
  projectStakes    ProjectStakeholder[]  @relation("ProjectStakeholderContact")
  portalLogins     PortalLogin[]         @relation("PortalLoginContact")

  @@index([companyId])
  @@index([emailStatus])
  @@map("contacts")
}

model Lead {
  id                String     @id @default(cuid())
  companyId         String
  company           Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId         String?
  contact           Contact?   @relation(fields: [contactId], references: [id])
  /**
   * Stable identity. `title` is mutable free text that salespeople rewrite as a deal evolves, and
   * this model has no unique constraint at all — so a key built from it is not merely
   * collision-prone but *unstable*, which is worse: a collision can be found by counting, while a
   * renamed record simply imports a second time and nothing notices.
   */
  leadSeq           Int        @unique @default(autoincrement())
  title             String
  description       String?
  status            LeadStatus @default(NEW)
  lostReason        String?
  sourcedByUserId   String?
  sourcedBy         User?      @relation("LeadSourcedBy", fields: [sourcedByUserId], references: [id])
  qualifiedByUserId String?
  qualifiedBy       User?      @relation("LeadQualifiedBy", fields: [qualifiedByUserId], references: [id])
  ownerUserId       String?
  owner             User?      @relation("LeadOwner", fields: [ownerUserId], references: [id])
  estimatedValue    Decimal?   @db.Decimal(12, 2)
  expectedCloseDate DateTime?
  /**
   * Who actually created this lead record — null for leads created before this was tracked; distinct from `sourcedByUserId`, which is inherited from the company and means something different.
   */
  createdByUserId   String?
  createdBy         User?      @relation("LeadCreatedBy", fields: [createdByUserId], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  /// Where the enquiry came from. Distinct from Company.source, which is how the *account* was found.
  source         LeadSource      @default(OTHER)
  /// The particulars — which website and page, which campaign, who referred them.
  sourceDetail   String?
  /// 0–100, from `scoreLead` (src/lib/leads/score.ts). Stored so the list can sort by it; refreshed
  /// on every change to the lead and by the periodic tick, because part of it is how recent things are.
  score          Int?
  scoreUpdatedAt DateTime?
  /// How the owner was chosen, in words — "Rule: Microsoft leads (round robin)". Shown on the lead
  /// so the person it landed on can see why, and so can whoever set the rules.
  assignmentNote String?
  /// The website API key that sent it, and that site's own id for the enquiry. Together unique, so a
  /// website retrying a request that timed out gets the same lead back instead of a duplicate.
  captureKeyId   String?
  captureKey     LeadCaptureKey? @relation(fields: [captureKeyId], references: [id], onDelete: SetNull)
  externalId     String?

  activities   Activity[]
  proposals    Proposal[]
  requirements LeadRequirement[]
  /**
   * Proposals, proformas and invoices raised from this deal. Distinct from `proposals` above,
   * which is the thin pre-catalogue record the order-punch picker still reads — a `TradeDocument`
   * is the real priced, numbered, printable quotation.
   */
  documents    TradeDocument[]   @relation("TradeDocumentLead")
  tasks        Task[]
  visits       Visit[]
  expenses     Expense[]

  calls           CallLog[]
  formSubmissions FormSubmission[] @relation("FormSubmissionLead")
  stickyNotes     StickyNote[]     @relation("StickyNoteLead")

  @@unique([captureKeyId, externalId])
  @@index([companyId])
  @@index([status])
  // Same reason as Company.ownerUserId above.
  @@index([ownerUserId])
  /// Every Leads report windows on this. See the note on Ticket.
  @@index([createdAt])
  @@index([score])
  @@index([source])
  @@map("leads")
}

model Activity {
  id         String       @id @default(cuid())
  leadId     String
  lead       Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  type       ActivityType
  notes      String
  occurredAt DateTime     @default(now())
  createdAt  DateTime     @default(now())

  @@index([leadId])
  @@map("activities")
}

model Proposal {
  id           String         @id @default(cuid())
  leadId       String
  lead         Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sentByUserId String?
  sentBy       User?          @relation(fields: [sentByUserId], references: [id])
  status       ProposalStatus @default(DRAFT)
  sentAt       DateTime?
  validUntil   DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  orders CompanyProduct[]

  @@index([leadId])
  @@map("proposals")
}

model SystemModule {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("system_modules")
}

/**
 * Singleton row (id is always "global") holding org-wide login security policy and Microsoft SSO app registration.
 */
model SecuritySettings {
  id                          String   @id @default("global")
  enforceTwoFactor            Boolean  @default(false)
  ssoEnabled                  Boolean  @default(false)
  enforceSso                  Boolean  @default(false)
  microsoftTenantId           String?
  microsoftClientId           String?
  /**
   * AES-256-GCM encrypted (see src/lib/crypto.ts) — never sent to the client.
   */
  microsoftClientSecretCipher String?
  updatedAt                   DateTime @updatedAt

  @@map("security_settings")
}

/**
 * Singleton row (id is always "global") holding the white-label identity: what the app is called,
 * its logo, and the brand colour every accent in the UI is derived from. Images are stored as data
 * URLs rather than files so a deployment needs no writable disk or object store — the upload action
 * caps them at a size where that stays sane.
 */
model BrandingSettings {
  id             String   @id @default("global")
  appName        String   @default("Wroffy ERP")
  /**
   * Shown when the sidebar is collapsed — falls back to the first letters of `appName`.
   */
  shortName      String?
  tagline        String?
  logoDataUrl    String?
  faviconDataUrl String?
  /**
   * Hex. Every brand tint in the UI is derived from this with CSS color-mix().
   */
  primaryColor   String   @default("#4f46e5")
  /**
   * light | dark | system — the starting point before a user picks their own.
   */
  defaultTheme   String   @default("system")
  updatedAt      DateTime @updatedAt

  @@map("branding_settings")
}

/**
 * Singleton ("global") holding who *we* are on a tax document: legal name, GSTIN, registered
 * address and bank details. Without this an invoice can't be raised — the seller's GSTIN and state
 * decide whether a supply is CGST+SGST or IGST — so it's the first thing the invoice flow checks.
 */
model OrganisationSettings {
  id        String  @id @default("global")
  legalName String  @default("")
  tradeName String?
  gstin     String?
  pan       String?
  cin       String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  /**
   * Two-digit GST state code — the seller half of the place-of-supply comparison.
   */
  stateCode    String?
  pincode      String?
  /// Blank means India, as it does on every address — see `isIndia`. Printed only when it is not.
  country      String?
  email        String?
  phone        String?

  bankName          String?
  bankAccountNumber String?
  bankIfsc          String?
  bankBranch        String?
  upiId             String?

  invoiceTerms     String?
  invoiceNotes     String?
  /**
   * Round document totals to the nearest rupee, showing the difference as its own line.
   */
  roundOffTotals   Boolean @default(true)
  /**
   * Signature/stamp image as a data URL, printed on issued documents.
   */
  signatureDataUrl String?

  /**
   * e-invoicing (IRP). Credentials are encrypted at rest — see src/lib/crypto.ts.
   */
  einvoiceEnabled            Boolean  @default(false)
  einvoiceProvider           String   @default("mock")
  einvoiceUsername           String?
  einvoicePasswordCipher     String?
  einvoiceClientId           String?
  einvoiceClientSecretCipher String?
  /**
   * Invoices below this value skip IRN generation, mirroring the turnover-based exemption rules.
   */
  einvoiceMinValue           Decimal? @db.Decimal(12, 2)

  /**
   * e-way bills. Same portal operator and the same credentials as e-invoicing, so there is nothing
   * more to enter — but its own switch, because plenty of businesses register for one and not the
   * other, and a single flag would make turning off IRN generation silently stop bills as well.
   */
  ewayEnabled Boolean @default(false)

  /**
   * The floor for movement that stays inside our own state. Null means the central ₹50,000, which
   * is what most states use. Inter-state is never affected — that threshold is not ours to set.
   */
  ewayIntraStateThreshold Decimal? @db.Decimal(12, 2)

  /**
   * Letterhead. Separate from the app's own branding because the logo at the top of an appointment
   * letter is the employer's, and the logo in the sidebar is the software's — usually the same
   * image, but an employer who white-labels the app would be quietly signing letters with the
   * wrong mark. Null falls back to the app logo.
   */
  letterheadLogoDataUrl String?
  /**
   * The fine print along the bottom of company paper — registered office, CIN, website.
   */
  letterheadFooter      String?
  /**
   * Prefix for every letter reference number, e.g. WRF in WRF/APPT/2026/001.
   */
  letterNumberPrefix    String  @default("WRF")
  /**
   * Who letters are signed by. Left blank, a letter is signed by whoever drafted it.
   */
  letterSignatoryName   String?
  letterSignatoryTitle  String?

  /**
   * Feedback. `feedbackReviewUrl` is the public review page — a Google Business Profile short
   * link — that a happy customer is offered, and `feedbackReviewMinRating` is the score at or
   * above which they are offered it. Set it to 1 and everybody is shown it, which is what
   * Google's own review policy asks for; see src/lib/feedback/rating.ts.
   */
  feedbackReviewUrl       String?
  feedbackReviewMinRating Int     @default(4)
  /**
   * How long a feedback link stays usable.
   */
  feedbackLinkDays        Int     @default(30)
  /**
   * The line at the top of the form, in the customer's language rather than ours.
   */
  feedbackIntro           String?

  /**
   * Marketing. `marketingFromDomain` is the subdomain bulk goes out from — kept apart from the
   * primary domain so a bad campaign can never cost us the deliverability of an invoice.
   */
  marketingFromDomain           String?
  /**
   * Printed in every marketing footer. Required by most providers, and by good manners.
   */
  marketingPostalAddress        String?
  /**
   * Minutes from midnight. Nothing marketing goes out between these.
   */
  marketingQuietStartMinute     Int     @default(1200)
  marketingQuietEndMinute       Int     @default(540)
  /**
   * Nothing marketing on a weekend or a company holiday.
   */
  marketingSkipNonWorkingDays   Boolean @default(true)
  /**
   * However many campaigns are running, one contact hears from us this often at most.
   */
  marketingMaxPerContactPerWeek Int     @default(2)
  /**
   * A campaign larger than this needs a second person to approve it.
   */
  marketingApprovalThreshold    Int     @default(200)

  updatedAt DateTime @updatedAt

  @@map("organisation_settings")
}

/**
 * Sales documents flow one way, purchase documents the other; everything else about them matches.
 */
enum TradeDirection {
  SALES
  PURCHASE
}

enum TradeDocumentType {
  /**
   * Quote to a customer.
   */
  PROPOSAL
  /**
   * Payment request before supply — not a tax invoice, never gets an IRN.
   */
  PROFORMA
  /**
   * GST tax invoice — the document that carries an IRN.
   */
  INVOICE
  /**
   * Reduces a previously issued invoice (return, discount, cancellation).
   */
  CREDIT_NOTE
  /**
   * Our PO to a vendor.
   */
  PURCHASE_ORDER
  /**
   * The vendor's invoice to us, recorded against a PO.
   */
  BILL
  /**
   * Goods moving without a sale — out for repair, on loan, to an exhibition. Carries no tax and
   * never reaches the ledger, because no supply has taken place.
   */
  DELIVERY_CHALLAN
}

/**
 * Which part of the app raised a document — see `TradeDocument.origin`.
 * Deliberately only the paths that exist. A speculative value nothing ever writes is vocabulary that
 * reads as meaningful on a screen and never appears, and extending an enum is a migration either
 * way, so there is nothing saved by guessing ahead.
 */
enum DocumentOrigin {
  /**
   * Typed into the document form.
   */
  MANUAL
  /**
   * Converted from another document — `sourceDocumentId` says which.
   */
  CONVERSION
  /**
   * The pro-rata calculator in the side rail: seats added part-way through a term.
   */
  ADDON_CALCULATOR
  /**
   * One click from the renewals list.
   */
  RENEWAL
  /**
   * The delivery challan raised automatically when a consignment is dispatched.
   */
  CONSIGNMENT
}

/**
 * Where a document has got to in sign-off — see `TradeDocument.approvalStatus`.
 * A separate axis from `TradeDocumentStatus` on purpose. That field already carries what the
 * *customer* did: ACCEPTED and REJECTED mean they took or turned down the quote. Reusing them for
 * internal sign-off would make "Rejected" mean two opposite things on the same screen — the customer
 * said no, or a colleague sent it back for a correction before it ever left the building.
 * Whether a document needs approving at all is not stored here. That is the policy's answer, and it
 * can change: turning approval on for invoices must apply to the drafts already sitting there, which
 * a value frozen onto each row at creation could never do.
 */
enum DocumentApprovalStatus {
  /**
   * Nobody has asked for sign-off. The resting state, and where an edited document returns to.
   */
  NOT_SUBMITTED
  PENDING
  APPROVED
  /**
   * Sent back. The document stays a draft and stays editable — that is the point of rejecting it.
   */
  REJECTED
}

enum TradeDocumentStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  PARTIALLY_PAID
  PAID
  CANCELLED
  EXPIRED
}

enum EInvoiceStatus {
  /**
   * Proposals, proformas and POs are never reported to the IRP.
   */
  NOT_APPLICABLE
  PENDING
  GENERATED
  FAILED
  CANCELLED
}

/**
 * One model for every trade document — quote, proforma, invoice, credit note, PO and bill. They
 * share a party, dated lines, GST maths, numbering and totals; splitting them into six near-identical
 * models would mean six copies of the tax engine. `docType` and `direction` say which one it is.
 */
model TradeDocument {
  id        String              @id @default(cuid())
  docNumber String              @unique
  docType   TradeDocumentType
  direction TradeDirection
  status    TradeDocumentStatus @default(DRAFT)

  /**
   * The other party — a customer for sales, a vendor for purchase.
   */
  companyId  String
  company    Company          @relation("TradeDocumentParty", fields: [companyId], references: [id])
  /**
   * The deal this document was raised from, when it came from one.
   * Nullable and `SetNull`, because most documents are raised straight against a company and a
   * deleted lead must not take an issued invoice with it. Kept alongside `sourceDocumentId` rather
   * than derived from it: a proposal converted to an invoice should still answer "which deal?"
   * without walking the conversion chain back to its start.
   */
  leadId     String?
  lead       Lead?            @relation("TradeDocumentLead", fields: [leadId], references: [id], onDelete: SetNull)
  locationId String?
  location   CompanyLocation? @relation(fields: [locationId], references: [id])

  /**
   * Two-digit state code the supply is taxed in — drives CGST+SGST vs IGST.
   */
  placeOfSupplyCode String?

  /**
   * The currency the document is written in, and the rate that brings it into rupees. The books are
   * kept in rupees, so everything posts converted — but the document has to print in what the
   * customer agreed to pay.
   */
  currency      String       @default("INR")
  exchangeRate  Decimal      @default(1) @db.Decimal(14, 6)
  /**
   * Snapshot of both GSTINs, so a later edit to either company can't rewrite history on an issued document.
   */
  sellerGstin   String?
  buyerGstin    String?
  /**
   * The party's name as it stood on an issued document, frozen when the party was merged into another
   * company — so a reprint, and the e-invoice already registered, still say what was issued. Null
   * means "read the company's name", which is right for everything never merged. See
   * src/lib/companies/merge.ts.
   */
  partyName     String?
  /**
   * How the buyer is treated for GST on this document. Snapshotted rather than read from the
   * company, because it decides whether a GSTIN is required and a customer's registration can
   * change after a document is issued.
   */
  gstTreatment  GstTreatment @default(UNREGISTERED)
  reverseCharge Boolean      @default(false)

  /**
   * Addresses are copied onto the document rather than referenced. A delivery address is a fact
   * about that despatch, and editing the customer's address later must not rewrite where goods
   * were actually sent on an invoice already issued.
   */
  dispatchFromAddress String?
  billingAttention    String?
  billingLine1        String?
  billingLine2        String?
  billingCity         String?
  billingState        String?
  billingStateCode    String?
  billingPincode      String?
  billingCountry      String? @default("India")
  billingPhone        String?

  /**
   * Blank means "same as billing", which is the common case.
   */
  shippingSameAsBilling Boolean @default(true)
  shippingAttention     String?
  shippingLine1         String?
  shippingLine2         String?
  shippingCity          String?
  shippingState         String?
  shippingStateCode     String?
  shippingPincode       String?
  shippingCountry       String? @default("India")
  shippingPhone         String?
  shippingGstin         String?

  issueDate  DateTime  @default(now())
  dueDate    DateTime?
  validUntil DateTime?

  /**
   * Which part of the app raised this document.
   * Not the same question as `sourceDocumentId`, which says *what* it was converted from — this says
   * *how* it came to exist at all. A proposal typed into the document form and one produced in a
   * click from the renewals list are the same record afterwards, and telling them apart is what
   * answers "is anybody actually using the renewal button?" and "where did this quote come from?".
   * Nullable rather than defaulted, so a creation path that forgets to say silently reads as "not
   * recorded" instead of claiming to be manual. `createTradeDocument` fills it in for everything
   * that goes through it.
   */
  origin DocumentOrigin?

  /**
   * Internal sign-off, which is a different question from what the customer did with it.
   * Only meaningful where `DocumentApprovalPolicy` has approval switched on for this type; where it
   * is off, every document sits at NOT_SUBMITTED and issuing does not consult it.
   * Editing an APPROVED document puts it back to NOT_SUBMITTED. Without that, sign-off means
   * nothing: a ₹1,000 quote gets approved and then edited to ₹10,00,000 carrying somebody else's
   * name as the approver.
   */
  approvalStatus DocumentApprovalStatus @default(NOT_SUBMITTED)
  submittedById  String?
  submittedBy    User?                  @relation("DocumentSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt    DateTime?
  approvedById   String?
  approvedBy     User?                  @relation("DocumentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?
  /**
   * Why it was sent back, or a note from whoever signed it off. The part worth reading later.
   */
  approvalNote   String?

  /**
   * Proposal → proforma → invoice: each conversion records where it came from.
   */
  sourceDocumentId  String?
  sourceDocument    TradeDocument?            @relation("TradeDocumentConversion", fields: [sourceDocumentId], references: [id])
  conversions       TradeDocument[]           @relation("TradeDocumentConversion")
  billingMilestones ProjectBillingMilestone[] @relation("BillingMilestoneDocument")
  /**
   * A credit note always points at the invoice it reduces.
   */
  againstDocumentId String?
  againstDocument   TradeDocument?            @relation("TradeDocumentCreditNote", fields: [againstDocumentId], references: [id])
  creditNotes       TradeDocument[]           @relation("TradeDocumentCreditNote")
  ewayBills         EwayBill[]                @relation("TradeDocumentEwayBill")

  subtotal      Decimal @default(0) @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  taxableValue  Decimal @default(0) @db.Decimal(14, 2)
  cgstAmount    Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount    Decimal @default(0) @db.Decimal(14, 2)
  igstAmount    Decimal @default(0) @db.Decimal(14, 2)

  /**
   * Freight billed to the customer, taxed at its own rate.
   */
  shippingCharge         Decimal         @default(0) @db.Decimal(12, 2)
  shippingTaxRatePercent Decimal         @default(0) @db.Decimal(5, 2)
  /**
   * TDS reduces what the customer pays us; TCS adds to it.
   */
  withholdingMode        WithholdingMode @default(NONE)
  /**
   * The section it's deducted under, e.g. "194Q" — printed on the document.
   */
  withholdingSection     String?
  withholdingRatePercent Decimal         @default(0) @db.Decimal(5, 2)
  withholdingAmount      Decimal         @default(0) @db.Decimal(12, 2)
  /**
   * A free-text plus/minus on the total, for the odd correction a document needs.
   */
  adjustmentLabel        String?
  adjustment             Decimal         @default(0) @db.Decimal(12, 2)

  roundOff Decimal @default(0) @db.Decimal(6, 2)
  total    Decimal @default(0) @db.Decimal(14, 2)

  reference String?
  notes     String?
  terms     String?

  einvoiceStatus       EInvoiceStatus @default(NOT_APPLICABLE)
  irn                  String?        @unique
  ackNo                String?
  ackDate              DateTime?
  signedQrCode         String?
  einvoiceError        String?
  einvoiceCancelledAt  DateTime?
  einvoiceCancelReason String?

  createdById   String
  createdBy     User      @relation("TradeDocumentCreatedBy", fields: [createdById], references: [id])
  /// Who owns the deal, as opposed to whoever keyed the document in. Drives the salesperson column
  /// and commission; defaults to the company's owner when a document is created.
  salespersonId String?
  salesperson   User?     @relation("TradeDocumentSalesperson", fields: [salespersonId], references: [id])
  issuedAt      DateTime?
  /** The last time it was emailed to the customer from here. Who to, and from whom, is in `emails`. */
  lastEmailedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  emails          MarketingMessage[]      @relation("MarketingMessageDocument")
  renderGrants    DocumentRenderGrant[]
  lines           TradeDocumentLine[]
  /**
   * Payments settling this invoice.
   */
  payments        PaymentAllocation[]     @relation("InvoicePayment")
  /**
   * Credit notes reducing this invoice.
   */
  creditsReceived CreditNoteApplication[] @relation("InvoiceCredited")
  /**
   * Where this credit note has been applied.
   */
  creditsApplied  CreditNoteApplication[] @relation("CreditNoteApplied")

  journalEntries JournalEntry[] @relation("DocumentJournal")
  consignments   Consignment[]  @relation("ConsignmentDocument")

  @@index([companyId])
  @@index([leadId])
  @@index([docType, status])
  @@index([direction, issueDate])
  @@index([salespersonId])
  /// Both Dated-on options. `(direction, issueDate)` above cannot serve a window on issueDate alone.
  @@index([issueDate])
  @@index([dueDate])
  @@map("trade_documents")
}

model TradeDocumentLine {
  id         String        @id @default(cuid())
  documentId String
  document   TradeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  itemId           String?
  item             Item?           @relation(fields: [itemId], references: [id])
  /**
   * Set when this line bills an existing order, so an order can be traced to the invoice that billed it.
   */
  companyProductId String?
  companyProduct   CompanyProduct? @relation(fields: [companyProductId], references: [id])

  /**
   * Copied from the item at the time of writing — a later catalogue rename must not alter an issued document.
   */
  name        String
  /**
   * The free text under the name: what's included, the period covered, serial numbers.
   */
  description String?
  hsnCode     String?
  unit        String?

  quantity       Decimal      @db.Decimal(12, 3)
  unitPrice      Decimal      @db.Decimal(14, 2)
  /**
   * Entered as a percentage of the line or a flat amount off it — `discountMode` says which.
   */
  discountMode   DiscountMode @default(PERCENT)
  discountValue  Decimal      @default(0) @db.Decimal(14, 2)
  /**
   * The resolved rupee discount, so a printed document doesn't have to re-derive it.
   */
  discountAmount Decimal      @default(0) @db.Decimal(14, 2)
  taxRatePercent Decimal      @default(0) @db.Decimal(5, 2)

  taxableValue Decimal @default(0) @db.Decimal(14, 2)
  cgstAmount   Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount   Decimal @default(0) @db.Decimal(14, 2)
  igstAmount   Decimal @default(0) @db.Decimal(14, 2)
  lineTotal    Decimal @default(0) @db.Decimal(14, 2)

  sortOrder Int @default(0)

  @@index([documentId])
  @@index([itemId])
  @@map("trade_document_lines")
}

enum DocumentNumberMode {
  /**
   * The app builds the number from a prefix and a running counter.
   */
  AUTO
  /**
   * Whoever raises the document types it, and uniqueness is all that's enforced.
   */
  MANUAL
}

/**
 * Who signs off each kind of document before it can be issued.
 * One row per document type, because the answer differs by type and that is the whole point: a
 * quotation is a commitment to a price and belongs to whoever runs the desk, while a tax invoice
 * posts to the ledger and files with the government and belongs to accounts.
 * ## Three ways to name an approver, and why all three
 * `approverRoles` follows the job rather than the person, so it survives somebody leaving.
 * `approvers` names individuals, which is the right answer when two named people sign off invoices
 * and nobody else. `managerApproves` sends a document up the submitter's own reporting line, which
 * is the only one of the three that gives a different answer per document — Rahul's goes to Priya,
 * Sana's goes to Amit — and so is the only one that can express "a manager approves for their team".
 * They are additive: any one of them being satisfied is enough. An approval system where the rules
 * had to *all* agree would deadlock the first time somebody's manager was on leave.
 * Off by default for every type, so installing this changes nothing until somebody turns it on.
 */
model DocumentApprovalPolicy {
  docType TradeDocumentType @id
  enabled Boolean           @default(false)

  /**
   * Role keys, not foreign keys — a scalar list cannot carry one.
   * `deleteRole` guards against orphaning these, the same way it refuses a role somebody still
   * holds. Silently dropping a deleted role from a policy would quietly change who may approve an
   * invoice, which is not a change that should happen as a side effect of tidying up roles.
   */
  approverRoles   String[] @default([])
  approvers       User[]   @relation("DocumentApprover")
  managerApproves Boolean  @default(false)

  /// Only documents worth more than this (in rupees, GST included) need approval. Null: every one does
  /// — unless the discount rule below is the only rule set. See `approvalRequirement`.
  minValue           Decimal? @db.Decimal(14, 2)
  /// Any line discounted by more than this percent needs approval, whatever the document is worth.
  maxDiscountPercent Decimal? @db.Decimal(5, 2)

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("ApprovalPolicyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("document_approval_policies")
}

/**
 * How each document type's number is built — the prefix and the next serial, editable the way
 * Zoho Books does it. Separate from `DocumentCounter`, which is the financial-year GST series:
 * this is the *format*, that is the *sequence*.
 */
model DocumentNumberSetting {
  docType    TradeDocumentType  @id
  mode       DocumentNumberMode @default(AUTO)
  /**
   * Free text, e.g. "WT/26-27/QT/". Supports {FY} for the financial year.
   */
  prefix     String             @default("")
  nextNumber Int                @default(1)
  /**
   * Zero-padding width for the serial, so 12 renders as 0012.
   */
  padding    Int                @default(4)
  updatedAt  DateTime           @updatedAt

  @@map("document_number_settings")
}

/**
 * A line discount is entered either as a percentage of the line, or as a flat amount off it.
 */
enum DiscountMode {
  PERCENT
  AMOUNT
}

/**
 * Tax deducted or collected at source, applied to the document total.
 */
enum WithholdingMode {
  NONE
  TDS
  TCS
}

/**
 * GST requires a unique, consecutive serial per document type per financial year, so the counter is
 * kept in its own row and incremented inside the same transaction that creates the document.
 */
/**
 * The running serial for journal entries, one row per financial year.
 * Numbers used to be derived by reading the highest existing `entryNumber` and adding one, which
 * failed two ways. Lexicographically, "JV/2026-27/9999" sorts above "JV/2026-27/10000", so at ten
 * thousand entries the maximum stopped moving and every posting in the year failed on the unique
 * index — invoices, receipts, expenses and payroll, permanently. And two transactions reading that
 * maximum at once both computed the same number, so one of them rolled back under ordinary
 * concurrent use.
 * An incremented row settles both: the count is a number rather than a string, and the row lock
 * serialises the two writers.
 */
model JournalCounter {
  financialYear String @id
  lastNumber    Int    @default(0)

  @@map("journal_counters")
}

model DocumentCounter {
  id            String            @id @default(cuid())
  docType       TradeDocumentType
  /**
   * Indian financial year the series belongs to, e.g. "2026-27".
   */
  financialYear String
  lastNumber    Int               @default(0)

  @@unique([docType, financialYear])
  @@map("document_counters")
}

model RolePermission {
  role       String
  roleRef    Role     @relation(fields: [role], references: [key], onDelete: Cascade)
  permission String
  allowed    Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@id(name: "role_permission", [role, permission])
  @@map("role_permissions")
}

/**
 * Who makes the product — Microsoft, Adobe, Autodesk, Dell.
 */
model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    Item[]
  families ProductFamily[]

  @@map("brands")
}

/**
 * A line within a brand that groups related SKUs — "Microsoft 365", "Creative Cloud", "AutoCAD",
 * "Latitude". Names are only unique inside a brand, since two brands can both have a "Pro" line.
 */
model ProductFamily {
  id        String   @id @default(cuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  @@unique([brandId, name])
  @@index([brandId])
  @@map("product_families")
}

model Item {
  id              String         @id @default(cuid())
  /**
   * Human-readable catalog number (ITM-000001) — the id staff quote, distinct from the cuid and from the supplier's SKU.
   */
  itemSeq         Int            @unique @default(autoincrement())
  name            String
  sku             String         @unique
  type            ItemType
  category        String?
  /**
   * HSN (goods) or SAC (services) code — mandatory on a GST invoice line.
   */
  hsnCode         String?
  /**
   * Free-text supplier note kept from before Brand existed — the brand is `brandId`.
   */
  vendor          String?
  brandId         String?
  brand           Brand?         @relation(fields: [brandId], references: [id])
  productFamilyId String?
  productFamily   ProductFamily? @relation(fields: [productFamilyId], references: [id])
  unit            String?
  billingCycle    BillingCycle?
  costPrice       Decimal?       @db.Decimal(12, 2)
  sellingPrice    Decimal        @db.Decimal(12, 2)
  taxRatePercent  Decimal?       @db.Decimal(5, 2)
  description     String?
  trackInventory  Boolean        @default(false)
  reorderLevel    Int?
  stockQuantity   Int            @default(0)
  active          Boolean        @default(true)
  createdById     String
  createdBy       User           @relation(fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  stockMovements     StockMovement[]
  leadRequirements   LeadRequirement[]
  companyProducts    CompanyProduct[]
  resellerPrices     ResellerItemPrice[]
  tradeDocumentLines TradeDocumentLine[]
  assets             Asset[]

  @@index([type])
  @@index([brandId])
  @@index([productFamilyId])
  @@map("items")
}

model LeadRequirement {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  quantity    Int       @default(1)
  /// Remarks — shown as such on the forms. Where the reference that identifies an existing
  /// subscription goes: a Microsoft tenant ID, an Adobe VIP number, an Autodesk contract ID.
  notes       String?
  /// When the subscription this line is about comes up for renewal, if it is a renewal. Date only,
  /// stored as UTC midnight like `Lead.expectedCloseDate`, so `toISOString().slice(0, 10)` is the day.
  renewalDate DateTime?
  createdAt   DateTime  @default(now())

  @@index([leadId])
  @@index([itemId])
  @@map("lead_requirements")
}

model CompanyProduct {
  id         String          @id @default(cuid())
  orderSeq   Int             @unique @default(autoincrement())
  companyId  String
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locationId String
  location   CompanyLocation @relation(fields: [locationId], references: [id])
  itemId     String
  item       Item            @relation(fields: [itemId], references: [id])
  /**
   * Which vendor company this order was purchased from — the supply side of the sale. Set by the
   * purchase team once the order is approved, not required at punch time (see `orderStatus`).
   */
  vendorId   String?
  vendor     Company?        @relation("CompanyProductVendor", fields: [vendorId], references: [id])
  quantity   Int             @default(1)

  /**
   * The subscription this adds seats to.
   * An addon is a *separate order* that shares an expiry, not a bigger number on the original. It
   * was sold on a different day, at a pro-rated price, on a different invoice, and often by a
   * different person — bumping the parent's quantity from 10 to 15 would destroy every one of those
   * facts, change last quarter's sales figure retroactively, and give the person who sold the extra
   * seats no credit for them.
   * At renewal the parent and its addons come back as one line, which is the whole point of
   * co-terming.
   */
  parentId String?
  parent   CompanyProduct? @relation("SubscriptionAddons", fields: [parentId], references: [id], onDelete: Cascade)

  /**
   * The subscription this one replaces.
   * Set when a renewal is punched from the renewals list. Without it, "has this been renewed?"
   * can only be guessed at by matching company and item, which is wrong the moment a customer
   * holds two of the same product — and it is the reason a renewed subscription would otherwise
   * keep appearing on the chase list.
   */
  renewedFromId String?          @unique
  renewedFrom   CompanyProduct?  @relation("SubscriptionRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewedBy     CompanyProduct?  @relation("SubscriptionRenewal")
  addons        CompanyProduct[] @relation("SubscriptionAddons")

  /**
   * A renewal stage somebody pinned by hand.
   * Null is the normal state and means "work it out" — the stage is otherwise derived from what has
   * actually happened (a call logged, a proposal raised, the renewal punched), which cannot go stale
   * the way a field people have to remember to update always does. See `resolveRenewalStage`.
   * This column exists for the three things that leave no trace at all and are exactly what a
   * salesperson wants to record: NEGOTIATING, ON_HOLD and LOST. The enum holds the derived stages
   * too, so allowing one of those to be pinned later is a change to the picker rather than another
   * migration — but nothing offers them today, because pinning a stage the evidence already reports
   * only stops it moving on its own.
   * A pin does not survive the renewal actually being punched: an order existing is a fact and
   * "Lost" is an opinion that has since been overtaken. The column keeps the pinned value rather than
   * clearing it, so the screen can say it was overtaken instead of silently contradicting whoever
   * set it.
   */
  renewalStage     RenewalStage?
  /**
   * Why — the part worth reading back on a lost renewal. "Lost" alone answers nothing.
   */
  renewalStageNote String?
  renewalStageAt   DateTime?
  renewalStageById String?
  renewalStageBy   User?         @relation("RenewalStageSetBy", fields: [renewalStageById], references: [id], onDelete: SetNull)

  /**
   * What a full year of one seat costs, kept beside the pro-rated `unitPrice` an addon is actually
   * charged at. Without it the renewal has nothing to price from — the ₹1,240 charged for four
   * months is not what a year costs, and working backwards from it invites rounding drift.
   */
  fullTermUnitPrice Decimal? @db.Decimal(12, 2)
  /**
   * Days the addon was charged for, and the days in the parent's full term. Frozen, so an invoice
   * raised today can still be explained after somebody edits the parent's dates.
   */
  proRataDays       Int?
  fullTermDays      Int?

  notes          String?
  poNumber       String?
  startDate      DateTime?
  endDate        DateTime?
  addedByUserId  String
  addedBy        User                  @relation(fields: [addedByUserId], references: [id])
  reconcileLines VendorStatementLine[] @relation("ReconcileMatchedOrder")
  portalRequests PortalRequest[]       @relation("PortalRequestOrder")
  createdAt      DateTime              @default(now())

  /**
   * The order-punching workflow stage. See the `OrderStatus` doc-comment for the full lifecycle.
   */
  orderStatus   OrderStatus       @default(PENDING_APPROVAL)
  /**
   * New business vs. a renewal (with us or from elsewhere) — see the `OrderBusinessType` doc-comment.
   */
  businessType  OrderBusinessType @default(NEW)
  /**
   * Only set when `companyId` is a RESELLER: who the reseller is buying this for. The order still
   * belongs to the reseller (they're who we invoice and chase payment from); this is who it's
   * delivered/provisioned for, and who support sees it against.
   */
  endCustomerId String?
  endCustomer   Company?          @relation("OrderEndCustomer", fields: [endCustomerId], references: [id])
  /**
   * Actual negotiated per-unit sale price for this order — null means "use the item's catalog `sellingPrice`" (keeps every pre-existing order's financials unchanged).
   */
  unitPrice     Decimal?          @db.Decimal(12, 2)
  /**
   * Per-unit cost price the purchase team actually paid the vendor — the other half of the margin calculation, alongside `unitPrice`.
   */
  purchasePrice Decimal?          @db.Decimal(12, 2)
  /**
   * Wroffy's own PO number issued to the vendor — distinct from `poNumber` above, which is the customer's PO/invoice reference to us.
   */
  ourPoNumber   String?
  /**
   * Per-order payment terms override — null falls back to the company's own default `paymentTerms`.
   */
  paymentTerms  PaymentTerms?
  proposalId    String?
  proposal      Proposal?         @relation(fields: [proposalId], references: [id])

  accountsApprovedByUserId String?
  accountsApprovedBy       User?     @relation("OrderAccountsApprovedBy", fields: [accountsApprovedByUserId], references: [id])
  accountsApprovedAt       DateTime?
  accountsNotes            String?

  purchasedByUserId String?
  purchasedBy       User?     @relation("OrderPurchasedBy", fields: [purchasedByUserId], references: [id])
  fulfilledAt       DateTime?

  /**
   * Internal stakeholders (e.g. Tech Support, HR) who should have visibility into this order for installation/demo/delivery coordination — notified when added.
   */
  watchers User[] @relation("OrderWatchers")

  allocations      PaymentAllocation[]
  tickets          Ticket[]
  expenses         OrderExpense[]
  documentLines    TradeDocumentLine[]
  creditDecisions  CreditDecision[]
  customerMessages MarketingMessage[]  @relation("MarketingMessageOrder")

  calls            CallLog[]
  assets           Asset[]           @relation("AssetOrder")
  amcAssets        Asset[]           @relation("AssetAmc")
  feedbackRequests FeedbackRequest[] @relation("FeedbackOrder")
  projects         Project[]         @relation("ProjectOrder")

  @@index([companyId])
  @@index([locationId])
  @@index([itemId])
  @@index([vendorId])
  @@index([endDate])
  @@index([orderStatus])
  @@index([parentId])
  @@index([endCustomerId])
  // The sort column of the unfiltered Orders list, which had no index to walk.
  @@index([createdAt])
  /// "Starts on" is a Dated-on option; `createdAt` and `endDate` are already covered above.
  @@index([startDate])
  @@map("company_products")
}

/**
 * A cost line item against an order (commission, freight, installation, etc.) — subtracted from gross margin.
 */
model OrderExpense {
  id               String                  @id @default(cuid())
  companyProductId String
  companyProduct   CompanyProduct          @relation(fields: [companyProductId], references: [id], onDelete: Cascade)
  type             OrderExpenseType
  amount           Decimal                 @db.Decimal(12, 2)
  notes            String?
  /**
   * Who this expense is actually paid to — mainly used for COMMISSION, to point at a Commission Party company; optional for other expense types.
   */
  payeeCompanyId   String?
  payee            Company?                @relation("OrderExpensePayee", fields: [payeeCompanyId], references: [id])
  /**
   * Which of the payee's accounts (see `CommissionPartyAccount`) this was actually paid into — optional even when a payee is set, since not every commission party has multiple accounts on file.
   */
  payeeAccountId   String?
  payeeAccount     CommissionPartyAccount? @relation(fields: [payeeAccountId], references: [id])
  createdAt        DateTime                @default(now())

  @@index([companyProductId])
  @@index([payeeCompanyId])
  @@index([payeeAccountId])
  @@map("order_expenses")
}

enum PaymentDirection {
  /**
   * Money in — a customer paying us.
   */
  RECEIVED
  /**
   * Money out — us paying a vendor.
   */
  PAID
}

model Payment {
  id         String           @id @default(cuid())
  /**
   * Stable identity for exports and reconciliation.
   * Without it the only key is (account, date, amount, reference) — and `reference` is nullable,
   * so for a cash receipt with no reference the key has a null component and silently drops out of
   * every reconciliation query rather than failing loudly. Matches orderSeq, itemSeq, ticketSeq.
   */
  paymentSeq Int              @unique @default(autoincrement())
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /**
   * Everything before payables existed was money in, which is why this defaults to RECEIVED.
   */
  direction  PaymentDirection @default(RECEIVED)
  amount     Decimal          @db.Decimal(12, 2)
  paidOn     DateTime
  method     PaymentMethod
  reference  String?
  notes      String?

  /**
   * Which bank it went through. Null for cash, and null on everything recorded before more than one
   * bank account existed — those still post to the default bank account.
   */
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  /**
   * When the cheque actually cleared. A cheque is money promised, not money moved: until this is
   * set the amount sits in cheques-in-hand rather than in the bank, which is the difference between
   * a book balance that reconciles and one that never does.
   */
  clearedOn     DateTime?

  /**
   * What the payer actually paid in, and the rate used to bring it into rupees. The ledger is always
   * in rupees; these two are what let a foreign receipt be recorded honestly.
   */
  currency         String   @default("INR")
  exchangeRate     Decimal  @default(1) @db.Decimal(14, 6)
  recordedByUserId String
  recordedBy       User     @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id])
  createdAt        DateTime @default(now())

  allocations PaymentAllocation[]

  journalEntries JournalEntry[] @relation("PaymentJournal")

  @@index([companyId])
  @@index([bankAccountId])
  /// Every Payments report windows on this. See the note on Ticket.
  @@index([paidOn])
  @@map("payments")
}

/**
 * Where a payment went. Originally an order-only ledger; an allocation can now point at a tax
 * invoice instead, which is the unit the accounting side settles against. Exactly one of
 * `companyProductId` / `documentId` is set — enforced in `allocatePayment`, since a row that
 * settled both an order and an invoice would be counted twice.
 */
model PaymentAllocation {
  id                String          @id @default(cuid())
  paymentId         String
  payment           Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  companyProductId  String?
  companyProduct    CompanyProduct? @relation(fields: [companyProductId], references: [id], onDelete: Cascade)
  /**
   * The invoice this payment settles.
   */
  documentId        String?
  document          TradeDocument?  @relation("InvoicePayment", fields: [documentId], references: [id], onDelete: Cascade)
  amount            Decimal         @db.Decimal(12, 2)
  allocatedByUserId String
  allocatedBy       User            @relation("PaymentAllocatedBy", fields: [allocatedByUserId], references: [id])
  createdAt         DateTime        @default(now())

  @@index([paymentId])
  @@index([companyProductId])
  @@index([documentId])
  @@map("payment_allocations")
}

/**
 * A credit note offsetting an invoice. Separate from a payment because no money moved — the
 * customer owes less, rather than having paid more — and one credit note can be spread across
 * several invoices, or left unapplied until there's something to set it against.
 */
model CreditNoteApplication {
  id              String        @id @default(cuid())
  creditNoteId    String
  creditNote      TradeDocument @relation("CreditNoteApplied", fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         TradeDocument @relation("InvoiceCredited", fields: [invoiceId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(14, 2)
  appliedByUserId String
  appliedBy       User          @relation("CreditNoteAppliedBy", fields: [appliedByUserId], references: [id])
  createdAt       DateTime      @default(now())

  @@unique([creditNoteId, invoiceId])
  @@index([creditNoteId])
  @@index([invoiceId])
  @@map("credit_note_applications")
}

model StockMovement {
  id              String            @id @default(cuid())
  itemId          String
  item            Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type            StockMovementType
  quantityChange  Int
  reason          String?
  createdByUserId String
  createdBy       User              @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime          @default(now())

  @@index([itemId])
  @@map("stock_movements")
}

model Ticket {
  id               String          @id @default(cuid())
  ticketSeq        Int             @unique @default(autoincrement())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId        String?
  contact          Contact?        @relation(fields: [contactId], references: [id])
  companyProductId String?
  companyProduct   CompanyProduct? @relation(fields: [companyProductId], references: [id])
  /**
   * The specific machine this is about, where it is about one. "This laptop has failed three times"
   * is a question nobody can answer without it.
   */
  assetId          String?
  asset            Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  ticketType       TicketType      @default(PRODUCT_SUPPORT)
  status           TicketStatus    @default(OPEN)
  priority         TicketPriority  @default(MEDIUM)
  assignedToUserId String?
  assignedTo       User?           @relation("TicketAssignedTo", fields: [assignedToUserId], references: [id])
  createdByUserId  String
  createdBy        User            @relation("TicketCreatedBy", fields: [createdByUserId], references: [id])
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  comments TicketComment[]
  tasks    Task[]

  calls            CallLog[]
  assetMovements   AssetMovement[]   @relation("AssetMovementTicket")
  feedbackRequests FeedbackRequest[] @relation("FeedbackTicket")
  stickyNotes      StickyNote[]      @relation("StickyNoteTicket")

  @@index([companyId])
  @@index([status])
  @@index([assignedToUserId])
  @@index([companyProductId])
  /**
   * The columns a report can put a date window on.
   * The Reports page bounds its query on whichever "Dated on" field is chosen, so each of those
   * columns is a range scan on every report, every filter-panel open, every export and every
   * printed sheet — the largest read in the application, run repeatedly. Without a leading index
   * each one is a sequential scan of the whole table.
   * Free at this size and invisible until it is not: at a few hundred rows the planner picks a seq
   * scan anyway and the timing says nothing, so this is the kind of thing that is only ever noticed
   * once somebody is already waiting.
   * A composite index does not substitute. `visits` had `(status, scheduledFor)` and
   * `trade_documents` had `(direction, issueDate)`, and neither can serve a plain window on the
   * second key — which is why the count of missing ones came out higher than a reading of the
   * schema suggested.
   */
  @@index([createdAt])
  @@index([resolvedAt])
  @@map("tickets")
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_comments")
}

model Task {
  id               String    @id @default(cuid())
  title            String
  description      String?
  dueDate          DateTime?
  done             Boolean   @default(false)
  doneAt           DateTime?
  assignedToUserId String?
  assignedTo       User?     @relation("TaskAssignee", fields: [assignedToUserId], references: [id])
  createdByUserId  String
  createdBy        User      @relation("TaskCreator", fields: [createdByUserId], references: [id])
  companyId        String?
  company          Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId           String?
  lead             Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ticketId         String?
  ticket           Ticket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /**
   * Set when this task was raised by a promised callback.
   */
  callFollowUp     CallLog?  @relation("CallFollowUpTask")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workbookAssignment WorkbookAssignee? @relation("WorkbookAssignmentTask")

  /**
   * Set when this task is part of somebody joining or leaving, so the checklist can find its own
   * tasks again rather than matching on the title.
   */
  aboutUserId String?
  aboutUser   User?    @relation("TaskAboutUser", fields: [aboutUserId], references: [id], onDelete: Cascade)
  hrStage     HrStage?

  projectId String?
  project   Project? @relation("TaskProject", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([assignedToUserId])
  @@index([companyId])
  @@index([leadId])
  @@index([ticketId])
  @@index([dueDate])
  @@index([aboutUserId, hrStage])
  @@map("tasks")
}

/**
 * What one person wants to be told about, and how.
 * A row per type per person, written **only when it differs from the default** — which is on for
 * everything. That way a notification type added next year reaches everybody without a migration
 * backfilling forty thousand rows of "yes please", and the table stays the size of the opinions
 * people have actually expressed.
 */
model NotificationPreference {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType

  /**
   * The bell. Off means the notification is never created at all — see `notifyUser`.
   */
  inApp Boolean @default(true)
  /**
   * Email. Stored and honoured at the call site, but nothing sends yet — `sendEmailNotification`
   * is still a stub, so this is a preference waiting for a transport rather than one in effect.
   */
  email Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@map("notification_preferences")
}

/**
 * In-app notifications. `dedupeKey` is set only for lazily-reconciled system alerts (a task going
 * overdue, a ticket breaching SLA, a renewal entering its expiry window) so the same alert isn't
 * created twice — Postgres treats NULLs as distinct, so plain event-triggered notifications (no
 * dedupeKey) are never deduped against each other.
 */
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String?
  link      String?
  read      Boolean          @default(false)
  readAt    DateTime?
  dedupeKey String?
  createdAt DateTime         @default(now())

  /**
   * Cleared from the list without being destroyed.
   * Separate from `read` because they answer different questions: read is "I have seen this", and
   * archived is "I am done with it". Somebody working through a backlog marks things read as they
   * scan and archives what they have actually dealt with, and collapsing the two would lose the
   * distinction the moment anybody used the bell.
   */
  archivedAt DateTime?

  @@unique([userId, dedupeKey])
  @@index([userId, read])
  @@index([userId, archivedAt, createdAt])
  @@map("notifications")
}

/**
 * A lightweight record-level audit trail — who created or edited which record, when. Not every
 * mutation in the app writes one (see docs/ROADMAP.md known gaps for exactly which do); it covers
 * the record types staff actually work with day to day (companies, contacts, leads, orders,
 * tickets, tasks, payments), which is what user-performance reporting needs.
 */
model AuditLog {
  id                   String      @id @default(cuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  action               AuditAction
  entityType           String
  entityId             String
  entityLabel          String
  /**
   * Set when an admin was viewing as `userId` at the time — see src/lib/impersonation.ts.
   * The row keeps naming the account the change was made in, because that is what the data now
   * says happened; this records who was actually at the keyboard. Without it, "view as" would be a
   * way to make changes that the audit log attributes to someone who was at lunch.
   */
  impersonatedByUserId String?
  impersonatedBy       User?       @relation("AuditImpersonatedBy", fields: [impersonatedByUserId], references: [id])
  createdAt            DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([impersonatedByUserId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/**
 * One row per user per calendar day, accumulating active seconds from client heartbeats (see
 * src/components/layout/heartbeat-tracker.tsx) — a rough "time spent on the CRM" measure, not a
 * precise timesheet. `date` is UTC-midnight-truncated so it behaves as a plain calendar day.
 */
model UserDailyActivity {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  activeSeconds   Int      @default(0)
  lastHeartbeatAt DateTime

  @@unique([userId, date])
  @@index([userId])
  @@map("user_daily_activity")
}

/**
 * Why a salesperson went out — drives reporting on where field time actually goes.
 */
enum VisitPurpose {
  INTRO_MEETING
  REQUIREMENT_GATHERING
  PRODUCT_DEMO
  PROPOSAL_DISCUSSION
  NEGOTIATION
  ORDER_COLLECTION
  PAYMENT_FOLLOW_UP
  SUPPORT_ESCALATION
  RELATIONSHIP_BUILDING
  DELIVERY_INSTALLATION
  OTHER
}

enum VisitStatus {
  PLANNED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

/**
 * A field visit to a client office. Planned first, then checked in/out on the day, then written up
 * — so the list doubles as tomorrow's schedule and last week's record. Expenses attach to the visit
 * rather than living loose, which is what makes "what did this account cost us to win" answerable.
 */
model Visit {
  id         String           @id @default(cuid())
  visitSeq   Int              @unique @default(autoincrement())
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?         @relation(fields: [contactId], references: [id])
  /**
   * The deal this visit was for, when it was about one.
   */
  leadId     String?
  lead       Lead?            @relation(fields: [leadId], references: [id])
  locationId String?
  location   CompanyLocation? @relation(fields: [locationId], references: [id])

  purpose      VisitPurpose @default(INTRO_MEETING)
  status       VisitStatus  @default(PLANNED)
  /**
   * Free text when `purpose` is OTHER, and the agenda in every other case.
   */
  agenda       String?
  scheduledFor DateTime
  checkInAt    DateTime?
  checkOutAt   DateTime?
  /**
   * Where they actually went, defaulted from the company location but editable.
   */
  address      String?
  /**
   * What came of it — the part that makes a visit log worth keeping.
   */
  outcome      String?
  /**
   * Distance claimed for mileage, in km; the expense itself is a separate row.
   */
  distanceKm   Decimal?     @db.Decimal(8, 2)

  userId String
  user   User   @relation("VisitBy", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses         Expense[]
  assetMovements   AssetMovement[]
  feedbackRequests FeedbackRequest[] @relation("FeedbackVisit")

  @@index([companyId])
  @@index([userId, scheduledFor])
  @@index([status, scheduledFor])
  /// Both Dated-on options. The composites above lead on status and userId, not on the date.
  @@index([scheduledFor])
  @@index([checkInAt])
  @@map("visits")
}

enum ExpenseCategory {
  TRAVEL
  FUEL
  MILEAGE
  TOLL_PARKING
  ACCOMMODATION
  MEALS
  CLIENT_ENTERTAINMENT
  COURIER
  PHONE_INTERNET
  OFFICE_SUPPLIES
  SOFTWARE_SUBSCRIPTION
  MARKETING
  TRAINING
  REPAIRS_MAINTENANCE
  PROFESSIONAL_FEES
  OTHER
}

enum ExpensePaymentMode {
  CASH
  PERSONAL_CARD
  COMPANY_CARD
  UPI
  BANK_TRANSFER
}

/**
 * Where a claim is in the manager's queue. DRAFT is the claimant's own scratch space — nothing is
 * in anyone's queue until it's SUBMITTED. REIMBURSED is deliberately separate from APPROVED: a
 * manager saying yes and accounts actually paying it out are different events on different days.
 */
enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
}

/**
 * A company expense. Most are incurred by a person and reimbursed (a salesperson's travel to a
 * client), but the model also covers spend that isn't reimbursable — a company-card software
 * subscription — so the Expenses module is the whole picture rather than just travel claims.
 * Distinct from `OrderExpense`, which is cost-of-sale attached to one order (commission, freight,
 * installation) and belongs to that order's margin rather than to anyone's claim.
 */
model Expense {
  id           String             @id @default(cuid())
  expenseSeq   Int                @unique @default(autoincrement())
  category     ExpenseCategory    @default(TRAVEL)
  amount       Decimal            @db.Decimal(12, 2)
  /**
   * Tax paid on the expense, tracked separately where an input credit can be claimed.
   */
  taxAmount    Decimal?           @db.Decimal(12, 2)
  spentOn      DateTime
  description  String
  paymentMode  ExpensePaymentMode @default(CASH)
  /**
   * False for company-card / direct-debit spend that nobody is owed for. Keeps the "what do we owe
   * our staff" figure honest, which a flat expense total can't answer.
   */
  reimbursable Boolean            @default(true)

  /**
   * What it was for — any, all, or none of these.
   */
  visitId   String?
  visit     Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation("ExpenseCompany", fields: [companyId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  /**
   * Bill/receipt image as a data URL, same reasoning as the branding and signature images.
   */
  receiptDataUrl String?
  receiptName    String?

  status ExpenseStatus @default(DRAFT)
  /**
   * Who is out of pocket (or who spent the company's money).
   */
  userId String
  user   User          @relation("ExpenseBy", fields: [userId], references: [id])

  submittedAt      DateTime?
  /**
   * Snapshotted when submitted, so a later reporting-line change can't move a claim mid-review.
   */
  approverUserId   String?
  approver         User?     @relation("ExpenseApprover", fields: [approverUserId], references: [id])
  decidedAt        DateTime?
  decisionNote     String?
  reimbursedAt     DateTime?
  reimbursementRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalEntries JournalEntry[] @relation("ExpenseJournal")

  @@index([userId, status])
  @@index([approverUserId, status])
  @@index([status, spentOn])
  @@index([visitId])
  @@index([companyId])
  @@map("expenses")
}

// ─── General ledger ───────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/**
 * A ledger account. Arranged as a tree — a group like "Current Assets" holds the postable accounts
 * under it — because a chart of accounts is read as a hierarchy on every report.
 * `systemKey` is how the posting engine finds the account it needs without hard-coding a code or a
 * name: a business will rename "Sales — Software" or renumber its codes, and neither should stop an
 * invoice from posting. Accounts carrying one can't be deleted.
 */
model LedgerAccount {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  type        AccountType
  /**
   * Null for a top-level group.
   */
  parentId    String?
  parent      LedgerAccount?  @relation("AccountTree", fields: [parentId], references: [id])
  children    LedgerAccount[] @relation("AccountTree")
  /**
   * A group exists to organise its children; only postable accounts take journal lines.
   */
  isGroup     Boolean         @default(false)
  /**
   * What the posting engine looks this account up by, e.g. "AR", "OUTPUT_CGST".
   */
  systemKey   String?         @unique
  active      Boolean         @default(true)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines JournalLine[]

  bankAccount       BankAccount?
  assetsHeld        FixedAsset[] @relation("AssetCostAccount")
  assetsDepreciated FixedAsset[] @relation("AssetDepreciationAccount")

  @@index([type])
  @@index([parentId])
  @@map("ledger_accounts")
}

enum JournalSource {
  /**
   * Posted automatically when a document was issued.
   */
  INVOICE
  CREDIT_NOTE
  BILL
  PAYMENT
  EXPENSE
  /**
   * Hand-written by an accountant.
   */
  MANUAL
  /**
   * The balances the books opened with.
   */
  OPENING
  /**
   * A month's payroll: wages and the employer's own contributions against what is owed to staff
   * and to the statutory authorities.
   */
  PAYROLL
  DEPRECIATION
  /**
   * The year-end entry that moves the profit into retained earnings and zeroes the P&L.
   */
  CLOSING
  /**
   * The gain or loss from settling a foreign-currency document at a different rate.
   */
  FX
}

/**
 * One balanced double-entry transaction. Debits equal credits across its lines — enforced in the
 * action rather than the database, because Postgres can't express a cross-row sum constraint.
 * Entries are never edited or deleted once posted. A mistake is corrected by a reversal that points
 * back at the original, so the audit trail stays intact — which is the whole reason for a ledger.
 */
model JournalEntry {
  id          String        @id @default(cuid())
  entryNumber String        @unique
  date        DateTime
  narration   String
  source      JournalSource

  /**
   * What this was posted from, for the document that generated it and to stop double-posting.
   */
  documentId   String?
  document     TradeDocument? @relation("DocumentJournal", fields: [documentId], references: [id])
  paymentId    String?
  payment      Payment?       @relation("PaymentJournal", fields: [paymentId], references: [id])
  expenseId    String?
  expense      Expense?       @relation("ExpenseJournal", fields: [expenseId], references: [id])
  payrollRunId String?
  payrollRun   PayrollRun?    @relation("PayrollJournal", fields: [payrollRunId], references: [id])
  /**
   * The party this entry concerns, for the subsidiary-ledger views.
   */
  companyId    String?
  company      Company?       @relation("CompanyJournal", fields: [companyId], references: [id])

  /**
   * Set when this entry reverses another, and on the original once it has been reversed.
   */
  reversesId String?       @unique
  reverses   JournalEntry? @relation("JournalReversal", fields: [reversesId], references: [id])
  reversedBy JournalEntry? @relation("JournalReversal")

  createdById String
  createdBy   User     @relation("JournalCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  lines JournalLine[]

  /**
   * The one-to-one back-references from the things that raise a single entry each.
   */
  fiscalYearClose    FiscalYearClose?    @relation("FiscalYearClosingEntry")
  depreciationCharge DepreciationCharge? @relation("DepreciationEntry")
  assetDisposal      FixedAsset?         @relation("AssetDisposalEntry")

  @@index([date])
  @@index([source])
  @@index([payrollRunId])
  @@index([companyId])
  @@index([documentId])
  @@map("journal_entries")
}

/**
 * One side of a transaction. A line carries either a debit or a credit, never both.
 * `companyId` is the sub-ledger party — on a receivable or payable line it's who owes or is owed,
 * which is what lets one AR control account break down per customer.
 */
model JournalLine {
  id           String        @id @default(cuid())
  entryId      String
  entry        JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId    String
  account      LedgerAccount @relation(fields: [accountId], references: [id])
  debit        Decimal       @default(0) @db.Decimal(14, 2)
  credit       Decimal       @default(0) @db.Decimal(14, 2)
  companyId    String?
  company      Company?      @relation("JournalLineParty", fields: [companyId], references: [id])
  /**
   * The cost centre. Carried from the claimant's or employee's team so a P&L can be read per
   * department without a second set of accounts per team.
   */
  departmentId String?
  department   Department?   @relation("JournalLineCostCentre", fields: [departmentId], references: [id], onDelete: SetNull)
  narration    String?
  sortOrder    Int           @default(0)

  /**
   * Set when this line has been agreed against the bank statement. Only bank lines ever carry it.
   */
  reconciledAt  DateTime?
  statementLine BankStatementLine? @relation("StatementMatch")

  @@index([entryId])
  @@index([accountId])
  @@index([companyId])
  @@index([departmentId])
  @@index([accountId, reconciledAt])
  @@map("journal_lines")
}

// ─── Calling ──────────────────────────────────────────────────────────────────

enum CallDirection {
  OUTBOUND
  INBOUND
}

/**
 * How a call ended. Deliberately more than "connected or not": a calling team's day is judged on
 * what it produced, and "wrong number" and "not interested" mean very different things for whether
 * the record should be called again.
 */
enum CallOutcome {
  CONNECTED
  NO_ANSWER
  BUSY
  SWITCHED_OFF
  WRONG_NUMBER
  LEFT_VOICEMAIL
  CALLBACK_REQUESTED
  NOT_INTERESTED
}

/**
 * One logged call.
 * Always against a company, because that is the thing every other record hangs off — but optionally
 * also against the lead, ticket or subscription it was about, so a call placed while working a
 * renewal shows up on that renewal and not just somewhere in the company's history.
 */
model CallLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /**
   * Null when someone rang a number that isn't on file as a contact.
   */
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /**
   * What the call was about. At most one of these is set, by wherever the call was placed from.
   */
  leadId           String?
  lead             Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  ticketId         String?
  ticket           Ticket?         @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  companyProductId String?
  companyProduct   CompanyProduct? @relation(fields: [companyProductId], references: [id], onDelete: SetNull)

  /**
   * Kept as dialled rather than as a contact reference — the number can change on the contact later.
   */
  phoneNumber     String
  direction       CallDirection @default(OUTBOUND)
  outcome         CallOutcome
  startedAt       DateTime
  /**
   * 0 for a call that never connected, which is different from unknown.
   */
  durationSeconds Int           @default(0)
  notes           String?

  /**
   * When the caller said they would ring back. Cleared by marking it done, not by deleting it.
   */
  followUpAt     DateTime?
  followUpDone   Boolean   @default(false)
  /**
   * The task raised for that callback. One-to-one, and the link is what keeps the two in step:
   * closing either side closes the other, so a caller can work from Tasks or from Calls and never
   * has to remember to tick the same thing twice.
   */
  followUpTaskId String?   @unique
  followUpTask   Task?     @relation("CallFollowUpTask", fields: [followUpTaskId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation("CallLoggedBy", fields: [userId], references: [id])

  createdAt DateTime @default(now())

  workbookRecord WorkbookRecord?

  @@index([companyId, startedAt])
  @@index([userId, startedAt])
  @@index([followUpAt, followUpDone])
  @@index([leadId])
  @@index([ticketId])
  @@index([contactId])
  @@map("call_logs")
}

// ─── Domain intelligence ──────────────────────────────────────────────────────

/**
 * What public DNS and a company's own website say about them.
 * Every field here is either read from public DNS or from the homepage they serve to anyone — the
 * same things a salesperson would look up by hand before a call, gathered in one place. Nothing is
 * inferred about a person, and nothing is fetched until someone asks for it: the lookups are slow
 * and hit third parties, so they run on demand and the answer is cached until refreshed.
 * One profile per company, keyed on the domain taken from their website.
 */
model DomainProfile {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /**
   * The registrable domain, e.g. "acme.co.in" — what every lookup below is keyed on.
   */
  domain String

  /**
   * Where the site actually resolved to, after redirects.
   */
  finalUrl        String?
  httpStatus      Int?
  /**
   * The homepage's own title and meta description — the two-or-three-liner about the business.
   */
  siteTitle       String?
  siteDescription String?

  /**
   * WordPress, Shopify, Wix, custom… and what gave it away.
   */
  platform         String?
  platformEvidence String?

  /**
   * Who serves the site, and the signal it was read from (headers, CNAME, IP).
   */
  hostProvider String?
  hostEvidence String?
  ipAddress    String?

  /**
   * Mail exchangers in preference order, and the provider inferred from them.
   */
  mxHosts               String[]
  emailProvider         String?
  /**
   * A gateway in front of the mailbox provider — Mimecast, Proofpoint, Barracuda.
   */
  emailSecurityProvider String?

  nsHosts     String[]
  dnsProvider String?

  registrar    String?
  registeredOn DateTime?
  expiresOn    DateTime?

  /**
   * Anti-spoofing posture. A domain with no DMARC can be impersonated, which is a sales opening.
   */
  spfRecord   String?
  dmarcRecord String?
  /**
   * none | quarantine | reject, as published. Null when there's no DMARC at all.
   */
  dmarcPolicy String?
  dkimFound   Boolean @default(false)

  /**
   * Rendered by an external thumbnail service from `finalUrl`; no image is stored here.
   */
  screenshotUrl String?

  /**
   * When the lookup last ran, and what went wrong if it did.
   */
  fetchedAt DateTime?
  error     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([domain])
  @@index([platform])
  @@index([emailProvider])
  @@map("domain_profiles")
}

// ─── Workspace ────────────────────────────────────────────────────────────────

/**
 * A saved list: a set of filters over companies, named and kept.
 * The filters are stored, not the results — so a workbook called "Maharashtra, no order in 90 days"
 * still means that next month rather than freezing whoever matched on the day it was made. That's
 * what makes it useful for lead gen and account management; a snapshot would go stale immediately.
 * `filters` is JSON because the useful filters change as the business does, and a migration per
 * filter means nobody ever adds one.
 */
model Workbook {
  id          String  @id @default(cuid())
  name        String
  description String?
  /**
   * A `WorkbookFilters` object — see src/lib/workspace/filters.ts.
   */
  filters     Json

  ownerUserId String
  owner       User    @relation("WorkbookOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  /**
   * Visible to everyone rather than just its owner. Lists are usually worked by a team.
   */
  shared      Boolean @default(true)

  /**
   * A saved segment, or a campaign whose rows have been frozen and shared out.
   */
  mode             WorkbookMode           @default(LIST)
  /**
   * When the whole activity is meant to be finished.
   */
  dueAt            DateTime?
  /**
   * When the rows were frozen — null while it's still a live segment.
   */
  startedAt        DateTime?
  allocationMethod CallerAllocationMethod @default(ROUND_ROBIN)

  /**
   * Set when someone pins it to their own sidebar of lists.
   */
  lastOpenedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignees WorkbookAssignee[]
  records   WorkbookRecord[]

  @@index([ownerUserId])
  @@index([shared])
  @@map("workbooks")
}

/**
 * Who is working a list.
 * A join table rather than an array of ids on the workbook, because a calling list is routinely
 * split across several people and "which lists am I on" has to be a real query — an array column
 * can't be indexed for that usefully, and can hold ids of users who no longer exist.
 */
model WorkbookAssignee {
  workbookId String
  workbook   Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("WorkbookAssignedTo", fields: [userId], references: [id], onDelete: Cascade)

  assignedByUserId String
  assignedBy       User      @relation("WorkbookAssignedBy", fields: [assignedByUserId], references: [id])
  assignedAt       DateTime  @default(now())
  /**
   * What this person specifically is meant to do with it, when it differs from the list's own note.
   */
  note             String?
  /**
   * When this person's share is due, which can differ from the activity's own deadline.
   */
  dueAt            DateTime?
  /**
   * The task raised so the work shows up where they already look.
   */
  taskId           String?   @unique
  task             Task?     @relation("WorkbookAssignmentTask", fields: [taskId], references: [id], onDelete: SetNull)
  completedAt      DateTime?

  @@id([workbookId, userId])
  @@index([userId])
  @@map("workbook_assignees")
}

// ─── Calling activities ───────────────────────────────────────────────────────

enum WorkbookMode {
  /**
   * A saved segment you browse and work from.
   */
  LIST
  /**
   * A campaign: the matches are frozen into records, shared out, and worked through.
   */
  COLD_CALLING
}

enum CallerAllocationMethod {
  /**
   * One each in turn — the fairest split when callers are interchangeable.
   */
  ROUND_ROBIN
  /**
   * Contiguous blocks, so one caller works a whole alphabetical stretch.
   */
  BLOCKS
  /**
   * To whoever already owns the account, falling back to round robin for the unowned.
   */
  BY_ACCOUNT_OWNER
}

enum WorkbookRecordStatus {
  PENDING
  /**
   * Opened by a caller and not yet finished — what "in the middle of a call" looks like.
   */
  IN_PROGRESS
  DONE
  /**
   * Deliberately passed over, with a reason.
   */
  SKIPPED
}

/**
 * One company inside a calling activity.
 * A saved list is a live segment — its rows change as the data does — which is right for browsing
 * and useless for a campaign: you can't hand out work, track progress or measure a caller against a
 * set that reshuffles underneath them. Starting an activity therefore *freezes* the current matches
 * into these rows, and everything after that is about them.
 */
model WorkbookRecord {
  id         String   @id @default(cuid())
  workbookId String
  workbook   Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assignedToUserId String?
  assignedTo       User?                @relation("WorkbookRecordCaller", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  status           WorkbookRecordStatus @default(PENDING)

  /**
   * Position in the caller's queue, so everyone works their list in a stable order.
   */
  sortOrder Int @default(0)

  /**
   * When the caller put this record on screen, and when they finished with it.
   */
  openedAt      DateTime?
  completedAt   DateTime?
  /**
   * Seconds between opening and finishing this record — how long it took to work, including the
   * call itself and writing the outcome down.
   */
  handleSeconds Int?
  /**
   * Seconds between finishing the previous record and opening this one. The idle time between
   * calls, which is the figure that actually explains a slow day.
   */
  gapSeconds    Int?

  outcomeNote String?
  callId      String?  @unique
  call        CallLog? @relation(fields: [callId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verifications ContactVerification[]

  @@unique([workbookId, companyId])
  @@index([workbookId, assignedToUserId, status])
  @@index([assignedToUserId, status])
  @@map("workbook_records")
}

/**
 * How far an email address has been stood up. See src/lib/email-verification.ts.
 */
enum EmailCheckStatus {
  /**
   * Nobody has looked yet.
   */
  UNCHECKED
  /**
   * Well-formed, and its domain accepts mail. The mailbox itself is still unproven.
   */
  VALID
  /**
   * Deliverable, but it is a shared inbox or a personal mailbox rather than a person at work.
   */
  RISKY
  /**
   * Malformed, disposable, or at a domain that cannot receive mail at all.
   */
  INVALID
}

enum EmailCheckMethod {
  /**
   * Syntax and DNS, run by the app.
   */
  AUTOMATIC
  /**
   * A person reached the human behind it — the only way a mailbox is ever really proven.
   */
  CONFIRMED
  /**
   * A person reported it wrong.
   */
  REPORTED
}

enum VerifiedField {
  EMAIL
  PHONE
}

enum VerificationStatus {
  /**
   * The value on file is right.
   */
  CORRECT
  /**
   * Wrong, and the caller couldn't get the right one.
   */
  WRONG
  /**
   * Wrong, and the caller has the correct value — held here, not written to the contact.
   */
  CORRECTED
}

/**
 * What a caller found out about a contact's email or phone.
 * Deliberately never writes to the contact. A caller correcting a number on the phone is a claim,
 * not a fact — they mishear, they reach the wrong person, they fix a number that was right for a
 * different branch. Both values are kept with who said what and when, and pushing a correction onto
 * the contact is a separate, deliberate act with its own audit line.
 */
model ContactVerification {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /**
   * The calling record it came from, when it came from a campaign.
   */
  recordId  String?
  record    WorkbookRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  field          VerifiedField
  /**
   * What was on file when the caller looked at it — kept even after the contact changes.
   */
  originalValue  String
  status         VerificationStatus
  /**
   * Only set for CORRECTED.
   */
  correctedValue String?
  note           String?

  verifiedByUserId String
  verifiedBy       User     @relation("ContactVerifiedBy", fields: [verifiedByUserId], references: [id])
  verifiedAt       DateTime @default(now())

  /**
   * Set once someone accepts the correction onto the contact record.
   */
  appliedAt       DateTime?
  appliedByUserId String?
  appliedBy       User?     @relation("ContactVerificationAppliedBy", fields: [appliedByUserId], references: [id])

  @@index([companyId])
  @@index([contactId])
  @@index([status, appliedAt])
  @@map("contact_verifications")
}

// ─── People (HRMS) ────────────────────────────────────────────────────────────

/**
 * The employment side of a person, kept beside `User` rather than inside it.
 * `User` is a login: it answers "who is signed in and what may they do". This answers "who do we
 * employ, since when, on what terms" — a different lifecycle with a different audience. Keeping them
 * apart means a contractor who needs the CRM has a login with no HR record, an employee who never
 * signs in still has one, and the payroll fields are not sitting in the object every request loads.
 */
model EmployeeProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("UserEmployeeProfile", fields: [userId], references: [id], onDelete: Cascade)

  employeeCode String? @unique
  /**
   * The enrolment number this person has on the biometric terminals.
   * Unique, and deliberately separate from `employeeCode`: the terminals number people in their
   * own sequence, set by whoever enrolled the finger, and the two agree only by luck.
   */
  biometricId  String? @unique

  designation      String?
  employmentType   EmploymentType @default(FULL_TIME)
  workLocation     String?
  /**
   * Days of notice this person owes on resignation. Drives the shortfall recovery in a settlement.
   */
  noticePeriodDays Int            @default(30)
  joinedOn         DateTime?      @db.Date
  probationEndsOn  DateTime?      @db.Date
  confirmedOn      DateTime?      @db.Date
  exitedOn         DateTime?      @db.Date
  exitType         ExitType?
  exitReason       String?

  dateOfBirth   DateTime? @db.Date
  gender        Gender?
  bloodGroup    String?
  maritalStatus String?
  personalEmail String?
  personalPhone String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pincode      String?

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  panNumber    String?
  /**
   * The last four digits only, never the whole number.
   * A full Aadhaar is enough to impersonate somebody and storing one brings obligations under the
   * Aadhaar Act that this business has no reason to take on. Four digits are all anyone here needs
   * to confirm they are looking at the right record.
   */
  aadhaarLast4 String?
  uanNumber    String?
  pfNumber     String?
  esicNumber   String?

  bankName          String?
  bankAccountNumber String?
  bankIfsc          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employmentType])
  @@map("employee_profiles")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
}

enum ExitType {
  RESIGNED
  TERMINATED
  RETIRED
  CONTRACT_ENDED
  ABSCONDED
}

enum Gender {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

/**
 * A non-working day for the whole company.
 * `optional` covers India's restricted-holiday convention: a published list from which each
 * employee may take a limited number, rather than a day the office is shut.
 */
model Holiday {
  id       String   @id @default(cuid())
  name     String
  date     DateTime @db.Date
  optional Boolean  @default(false)
  note     String?

  createdAt DateTime @default(now())

  @@unique([date, name])
  @@index([date])
  @@map("holidays")
}

model LeaveType {
  id   String @id @default(cuid())
  /**
   * CL, SL, EL… — short enough to head a column.
   */
  code String @unique
  name String

  /**
   * Days a full year grants.
   */
  annualQuota     Decimal      @db.Decimal(5, 2)
  accrual         LeaveAccrual @default(ANNUAL)
  /**
   * Whether unused days survive into next year, and how many at most. Earned leave usually carries;
   * casual and sick leave usually lapse.
   */
  carryForward    Boolean      @default(false)
  maxCarryForward Decimal?     @db.Decimal(5, 2)
  /**
   * Unpaid leave still needs a type so it can be applied for and counted — it just costs a day's pay.
   */
  paid            Boolean      @default(true)
  /**
   * Whether an unused balance is paid out when somebody leaves.
   * Earned leave usually is; casual and sick leave usually are not, and paying out the wrong one is
   * money that does not come back. Off by default, so it is a decision rather than an accident.
   */
  encashable      Boolean      @default(false)
  /**
   * Sick leave beyond a couple of days usually needs a certificate.
   */
  proofAfterDays  Int?
  colour          String?
  active          Boolean      @default(true)
  sortOrder       Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@map("leave_types")
}

enum LeaveAccrual {
  /**
   * The whole quota on day one of the year.
   */
  ANNUAL
  /**
   * A twelfth each month, which is how earned leave usually works.
   */
  MONTHLY
}

/**
 * One employee's entitlement of one leave type for one year.
 * Stored rather than derived because the inputs change under you: quotas are edited, people join
 * mid-year, and last year's carry-forward is a decision somebody made once. A balance nobody can
 * reproduce a year later is a balance nobody can defend in an argument about pay.
 */
model LeaveBalance {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation("UserLeaveBalances", fields: [userId], references: [id], onDelete: Cascade)
  typeId String
  type   LeaveType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  year   Int

  /**
   * Carried in from last year.
   */
  opening        Decimal @default(0) @db.Decimal(5, 2)
  /**
   * Granted this year so far — the whole quota, or the accrued part of it.
   */
  credited       Decimal @default(0) @db.Decimal(5, 2)
  /**
   * Taken, from approved requests only.
   */
  used           Decimal @default(0) @db.Decimal(5, 2)
  /**
   * Manual correction, with the reason beside it.
   */
  adjustment     Decimal @default(0) @db.Decimal(5, 2)
  adjustmentNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, typeId, year])
  @@index([userId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  typeId String
  type   LeaveType @relation(fields: [typeId], references: [id])

  fromDate    DateTime @db.Date
  toDate      DateTime @db.Date
  /**
   * A half day at either end — the common "leaving after lunch" case.
   */
  fromHalfDay Boolean  @default(false)
  toHalfDay   Boolean  @default(false)
  /**
   * Working days requested, holidays and week-offs already removed. Stored so a later change to the holiday list cannot silently restate a settled request.
   */
  days        Decimal  @db.Decimal(5, 2)
  reason      String

  status       LeaveStatus @default(PENDING)
  approverId   String?
  approver     User?       @relation("LeaveApprover", fields: [approverId], references: [id])
  decidedAt    DateTime?
  decisionNote String?
  /**
   * Set when the employee withdraws it themselves.
   */
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, fromDate])
  @@index([status])
  @@index([approverId, status])
  @@map("leave_requests")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/**
 * One person, one day.
 * A row exists only once something is known about the day — somebody clocked in, took leave, or an
 * admin marked it. Days with no row are simply "not recorded", which is honest: absence of evidence
 * is not evidence of absence, and pre-creating a year of ABSENT rows would make it look like one.
 */
model AttendanceDay {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation("UserAttendance", fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  status        AttendanceStatus
  checkInAt     DateTime?
  checkOutAt    DateTime?
  /**
   * Derived from the stamps when both exist; kept so a report does not recompute a million times.
   */
  workedMinutes Int?
  note          String?

  /**
   * Points at the leave that put them here, when the day is leave.
   */
  leaveRequestId String?

  /**
   * An admin or manager corrected this day, and who.
   */
  regularisedById String?
  regularisedBy   User?     @relation("AttendanceRegularisedBy", fields: [regularisedById], references: [id])
  regularisedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([userId, date])
  @@map("attendance_days")
}

enum AttendanceStatus {
  PRESENT
  WORK_FROM_HOME
  HALF_DAY
  ON_LEAVE
  ABSENT
  WEEK_OFF
  HOLIDAY
}

/**
 * What someone is paid, from a given date.
 * Kept as a dated series rather than a single current figure: a payslip for March must be
 * reproducible after an April raise, and "what were they on last year" is a question that gets
 * asked. Nothing is ever edited in place — a change is a new row with a later `effectiveFrom`.
 */
model SalaryStructure {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserSalaryStructures", fields: [userId], references: [id], onDelete: Cascade)

  effectiveFrom DateTime @db.Date

  /**
   * Monthly components, in rupees. CTC is derived, not typed, so the two cannot disagree.
   */
  basic            Decimal @db.Decimal(12, 2)
  hra              Decimal @default(0) @db.Decimal(12, 2)
  conveyance       Decimal @default(0) @db.Decimal(12, 2)
  medical          Decimal @default(0) @db.Decimal(12, 2)
  specialAllowance Decimal @default(0) @db.Decimal(12, 2)
  otherAllowance   Decimal @default(0) @db.Decimal(12, 2)

  /**
   * Off by default for a consultant, or someone whose PF sits with a previous employer.
   */
  pfApplicable  Boolean @default(true)
  esiApplicable Boolean @default(true)
  ptApplicable  Boolean @default(true)

  note String?

  createdById String?
  createdBy   User?    @relation("SalaryStructureCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([userId, effectiveFrom])
  @@map("salary_structures")
}

model PayrollRun {
  id    String @id @default(cuid())
  month Int
  year  Int

  status PayrollRunStatus @default(DRAFT)
  note   String?

  /**
   * Frozen when the run is locked — after that the payslips are a record, not a calculation.
   */
  lockedAt   DateTime?
  lockedById String?
  lockedBy   User?     @relation("PayrollLockedBy", fields: [lockedById], references: [id])
  paidAt     DateTime?

  createdById String?
  createdBy   User?    @relation("PayrollCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payslips Payslip[]

  journalEntries JournalEntry[] @relation("PayrollJournal")

  @@unique([month, year])
  @@map("payroll_runs")
}

enum PayrollRunStatus {
  DRAFT
  LOCKED
  PAID
}

/**
 * One person's pay for one month, stored as figures rather than as a formula.
 * Every component is written down — including the ones that could be recomputed — because a payslip
 * is a statement made to an employee and to the tax authorities on a particular day. Recomputing it
 * later from a structure that has since changed would quietly produce a different document with the
 * same number on it.
 */
model Payslip {
  id     String     @id @default(cuid())
  runId  String
  run    PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId String
  user   User       @relation("UserPayslips", fields: [userId], references: [id], onDelete: Cascade)

  /**
   * Days in the month, days actually payable, and the unpaid ones that reduced the pay.
   */
  monthDays Decimal @db.Decimal(5, 2)
  paidDays  Decimal @db.Decimal(5, 2)
  lopDays   Decimal @default(0) @db.Decimal(5, 2)

  basic            Decimal @db.Decimal(12, 2)
  hra              Decimal @default(0) @db.Decimal(12, 2)
  conveyance       Decimal @default(0) @db.Decimal(12, 2)
  medical          Decimal @default(0) @db.Decimal(12, 2)
  specialAllowance Decimal @default(0) @db.Decimal(12, 2)
  otherAllowance   Decimal @default(0) @db.Decimal(12, 2)
  /**
   * Performance pay, earned by result rather than by attendance — so unlike every component above
   * it, loss of pay does not reduce it. Somebody who was off for three days and still hit their
   * number earned the whole thing.
   */
  incentive        Decimal @default(0) @db.Decimal(12, 2)
  grossEarnings    Decimal @db.Decimal(12, 2)

  pfEmployee         Decimal @default(0) @db.Decimal(12, 2)
  pfEmployer         Decimal @default(0) @db.Decimal(12, 2)
  esiEmployee        Decimal @default(0) @db.Decimal(12, 2)
  esiEmployer        Decimal @default(0) @db.Decimal(12, 2)
  professionalTax    Decimal @default(0) @db.Decimal(12, 2)
  /**
   * Entered, not computed — see src/lib/hr/payroll.ts on why income tax is not guessed here.
   */
  incomeTax          Decimal @default(0) @db.Decimal(12, 2)
  otherDeduction     Decimal @default(0) @db.Decimal(12, 2)
  otherDeductionNote String?

  totalDeductions Decimal @db.Decimal(12, 2)
  netPay          Decimal @db.Decimal(12, 2)
  /**
   * What the employment costs the company this month, gross plus the employer's own contributions.
   */
  employerCost    Decimal @db.Decimal(12, 2)

  note String?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  incentiveEarnings IncentiveEarning[]

  @@unique([runId, userId])
  @@index([userId])
  @@map("payslips")
}

// ─── Biometric attendance (eSSL / ZKTeco) ─────────────────────────────────────

/**
 * A fingerprint or face terminal on the office network.
 * eSSL terminals are ZKTeco devices under the badge, and they speak the ADMS "iclock" protocol:
 * the device opens the connection and POSTs its logs to a server address configured on the keypad.
 * That direction matters — it is the only arrangement that works when the terminal sits behind the
 * office router and the ERP does not, and it is why there is no polling code anywhere here.
 * A device identifies itself by serial number and nothing else. The protocol carries no
 * authentication at all, so a serial has to be registered here before anything it sends is
 * believed — see src/app/api/biometric/iclock/[[...path]]/route.ts.
 */
model BiometricDevice {
  id           String  @id @default(cuid())
  /**
   * What the device sends as `SN=` on every request. The only thing identifying it.
   */
  serialNumber String  @unique
  name         String
  location     String?

  /**
   * Terminals send local wall-clock time with no zone attached, so the zone is a property of where
   * the box is bolted to the wall rather than of the data.
   */
  timezone String @default("Asia/Kolkata")

  /**
   * An unticked device is refused, which is how a stolen or decommissioned terminal is cut off.
   */
  active Boolean @default(true)

  deviceModel     String?
  firmware        String?
  lastSeenAt      DateTime?
  lastPunchAt     DateTime?
  /**
   * Cumulative, for the "is this thing actually working" column.
   */
  punchesReceived Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  punches BiometricPunch[]

  @@map("biometric_devices")
}

/**
 * One punch, exactly as the terminal reported it.
 * Kept raw and forever, separate from `AttendanceDay`, for two reasons. Terminals re-send their
 * whole buffer after a reboot or a re-sync, so the same punch arrives many times and the unique
 * constraint below is what makes that harmless. And when somebody disputes a day, the answer is
 * "here is what the machine recorded at 09:14:22", not a rolled-up figure that has since been
 * recomputed twice.
 */
model BiometricPunch {
  id       String          @id @default(cuid())
  deviceId String
  device   BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /**
   * The enrolment number on the terminal — NOT a user id here. Unmapped numbers are kept anyway,
   * so that enrolling somebody and mapping them later recovers the punches already collected.
   */
  deviceUserId String
  punchedAt    DateTime

  /**
   * As the terminal reports it: 0 in, 1 out, 2 break out, 3 break in, 4 OT in, 5 OT out.
   */
  punchType  Int?
  /**
   * 1 fingerprint, 3 password, 4 card, 15 face — kept for disputes about how somebody clocked in.
   */
  verifyMode Int?
  /**
   * The line as received, so a parsing change can be re-run against what actually arrived.
   */
  raw        String

  userId String?
  user   User?   @relation("UserBiometricPunches", fields: [userId], references: [id], onDelete: SetNull)

  /**
   * Set once this punch has been folded into an AttendanceDay.
   */
  processedAt DateTime?

  createdAt DateTime @default(now())

  /**
   * The same person cannot punch the same terminal twice in the same second, so this is what makes
   * a device re-sending its buffer a no-op rather than a duplicate day.
   */
  @@unique([deviceId, deviceUserId, punchedAt])
  @@index([userId, punchedAt])
  @@index([processedAt])
  @@index([deviceUserId])
  @@map("biometric_punches")
}

/**
 * An employee asking for a day of their own attendance to be corrected.
 * The gap this fills: attendance can only be changed by HR or a manager, which is right — it feeds
 * loss of pay, and self-service editing of it would be self-service editing of your own salary. But
 * that left an employee who forgot to punch out with no way even to *ask*. This is the ask; the
 * decision stays exactly where it was.
 * Approving one writes the day and stamps `regularisedAt` on it, which is also what stops a
 * terminal re-sending its buffer from quietly undoing the correction.
 */
model AttendanceRegularisation {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation("UserRegularisations", fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  /**
   * What the employee says the day should have been.
   */
  requestedStatus   AttendanceStatus
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  reason            String

  /**
   * Deliberately the same states as a leave request — it is the same shape of decision.
   */
  status       LeaveStatus @default(PENDING)
  approverId   String?
  approver     User?       @relation("RegularisationApprover", fields: [approverId], references: [id])
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([status])
  @@index([approverId, status])
  @@map("attendance_regularisations")
}

// ─── Employee documents, history and letters ──────────────────────────────────

/**
 * A file on somebody's employment file: their CV, a PAN copy, a degree certificate, the signed
 * offer letter they sent back.
 * Stored as a data URL in the row, the same as expense receipts and the org signature already are.
 * That is the wrong answer above a few megabytes and the right answer for an app with no object
 * store to configure — so uploads are capped, and this is the first thing to move if the file list
 * ever grows teeth.
 * `visibleToEmployee` exists because not everything on a personnel file is for the person it
 * describes. Their own CV and offer letter are; an interview scorecard or a disciplinary note is
 * not, and an HRMS that cannot express that forces HR to keep a second filing cabinet.
 */
model EmployeeDocument {
  id     String  @id @default(cuid())
  /**
   * Exactly one of `userId` or `candidateId` is set.
   * A CV arrives before there is an employee to attach it to, and re-uploading it on day one would
   * lose the fact that it was what we hired on. On conversion the candidate's documents are moved
   * across rather than copied.
   */
  userId String?
  user   User?   @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)

  candidateId String?
  candidate   Candidate? @relation("CandidateDocuments", fields: [candidateId], references: [id], onDelete: Cascade)

  type EmployeeDocumentType @default(OTHER)
  name String
  note String?

  /**
   * The file itself, base64 in a data URL.
   */
  fileDataUrl String
  mimeType    String
  sizeBytes   Int

  /**
   * False for anything HR keeps about somebody rather than for them.
   */
  visibleToEmployee Boolean @default(true)

  /**
   * Set when this file was produced by the letter generator rather than uploaded.
   */
  letterId String?         @unique
  letter   EmployeeLetter? @relation(fields: [letterId], references: [id], onDelete: SetNull)

  uploadedById String?
  uploadedBy   User?    @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([userId, type])
  @@index([candidateId])
  @@map("employee_documents")
}

enum EmployeeDocumentType {
  CV
  PHOTO
  PAN_CARD
  AADHAAR
  EDUCATION
  EXPERIENCE_CERTIFICATE
  RELIEVING_LETTER
  PAYSLIP_PREVIOUS
  BANK_PROOF
  OFFER_LETTER
  APPOINTMENT_LETTER
  CONTRACT
  /**
   * Kept from the employee — appraisals, interview notes, warnings.
   */
  INTERNAL
  OTHER
}

/**
 * Where somebody worked before here.
 * Worth its own table rather than a text blob: "how many years of experience does this person have"
 * and "have we actually verified their last employer" are both questions HR is asked, and neither
 * can be answered from a paragraph.
 */
model EmploymentHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserEmploymentHistory", fields: [userId], references: [id], onDelete: Cascade)

  companyName      String
  designation      String?
  location         String?
  fromDate         DateTime? @db.Date
  toDate           DateTime? @db.Date
  /**
   * Annual, as stated by the candidate — which is why `verifiedAt` exists below.
   */
  lastDrawnCtc     Decimal?  @db.Decimal(12, 2)
  reasonForLeaving String?
  /**
   * Who to ring, if they gave one.
   */
  referenceName    String?
  referenceContact String?
  note             String?

  /**
   * Background verification: claimed until somebody checks, then recorded as checked and by whom.
   */
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("EmploymentVerifiedBy", fields: [verifiedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("employment_history")
}

/**
 * A letter the company has issued: an offer, an appointment, a confirmation, an experience letter.
 * `payload` is the whole point. A letter is a statement made on a particular day — an offer at a
 * particular salary, an experience letter covering particular dates — and re-rendering it later
 * from live data would silently produce a *different* document under the same reference number
 * after the next appraisal. So everything the letter asserts is frozen into the row at issue, and
 * the printed page reads from that, never from the employee record.
 */
model EmployeeLetter {
  id     String  @id @default(cuid())
  /**
   * Exactly one of `userId` or `candidateId` is set — an offer letter precedes the employee.
   */
  userId String?
  user   User?   @relation("UserLetters", fields: [userId], references: [id], onDelete: Cascade)

  candidateId String?
  candidate   Candidate? @relation("CandidateLetters", fields: [candidateId], references: [id], onDelete: Cascade)

  type         LetterType
  /**
   * Human-facing reference, e.g. WRF/OFR/2026/014. Unique because it is quoted back at you.
   */
  letterNumber String     @unique
  subject      String
  issuedOn     DateTime   @db.Date

  /**
   * Everything the letter asserts, frozen. See the note above.
   */
  payload Json
  /**
   * The rendered body, editable before issue so wording can be adjusted per person.
   */
  body    String

  status LetterStatus @default(DRAFT)

  issuedById String?
  issuedBy   User?    @relation("LetterIssuedBy", fields: [issuedById], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document EmployeeDocument?

  @@index([userId, type])
  @@index([candidateId])
  @@map("employee_letters")
}

enum LetterType {
  // Joining
  OFFER
  APPOINTMENT
  INTERNSHIP
  CONTRACT_AGREEMENT
  // While employed
  CONFIRMATION
  PROBATION_EXTENSION
  INCREMENT
  PROMOTION
  TRANSFER
  WARNING
  APPRECIATION
  MATERNITY_LEAVE
  // Asked for by a third party
  SALARY_CERTIFICATE
  ADDRESS_PROOF
  TRAVEL_NOC
  EMPLOYMENT_VERIFICATION
  // Leaving
  RESIGNATION_ACCEPTANCE
  TERMINATION
  NO_DUES
  RELIEVING
  EXPERIENCE
  INTERNSHIP_COMPLETION
  GRATUITY_STATEMENT
}

enum LetterStatus {
  DRAFT
  ISSUED
  /**
   * Withdrawn after issue — kept, because the number was already quoted to somebody.
   */
  REVOKED
}

/**
 * The money side of somebody leaving.
 * Deliberately a stored calculation rather than a letter, for the same reason payslips are: it is a
 * statement about money made on a particular day, it gets disputed, and it has to be reproducible
 * after the leave balances and salary structures it drew on have moved on. Every component is
 * written down, including the ones that could be recomputed.
 * `netPayable` can be negative. Somebody who leaves without serving notice, or with an outstanding
 * advance, may owe the company — and a settlement that cannot express that is one that quietly
 * writes off the debt.
 */
model FinalSettlement {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("UserSettlement", fields: [userId], references: [id], onDelete: Cascade)

  lastWorkingDay DateTime @db.Date
  /**
   * Completed years of service, as the Gratuity Act counts them — over six months rounds up.
   */
  serviceYears   Decimal  @db.Decimal(5, 2)

  // ── Earnings ──

  /**
   * Days of the final month actually worked, and what they come to.
   */
  salaryDays   Decimal @db.Decimal(5, 2)
  salaryAmount Decimal @default(0) @db.Decimal(12, 2)

  leaveEncashDays   Decimal @default(0) @db.Decimal(5, 2)
  leaveEncashAmount Decimal @default(0) @db.Decimal(12, 2)

  gratuityAmount Decimal @default(0) @db.Decimal(12, 2)
  /**
   * Why gratuity is or is not payable, in words — the first thing anybody queries.
   */
  gratuityNote   String?

  bonusAmount       Decimal @default(0) @db.Decimal(12, 2)
  otherEarnings     Decimal @default(0) @db.Decimal(12, 2)
  otherEarningsNote String?

  grossPayable Decimal @default(0) @db.Decimal(12, 2)

  // ── Deductions ──

  /**
   * Notice they owed but did not serve, and what that costs.
   */
  noticeShortfallDays Decimal @default(0) @db.Decimal(5, 2)
  noticeRecovery      Decimal @default(0) @db.Decimal(12, 2)

  pfDeduction        Decimal @default(0) @db.Decimal(12, 2)
  professionalTax    Decimal @default(0) @db.Decimal(12, 2)
  incomeTax          Decimal @default(0) @db.Decimal(12, 2)
  advanceRecovery    Decimal @default(0) @db.Decimal(12, 2)
  assetRecovery      Decimal @default(0) @db.Decimal(12, 2)
  otherDeduction     Decimal @default(0) @db.Decimal(12, 2)
  otherDeductionNote String?

  totalDeductions Decimal @default(0) @db.Decimal(12, 2)
  /**
   * Negative when the employee owes the company.
   */
  netPayable      Decimal @default(0) @db.Decimal(12, 2)

  status SettlementStatus @default(DRAFT)
  note   String?

  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("SettlementApprovedBy", fields: [approvedById], references: [id])
  paidAt       DateTime?

  createdById String?
  createdBy   User?    @relation("SettlementCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("final_settlements")
}

enum SettlementStatus {
  DRAFT
  APPROVED
  PAID
}

// ─── Hiring & onboarding ──────────────────────────────────────────────────────

/**
 * Somebody being hired, before they are somebody who works here.
 * This model exists because the alternative is worse. Without it, drafting an offer letter means
 * first creating a `User` — a real login, with a password, for a person who has not accepted a job
 * and may never join. Every ERP that skips this step ends up with a directory full of accounts for
 * people who declined, and an access review that nobody can answer.
 * A candidate becomes a `User` at exactly one moment: when they are converted on joining. Until
 * then they can be offered a job, send back their details, and have documents on file, with no
 * credentials anywhere.
 */
model Candidate {
  id    String  @id @default(cuid())
  name  String
  email String
  phone String?

  designation    String?
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id])
  employmentType EmploymentType @default(FULL_TIME)
  workLocation   String?
  /**
   * Who they will report to once they join.
   */
  managerId      String?
  manager        User?          @relation("CandidateManager", fields: [managerId], references: [id])
  /**
   * The role their login will get on conversion — decided at offer, not on day one.
   */
  role           String         @default("SALES")
  roleRef        Role           @relation(fields: [role], references: [key])

  status          CandidateStatus @default(PROSPECT)
  source          String?
  offeredCtc      Decimal?        @db.Decimal(12, 2)
  expectedJoining DateTime?       @db.Date
  offeredOn       DateTime?       @db.Date
  acceptedOn      DateTime?       @db.Date
  declinedReason  String?
  notes           String?

  /**
   * The one-time link the candidate uses to send us their own details.
   * Unguessable and single-purpose: it authenticates nothing except "whoever holds this may fill in
   * this one form". It is cleared the moment the form is submitted or the candidate converts, so a
   * link forwarded to the wrong person is worthless the day after it is used.
   */
  intakeToken       String?   @unique
  intakeExpiresAt   DateTime?
  intakeSubmittedAt DateTime?
  /**
   * What the candidate typed, held here rather than written onto anything.
   * Self-reported data is a claim until HR has looked at it, and a form that writes straight into
   * the employee record is a form that lets an outsider edit your HR database.
   */
  intakeData        Json?

  /**
   * Set once converted — the employee this candidate became.
   */
  convertedUserId String?   @unique
  convertedUser   User?     @relation("CandidateConverted", fields: [convertedUserId], references: [id])
  convertedAt     DateTime?

  ownerId   String?
  owner     User?    @relation("CandidateOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents EmployeeDocument[] @relation("CandidateDocuments")
  letters   EmployeeLetter[]   @relation("CandidateLetters")

  @@index([status])
  @@index([email])
  @@map("candidates")
}

enum CandidateStatus {
  /**
   * In the pipeline, no offer yet.
   */
  PROSPECT
  OFFERED
  ACCEPTED
  DECLINED
  /**
   * Converted into an employee.
   */
  JOINED
  WITHDRAWN
}

enum HrStage {
  ONBOARDING
  OFFBOARDING
}

/**
 * The occasions worth interrupting somebody's screen for.
 * Birthdays, anniversaries and holidays are *derived* — they are already on the employee record and
 * the holiday calendar, and asking HR to re-enter them would guarantee the two drift apart. Only
 * the things nobody can compute are stored as rows: an achievement, a festival greeting somebody
 * wrote, a welcome for a new joiner.
 */
enum CelebrationKind {
  /**
   * Something a person or team did — a big win, a certification, a milestone.
   */
  ACHIEVEMENT
  /**
   * Diwali, Holi, New Year — a greeting written for the occasion.
   */
  FESTIVAL
  /**
   * A company milestone: a funding round, an anniversary, a target hit.
   */
  MILESTONE
  /**
   * Somebody has joined.
   */
  WELCOME
  /**
   * Anything else worth putting on everyone's screen.
   */
  ANNOUNCEMENT
}

enum CelebrationAudience {
  EVERYONE
  DEPARTMENT
  /**
   * One person — used for a note only they should see.
   */
  PERSON
}

model Celebration {
  id            String              @id @default(cuid())
  kind          CelebrationKind
  audience      CelebrationAudience @default(EVERYONE)
  title         String
  message       String?
  /**
   * An image shown on the splash. A data URL, like every other upload in this app.
   */
  imageDataUrl  String?
  /**
   * Hex tint for the splash, so Diwali and a sales record do not look identical.
   */
  accent        String?
  /**
   * Who it is about, when it is about somebody in particular — their photo and name are shown.
   */
  subjectUserId String?
  subject       User?               @relation("CelebrationSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  /**
   * The window it shows in. A one-day occasion has the same date in both.
   */
  startsOn DateTime @db.Date
  endsOn   DateTime @db.Date
  active   Boolean  @default(true)

  /**
   * Null when the app wrote it itself — a sales win celebrated as it happened.
   */
  createdById String?
  createdBy   User?    @relation("CelebrationAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /**
   * Written by a person, or raised by a sale — see src/lib/wins. The sales ones are one per occasion:
   * `occasionKey` ("deal:<leadId>", "target:<targetId>") is unique, so a win is celebrated once
   * however many times the detector runs.
   */
  source      CelebrationSource @default(MANUAL)
  occasionKey String?           @unique
  /**
   * Who gets the full-screen splash. EVERYONE for a win meant to motivate the room; SUBJECT for one
   * that is the winner's moment, which everybody else sees in the greeting strip instead.
   */
  splashFor   SplashScope       @default(EVERYONE)
  /**
   * The figure behind it — a deal's value, what was booked — for the wins wall.
   */
  amount      Decimal?          @db.Decimal(14, 2)
  /**
   * Anything else the wins wall shows: a top performer's runners-up, a target's metric and number.
   */
  details     Json?

  @@index([active, startsOn, endsOn])
  @@index([source, createdAt])
  @@map("celebrations")
}

/**
 * That a particular person has seen a particular occasion.
 * Keyed by an opaque string rather than a foreign key, because most occasions have no row to point
 * at — `birthday:<userId>:2026` is computed from the employee record. Storing the dismissal server
 * side rather than in the browser means the greeting does not reappear on the person's phone after
 * they closed it on their laptop.
 */
model CelebrationSeen {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  occasionKey String
  seenAt      DateTime @default(now())

  @@unique([userId, occasionKey])
  @@index([userId])
  @@map("celebration_seen")
}

// ─── Books control ────────────────────────────────────────────────────────────

/**
 * How far the books are closed.
 * A singleton, because "the books are locked to 31 March" is one fact about the company rather than
 * a property of any account. Nothing before this date can be posted, reversed or corrected — which
 * is the point: a trial balance handed to an auditor last month must still be the same trial
 * balance today, and without a lock any admin can silently change it by back-dating a journal.
 */
model LedgerLock {
  id          String    @id @default("global")
  lockedUntil DateTime? @db.Date
  note        String?
  updatedById String?
  updatedBy   User?     @relation("LedgerLockBy", fields: [updatedById], references: [id])
  updatedAt   DateTime  @updatedAt

  @@map("ledger_locks")
}

/**
 * A financial year that has been closed off.
 * Closing writes one entry that moves the year's profit into retained earnings and zeroes every
 * income and expense account, which is what lets the next year start from nil while the balance
 * sheet carries forward. It is recorded rather than merely done, so the balance sheet can show
 * prior years' reserves separately from this year's profit — and so reopening is a deliberate act
 * with a name against it.
 */
model FiscalYearClose {
  id        String   @id @default(cuid())
  /**
   * The Indian financial year, e.g. "2025-26".
   */
  label     String   @unique
  fromDate  DateTime @db.Date
  toDate    DateTime @db.Date
  netProfit Decimal  @db.Decimal(14, 2)

  closingEntryId String?       @unique
  closingEntry   JournalEntry? @relation("FiscalYearClosingEntry", fields: [closingEntryId], references: [id])

  closedById String
  closedBy   User     @relation("FiscalYearClosedBy", fields: [closedById], references: [id])
  closedAt   DateTime @default(now())

  @@map("fiscal_year_closes")
}

// ─── Banking ──────────────────────────────────────────────────────────────────

/**
 * One real bank account, with its own ledger account behind it.
 * A single "Bank" account in the chart cannot answer "how much is in the current account", which is
 * the question anybody actually asks. Each bank account here owns a postable ledger account, so the
 * trial balance shows them separately and each one reconciles against its own statement.
 */
model BankAccount {
  id            String  @id @default(cuid())
  name          String
  bankName      String?
  accountNumber String?
  ifsc          String?
  branch        String?

  ledgerAccountId String        @unique
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id])

  /**
   * Where a payment goes when nobody chose an account — and where everything recorded before this
   * model existed is taken to have gone.
   */
  isDefault Boolean @default(false)
  active    Boolean @default(true)

  createdById String?
  createdBy   User?    @relation("BankAccountCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments        Payment[]
  statementLines  BankStatementLine[]
  reconciliations BankReconciliation[]

  @@map("bank_accounts")
}

/**
 * One row off a bank statement.
 * Imported rather than typed, and matched to a journal line rather than posted from — the statement
 * is the bank's record and the ledger is ours, and reconciliation is the act of agreeing the two.
 * Importing the same statement twice is a real hazard, so each row carries a fingerprint of what was
 * imported and the pair is unique.
 */
model BankStatementLine {
  id            String      @id @default(cuid())
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date
  narration String
  reference String?
  /**
   * Signed: positive is money into the account.
   */
  amount    Decimal  @db.Decimal(14, 2)

  matchedLineId String?      @unique
  matchedLine   JournalLine? @relation("StatementMatch", fields: [matchedLineId], references: [id], onDelete: SetNull)
  matchedAt     DateTime?
  matchedById   String?
  matchedBy     User?        @relation("StatementMatchedBy", fields: [matchedById], references: [id])

  /**
   * Of the row as it arrived, so re-importing an overlapping statement is a no-op.
   */
  fingerprint String
  importedAt  DateTime @default(now())

  @@unique([bankAccountId, fingerprint])
  @@index([bankAccountId, date])
  @@map("bank_statement_lines")
}

/**
 * A reconciliation somebody signed off: at this date, the statement said this and the books said
 * that. Kept because the useful question later is not "does it reconcile now" but "when did it last
 * reconcile, and by how much was it out".
 */
model BankReconciliation {
  id            String      @id @default(cuid())
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  statementDate    DateTime @db.Date
  statementBalance Decimal  @db.Decimal(14, 2)
  bookBalance      Decimal  @db.Decimal(14, 2)
  difference       Decimal  @db.Decimal(14, 2)
  note             String?

  completedById String
  completedBy   User     @relation("ReconciledBy", fields: [completedById], references: [id])
  completedAt   DateTime @default(now())

  @@unique([bankAccountId, statementDate])
  @@map("bank_reconciliations")
}

// ─── Fixed assets ─────────────────────────────────────────────────────────────

enum DepreciationMethod {
  /**
   * The same amount every year over the asset's life — how the Companies Act schedule is usually
   * applied.
   */
  STRAIGHT_LINE
  /**
   * A fixed percentage of what is left — how the Income Tax Act blocks work.
   */
  WRITTEN_DOWN_VALUE
}

/**
 * Something the company owns and writes down over time.
 * Kept as its own register rather than as journal entries alone, because the entries can tell you
 * the accumulated depreciation but not which laptop it belongs to, when it was bought, or whether
 * it has been sold — and that is what an asset register is for.
 */
model FixedAsset {
  id          String  @id @default(cuid())
  tag         String  @unique
  name        String
  description String?

  purchasedOn     DateTime           @db.Date
  cost            Decimal            @db.Decimal(14, 2)
  /**
   * What it is expected to be worth at the end of its life; depreciation stops here.
   */
  salvageValue    Decimal            @default(0) @db.Decimal(14, 2)
  usefulLifeYears Int                @default(3)
  method          DepreciationMethod @default(STRAIGHT_LINE)
  /**
   * Only for the written-down-value method; straight line derives its rate from the life.
   */
  ratePercent     Decimal?           @db.Decimal(5, 2)

  /**
   * Where the cost sits, and where the accumulated depreciation is built up against it.
   */
  assetAccountId       String
  assetAccount         LedgerAccount  @relation("AssetCostAccount", fields: [assetAccountId], references: [id])
  accumulatedAccountId String?
  accumulatedAccount   LedgerAccount? @relation("AssetDepreciationAccount", fields: [accumulatedAccountId], references: [id])

  vendorCompanyId String?
  vendorCompany   Company?    @relation("AssetVendor", fields: [vendorCompanyId], references: [id], onDelete: SetNull)
  departmentId    String?
  department      Department? @relation("AssetCostCentre", fields: [departmentId], references: [id], onDelete: SetNull)
  /**
   * Who is using it — an asset register that cannot say who has the laptop is half a register.
   */
  custodianUserId String?
  custodian       User?       @relation("AssetCustodian", fields: [custodianUserId], references: [id], onDelete: SetNull)

  disposedOn       DateTime?     @db.Date
  disposalProceeds Decimal?      @db.Decimal(14, 2)
  disposalNote     String?
  disposalEntryId  String?       @unique
  disposalEntry    JournalEntry? @relation("AssetDisposalEntry", fields: [disposalEntryId], references: [id])

  createdById String
  createdBy   User     @relation("AssetCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  charges DepreciationCharge[]
  asset   Asset?

  @@index([disposedOn])
  @@index([departmentId])
  @@map("fixed_assets")
}

/**
 * One period's depreciation on one asset.
 * Unique per asset and period end, so running the depreciation for a month twice cannot charge it
 * twice — the same guard the document posting uses, for the same reason.
 */
model DepreciationCharge {
  id      String     @id @default(cuid())
  assetId String
  asset   FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  fromDate DateTime @db.Date
  toDate   DateTime @db.Date
  amount   Decimal  @db.Decimal(14, 2)

  entryId String?       @unique
  entry   JournalEntry? @relation("DepreciationEntry", fields: [entryId], references: [id])

  createdById String
  createdBy   User     @relation("DepreciationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([assetId, toDate])
  @@index([toDate])
  @@map("depreciation_charges")
}

// ─── IT asset management ──────────────────────────────────────────────────────

enum AssetKind {
  LAPTOP
  DESKTOP
  SERVER
  MONITOR
  PRINTER
  NETWORK
  PHONE
  TABLET
  PERIPHERAL
  /**
   * A licence is an asset too — it is bought, it expires, and somebody is using it.
   */
  SOFTWARE_LICENCE
  OTHER
}

/**
 * Whose machine it is.
 * The most consequential field in this module, because it decides whether the thing may appear on
 * our balance sheet at all. A client's laptop that we service is an asset we *manage*, not one we
 * *own* — capitalising it would claim property that isn't ours.
 */
enum AssetOwnership {
  /**
   * Ours, used by us.
   */
  INTERNAL
  /**
   * Ours, sitting at a client — rented, leased or on loan. Still our balance sheet.
   */
  DEPLOYED
  /**
   * The client's. Never our balance sheet, whatever else we do for it.
   */
  CLIENT_OWNED
}

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  IN_TRANSIT
  INSTALLED
  UNDER_REPAIR
  RETIRED
  /**
   * Unaccounted for. Kept distinct from RETIRED: one is a decision, the other is a problem.
   */
  LOST
}

/**
 * One physical event in an asset's life.
 * Movements are an append-only log rather than a status field, because the useful questions are
 * historical — where has this been, and who had it when it broke. A status alone answers neither.
 */
enum AssetMovementType {
  RECEIVED
  ASSIGNED
  DISPATCHED
  DELIVERED
  INSTALLED
  RETURNED
  SENT_FOR_REPAIR
  BACK_FROM_REPAIR
  TRANSFERRED
  SCRAPPED
  LOST
}

/**
 * How the goods are travelling. The portal wants this as a number; we store the word.
 */
enum TransportMode {
  ROAD
  RAIL
  AIR
  SHIP
}

/**
 * Regular, or over-dimensional cargo.
 * Not cosmetic: ODC gets **one day of validity per 20 km** against a regular vehicle's 200, so
 * getting it wrong makes a bill that expires ten times too early or ten times too late. The second
 * is the expensive one — an expired e-way bill in a roadside check is a penalty.
 */
enum VehicleType {
  REGULAR
  OVER_DIMENSIONAL_CARGO
}

/**
 * Where a consignment stands with the e-way bill portal.
 * `NOT_REQUIRED` is a conclusion, not an absence: it means somebody worked out that this movement
 * is under the threshold or exempt. `REQUIRED` means it needs one and has not got one — which is
 * the state worth a red badge, because it is a lorry that should not have left.
 */
enum EwayBillStatus {
  NOT_REQUIRED
  REQUIRED
  GENERATED
  CANCELLED
  FAILED
}

enum ConsignmentStatus {
  DRAFT
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

/**
 * Why goods are moving — which also decides what paperwork travels with them.
 * A sale moves against an invoice. Everything else moves against a delivery challan, because no
 * supply is taking place: sending a laptop for repair is not selling it, and raising an invoice for
 * it would book revenue that does not exist.
 */
enum ConsignmentReason {
  SALE_DELIVERY
  DEPLOYMENT
  REPAIR_OUT
  REPAIR_RETURN
  RETURN_TO_VENDOR
  INTERNAL_TRANSFER
  COLLECTION
}

/**
 * One physical thing, tracked individually.
 * Deliberately separate from `FixedAsset`, which is the *financial* record — what something cost and
 * what it is worth now. This is the *operational* one: its serial number, who is holding it, where it
 * physically sits, when the warranty runs out. They overlap for a capitalised laptop and diverge
 * everywhere else: a cheap monitor is expensed but still needs tracking, a licence is an asset with
 * no physical form, and a client's machine must never reach the financial register at all.
 * `Item` remains the catalogue SKU this is an instance of. Where a SKU is serialised, these rows are
 * the truth about how many exist and where they are — `Item.stockQuantity` cannot answer either.
 */
model Asset {
  id           String      @id @default(cuid())
  /**
   * What is stuck on the machine. Ours, and unique across everything we track.
   */
  assetTag     String      @unique
  /**
   * The manufacturer's. Unique where present, because two machines sharing one is always a mistake.
   */
  serialNumber String?     @unique
  name         String
  kind         AssetKind   @default(LAPTOP)
  status       AssetStatus @default(IN_STOCK)

  make          String?
  model         String?
  specification String?

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  // ── Who owns it ────────────────────────────────────────────────────────────
  ownership      AssetOwnership @default(INTERNAL)
  /**
   * Set only for CLIENT_OWNED. Null means it is ours.
   */
  ownerCompanyId String?
  ownerCompany   Company?       @relation("AssetOwner", fields: [ownerCompanyId], references: [id], onDelete: Cascade)

  /**
   * The financial record, where one exists. Null for anything expensed rather than capitalised, and
   * necessarily null for a client's asset — the action refuses to link one.
   */
  fixedAssetId String?     @unique
  fixedAsset   FixedAsset? @relation(fields: [fixedAssetId], references: [id], onDelete: SetNull)

  // ── Where it is ────────────────────────────────────────────────────────────
  siteCompanyId String?
  siteCompany   Company?         @relation("AssetSite", fields: [siteCompanyId], references: [id], onDelete: SetNull)
  locationId    String?
  location      CompanyLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  /**
   * Our employee holding it.
   */
  custodianUserId String?
  custodian       User?    @relation("ITAssetCustodian", fields: [custodianUserId], references: [id], onDelete: SetNull)
  /**
   * The client's person holding it, for an asset out at a customer.
   */
  holderContactId String?
  holder          Contact? @relation("AssetHolder", fields: [holderContactId], references: [id], onDelete: SetNull)

  // ── Commercial ─────────────────────────────────────────────────────────────

  /**
   * The order this came from, so a machine traces back to what was sold.
   */
  companyProductId String?
  order            CompanyProduct? @relation("AssetOrder", fields: [companyProductId], references: [id], onDelete: SetNull)
  /**
   * The AMC covering it. An AMC is a subscription like any other, so it is a CompanyProduct rather
   * than a parallel contract model — which means renewals, invoicing and tickets already work on it.
   */
  amcProductId     String?
  amc              CompanyProduct? @relation("AssetAmc", fields: [amcProductId], references: [id], onDelete: SetNull)

  vendorCompanyId String?
  vendorCompany   Company? @relation("ITAssetVendor", fields: [vendorCompanyId], references: [id], onDelete: SetNull)

  purchasedOn    DateTime? @db.Date
  purchaseCost   Decimal?  @db.Decimal(14, 2)
  warrantyEndsOn DateTime? @db.Date
  /**
   * Denormalised from the AMC so an asset with a standalone contract, or none, still answers
   * "is it covered" without a join through an order that may not exist.
   */
  amcEndsOn      DateTime? @db.Date

  // ── Software ───────────────────────────────────────────────────────────────

  /**
   * Visible only to whoever may manage assets. Not a credential, but not public either.
   */
  licenceKey String?
  seats      Int?

  notes         String?
  retiredOn     DateTime? @db.Date
  retiredReason String?

  createdById String
  createdBy   User     @relation("ITAssetCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movements AssetMovement[]
  tickets   Ticket[]

  @@index([ownership, status])
  @@index([ownerCompanyId])
  @@index([siteCompanyId])
  @@index([custodianUserId])
  @@index([warrantyEndsOn])
  @@index([amcEndsOn])
  @@map("assets")
}

/**
 * Where an asset went, and who had it.
 * Append-only. Nothing here is edited once recorded — a movement that turns out to be wrong is
 * followed by the movement that corrects it, for the same reason the ledger works that way: the
 * history is the point.
 */
model AssetMovement {
  id      String            @id @default(cuid())
  assetId String
  asset   Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type    AssetMovementType

  occurredAt DateTime

  fromCompanyId  String?
  fromCompany    Company?         @relation("AssetMovementFrom", fields: [fromCompanyId], references: [id], onDelete: SetNull)
  fromLocationId String?
  fromLocation   CompanyLocation? @relation("AssetMovementFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  fromUserId     String?
  fromUser       User?            @relation("AssetMovementFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)
  /**
   * For somewhere with no record of its own — a courier hub, a vendor's service centre.
   */
  fromLabel      String?

  toCompanyId  String?
  toCompany    Company?         @relation("AssetMovementTo", fields: [toCompanyId], references: [id], onDelete: SetNull)
  toLocationId String?
  toLocation   CompanyLocation? @relation("AssetMovementToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  toUserId     String?
  toUser       User?            @relation("AssetMovementToUser", fields: [toUserId], references: [id], onDelete: SetNull)
  toContactId  String?
  toContact    Contact?         @relation("AssetMovementToContact", fields: [toContactId], references: [id], onDelete: SetNull)
  toLabel      String?

  consignmentId String?
  consignment   Consignment? @relation(fields: [consignmentId], references: [id], onDelete: SetNull)
  ticketId      String?
  ticket        Ticket?      @relation("AssetMovementTicket", fields: [ticketId], references: [id], onDelete: SetNull)
  visitId       String?
  visit         Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)

  note String?

  /**
   * That somebody at the other end confirmed they have it. An unacknowledged handover is exactly
   * the state that turns into "nobody knows where it went" six months later.
   */
  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?     @relation("AssetMovementAcknowledged", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  recordedById String
  recordedBy   User     @relation("AssetMovementRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([assetId, occurredAt])
  @@index([consignmentId])
  @@map("asset_movements")
}

/**
 * A batch of assets travelling together to one place.
 * Exists because logistics happens per delivery, not per machine: fifteen laptops to one office go
 * in one van, under one docket, with one e-way bill — and the question people ask is "where is the
 * delivery", not "where is laptop eleven".
 */
model Consignment {
  id                String            @id @default(cuid())
  consignmentNumber String            @unique
  reason            ConsignmentReason @default(SALE_DELIVERY)
  status            ConsignmentStatus @default(DRAFT)

  fromLabel String?

  toCompanyId  String?
  toCompany    Company?         @relation("ConsignmentTo", fields: [toCompanyId], references: [id], onDelete: SetNull)
  toLocationId String?
  toLocation   CompanyLocation? @relation(fields: [toLocationId], references: [id], onDelete: SetNull)
  toContactId  String?
  toContact    Contact?         @relation("ConsignmentContact", fields: [toContactId], references: [id], onDelete: SetNull)
  /**
   * Snapshotted, because where something was actually sent is a fact about that despatch — editing
   * the customer's address later must not rewrite it.
   */
  toAddress    String?

  // ── Logistics ──────────────────────────────────────────────────────────────
  courier       String?
  docketNumber  String?
  /**
   * The transporter's consignment note number, which is what an e-way bill asks for.
   */
  lrNumber      String?
  vehicleNumber String?
  dispatchedOn  DateTime?
  expectedOn    DateTime? @db.Date
  deliveredOn   DateTime?
  receivedBy    String?

  // ── Compliance ─────────────────────────────────────────────────────────────

  /**
   * What the goods are worth for the purposes of moving them. An e-way bill is required above
   * ₹50,000, whether or not anything is being sold — a repair consignment needs one too.
   */
  declaredValue      Decimal?  @db.Decimal(14, 2)
  /**
   * Whether the movement crosses a state line, which changes when a bill is needed.
   */
  interstate         Boolean   @default(false)
  ewayBillNumber     String?
  ewayBillValidUntil DateTime?
  /**
   * Whatever the portal said when it refused. Kept verbatim — a paraphrased error is not a clue.
   */

  // ── What the portal asks for and nothing else does ──────────────────────────

  /**
   * Who is carrying it. Replaces the free-text `courier`, which is kept for what is already
   * recorded — and unlike free text it carries the GSTIN or TRANSIN the e-way bill portal asks for.
   */
  transporterId String?
  transporter   Transporter?   @relation(fields: [transporterId], references: [id], onDelete: SetNull)
  /**
   * The invoice or delivery challan travelling with the goods. An e-way bill is raised against it.
   */
  documentId    String?
  document      TradeDocument? @relation("ConsignmentDocument", fields: [documentId], references: [id], onDelete: SetNull)

  notes String?

  createdById String
  createdBy   User     @relation("ConsignmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movements AssetMovement[]

  @@index([status, dispatchedOn])
  @@index([toCompanyId])
  @@map("consignments")
}

// ─── Targets ──────────────────────────────────────────────────────────────────

/**
 * What a target is measured in.
 * Deliberately more than revenue, because a target module that only counts money is useless to
 * three of the five teams here: the calling team is judged on connections, the profiling team on
 * accounts sourced, and support on tickets closed. A quota nobody in those teams can be given is a
 * quota that gets tracked in a spreadsheet instead.
 * Each of these has exactly one definition, in src/lib/targets/metrics.ts, and that definition is
 * shown on the page — because the first argument anybody has about a target is what counts.
 */
enum TargetMetric {
  /**
   * Tax invoices issued, less credit notes. What was billed, whether or not it has been paid.
   */
  INVOICED_VALUE
  /**
   * Money actually received against those invoices. The harder number, and the one that pays wages.
   */
  COLLECTED_VALUE
  ORDER_VALUE
  ORDER_MARGIN
  LEADS_CREATED
  LEADS_WON
  /**
   * The value of what was won, rather than how many.
   */
  LEAD_VALUE_WON
  CALLS_CONNECTED
  CALL_MINUTES
  VISITS_COMPLETED
  /**
   * Companies added to the directory — profiling work, whether or not they ever buy.
   */
  COMPANIES_ADDED
  CONTACTS_ADDED
  TICKETS_RESOLVED
  /**
   * Companies that bought for the first time in the period.
   * Deliberately distinct from COMPANIES_ADDED: a directory entry is research, a first order is
   * revenue. This counts the moment somebody stops being a prospect.
   */
  NEW_CUSTOMERS
  /**
   * Seats added to subscriptions already running, at what was charged for them.
   */
  ADDON_VALUE
}

enum TargetPeriod {
  MONTH
  QUARTER
  YEAR
}

/**
 * Who carries it.
 * A department target is not the sum of its people's targets — a team can be given ₹2 crore while
 * its five members carry ₹30 lakh each, and the gap is the manager's problem to solve. Storing them
 * separately is what lets both be true at once.
 */
enum TargetScope {
  USER
  DEPARTMENT
  COMPANY
}

/**
 * A number somebody has been asked to hit, over a period.
 * Only the *target* is stored. What was actually achieved is computed from the underlying records
 * every time it is read, never written down — because a stored figure stops being true the moment
 * an invoice is cancelled, a lead is reassigned or an order is voided, and nothing would say so.
 * The cost is a handful of aggregate queries; the alternative is a dashboard that is confidently
 * wrong.
 */
model Target {
  id     String       @id @default(cuid())
  metric TargetMetric
  period TargetPeriod

  /**
   * The window, held as plain dates rather than a month number, so a quarter, a financial year and
   * an odd campaign period are all the same shape — and measuring is always one range query.
   */
  fromDate DateTime @db.Date
  toDate   DateTime @db.Date
  /**
   * How the period reads to a person: "September 2026", "Q2 2026-27".
   */
  label    String

  scope        TargetScope @default(USER)
  userId       String?
  user         User?       @relation("TargetOwner", fields: [userId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  /**
   * The number to hit — rupees for the money metrics, a plain count for the rest.
   */
  value Decimal @db.Decimal(14, 2)

  note   String?
  active Boolean @default(true)

  /**
   * What hitting this is worth, where anything is. A target without one is simply a number to hit.
   */
  incentiveSchemeId String?
  incentiveScheme   IncentiveScheme? @relation(fields: [incentiveSchemeId], references: [id], onDelete: SetNull)

  createdById       String
  createdBy         User               @relation("TargetCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  incentiveEarnings IncentiveEarning[]

  @@index([userId, fromDate, toDate])
  @@index([departmentId, fromDate, toDate])
  @@index([metric, fromDate, toDate])
  @@map("targets")
}

// ─── Incentives ───────────────────────────────────────────────────────────────

/**
 * How a scheme turns an achievement into money.
 * Slabs are the shape most real schemes take — nothing below 80% of target, a rate from there to
 * 100%, a better rate above — because a flat percentage pays the same for 79% as for 0%, and a
 * cliff at 100% makes somebody at 97% on the 28th stop trying.
 */
enum IncentiveBasis {
  /**
   * A percentage of what was actually achieved.
   */
  PERCENT_OF_ACHIEVEMENT
  /**
   * A percentage of the target, paid once the gate is passed. Predictable, and it does not reward
   * overachievement.
   */
  PERCENT_OF_TARGET
  /**
   * A flat sum for hitting the gate.
   */
  FIXED_ON_ACHIEVEMENT
  /**
   * So much per unit — per call connected, per lead won.
   */
  PER_UNIT
  /**
   * Bands: a different rate at each level of achievement.
   */
  SLAB
}

/**
 * Where an earning has got to.
 * `HELD` is the one that earns its keep: an incentive on invoiced value that the customer has not
 * paid is not money the company has. Holding it is honest; paying it and hoping is how a business
 * ends up paying commission on a bad debt.
 */
enum IncentiveStatus {
  DUE
  APPROVED
  PAID
  HELD
  CANCELLED
}

/**
 * A rule for paying people for hitting numbers.
 * Schemes are attached to targets rather than to people, because a target already knows who carries
 * it, what is measured and over what period — and an incentive is simply what hitting it is worth.
 */
model IncentiveScheme {
  id          String         @id @default(cuid())
  name        String
  description String?
  /**
   * What it pays on. Must match the target's metric, or the scheme would be paying on one thing
   * while the target measures another.
   */
  metric      TargetMetric
  basis       IncentiveBasis

  /**
   * Nothing pays out below this share of target. Null means it pays from the first rupee.
   */
  thresholdPercent Decimal? @db.Decimal(6, 2)
  /**
   * For the percentage bases.
   */
  ratePercent      Decimal? @db.Decimal(6, 3)
  /**
   * For FIXED_ON_ACHIEVEMENT.
   */
  fixedAmount      Decimal? @db.Decimal(14, 2)
  /**
   * For PER_UNIT — rupees per call, per lead, per ticket.
   */
  perUnitAmount    Decimal? @db.Decimal(14, 2)
  /**
   * A ceiling on any one payout, where the business wants one.
   */
  capAmount        Decimal? @db.Decimal(14, 2)

  /**
   * Whether the money has to be in before this is paid.
   * The single most important flag here. Commission on an invoice the customer never pays is
   * commission paid out of nothing, and it is far easier to hold a payment than to recover one.
   */
  requiresCollection Boolean @default(false)

  active Boolean @default(true)

  createdById String
  createdBy   User     @relation("IncentiveSchemeCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slabs    IncentiveSlab[]
  targets  Target[]
  earnings IncentiveEarning[]

  @@index([metric, active])
  @@map("incentive_schemes")
}

/**
 * One band of a slab scheme.
 * Bounds are a percentage of target, and the upper one is exclusive — so 80–100 and 100–120 meet at
 * exactly 100 without both claiming it. A band with no upper bound runs to infinity, which is what
 * the top band should do: capping the last band silently stops rewarding the best month somebody
 * ever has.
 */
model IncentiveSlab {
  id       String          @id @default(cuid())
  schemeId String
  scheme   IncentiveScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  fromPercent Decimal  @db.Decimal(6, 2)
  toPercent   Decimal? @db.Decimal(6, 2)

  /**
   * Either a rate on achievement, or a flat sum for reaching this band.
   */
  ratePercent Decimal? @db.Decimal(6, 3)
  fixedAmount Decimal? @db.Decimal(14, 2)

  @@index([schemeId, fromPercent])
  @@map("incentive_slabs")
}

/**
 * What one person earned, for one period.
 * The important thing about this row is what is *frozen* in it. The achievement shown on a target
 * page is derived and moves — a credit note in December changes October's figure, and it should.
 * But what somebody was actually paid is a decision made on a day, and it must not move afterwards.
 * So the target, the achievement, the percentage and the workings are all copied here at approval,
 * and the row is the record of what was decided rather than a view onto current data.
 */
model IncentiveEarning {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("IncentiveEarner", fields: [userId], references: [id], onDelete: Cascade)

  /**
   * Where it came from. Null for a spot award that no target produced.
   */
  targetId String?
  target   Target?          @relation(fields: [targetId], references: [id], onDelete: SetNull)
  schemeId String?
  scheme   IncentiveScheme? @relation(fields: [schemeId], references: [id], onDelete: SetNull)

  metric   TargetMetric?
  fromDate DateTime      @db.Date
  toDate   DateTime      @db.Date
  label    String

  /**
   * Frozen at the moment it was worked out — not read from the target afterwards.
   */
  targetValue     Decimal? @db.Decimal(14, 2)
  achievedValue   Decimal? @db.Decimal(14, 2)
  achievedPercent Decimal? @db.Decimal(8, 2)
  amount          Decimal  @db.Decimal(14, 2)
  /**
   * How the figure was arrived at, in words. Frozen too, so a scheme edited next quarter cannot
   * change the explanation of what was paid last quarter.
   */
  workings        String

  status     IncentiveStatus @default(DUE)
  heldReason String?

  approvedById String?
  approvedBy   User?     @relation("IncentiveApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  paidAt    DateTime?
  /**
   * The payslip it went out on, where it was paid with salary.
   */
  payslipId String?
  payslip   Payslip?  @relation(fields: [payslipId], references: [id], onDelete: SetNull)

  note String?

  createdById String
  createdBy   User     @relation("IncentiveCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
  @@index([status, toDate])
  @@index([targetId])
  @@map("incentive_earnings")
}

/**
 * Asking a customer how it went.
 * A request and a response are separate rows on purpose. A request that is never answered is
 * itself worth knowing about — silence after a bad job is the most common outcome, and a model
 * that only stored answers would quietly report a perfect score.
 */
enum FeedbackRequestStatus {
  SENT
  ANSWERED
  CANCELLED
}

model FeedbackRequest {
  id        String @id @default(cuid())
  /**
   * The link. 192 bits of randomness, and the only thing authenticating whoever opens it — see
   * src/actions/feedback-public.ts for what that does and does not grant.
   */
  token     String @unique
  /**
   * The human reference, financial-year scoped like every other document number here.
   */
  reference String @unique

  companyId String
  company   Company  @relation("FeedbackCompany", fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation("FeedbackContact", fields: [contactId], references: [id], onDelete: SetNull)

  /**
   * Snapshotted. Who it was sent to is a fact about this request; editing the contact later, or
   * deleting them, must not rewrite where it went.
   */
  sentToName  String?
  sentToEmail String?
  sentToPhone String?

  /**
   * The person whose work is being asked about. Optional — plenty of feedback is about the company
   * rather than about anybody in particular.
   */
  aboutUserId String?
  aboutUser   User?   @relation("FeedbackAboutUser", fields: [aboutUserId], references: [id], onDelete: SetNull)

  /**
   * What was done for them, as whichever record holds it.
   */
  ticketId         String?
  ticket           Ticket?         @relation("FeedbackTicket", fields: [ticketId], references: [id], onDelete: SetNull)
  visitId          String?
  visit            Visit?          @relation("FeedbackVisit", fields: [visitId], references: [id], onDelete: SetNull)
  companyProductId String?
  order            CompanyProduct? @relation("FeedbackOrder", fields: [companyProductId], references: [id], onDelete: SetNull)
  /**
   * The same thing in words, frozen at the moment of asking — so the form still reads sensibly
   * after the ticket is closed, the order renewed, or the linked record deleted.
   */
  serviceLabel     String?

  /**
   * A line from whoever asked, shown above the form.
   */
  message String?

  status      FeedbackRequestStatus @default(SENT)
  sentAt      DateTime?
  /**
   * After this the link stops working. Feedback about work done three months ago is not feedback,
   * it is archaeology — and a link that never expires is a link that leaks.
   */
  expiresAt   DateTime?
  remindedAt  DateTime?
  cancelledAt DateTime?

  requestedById String
  requestedBy   User     @relation("FeedbackRequestedBy", fields: [requestedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  response FeedbackResponse?

  @@index([companyId, status])
  @@index([aboutUserId])
  @@index([status, sentAt])
  @@map("feedback_requests")
}

model FeedbackResponse {
  id        String          @id @default(cuid())
  requestId String          @unique
  request   FeedbackRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /**
   * 1–5, and the only score that decides anything — including whether a public review is offered.
   */
  rating        Int
  /**
   * Asked only where the request named a person or a service, so null means "not asked" rather
   * than "nothing to say". Averaging them together would be averaging two different questions.
   */
  personRating  Int?
  serviceRating Int?
  comment       String?

  /**
   * Whether the public-review invitation was put in front of them, and the threshold in force when
   * it was decided. Frozen: changing the setting next month must not rewrite what happened.
   */
  reviewInvited         Boolean   @default(false)
  reviewMinRatingAtTime Int?
  reviewOpenedAt        DateTime?

  submittedAt DateTime @default(now())

  /**
   * Closing the loop. A low score nobody answered is worse than no score at all, so acknowledging
   * one is recorded rather than assumed.
   */
  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?     @relation("FeedbackAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  actionNote       String?

  @@index([rating])
  @@index([submittedAt])
  @@map("feedback_responses")
}

// ─── Marketing automation ─────────────────────────────────────────────────────
//
// The rule the whole module is built around: a reseller's end customer is never reached directly.
// See src/lib/reseller.ts, and `suppressionReasons` in src/lib/marketing/suppression.ts, which is
// the single place that decides whether anything may be sent to anybody.

enum MessageChannel {
  EMAIL
  WHATSAPP
  /**
   * Not a message to a customer at all — a job for one of ours. An SI's most valuable automation is
   * often a pre-drafted quote and a call list, not a mailshot, and it works with no provider set up.
   */
  TASK
  NOTIFICATION
}

/**
 * What kind of mail this is, which decides which provider carries it.
 * Transactional mail — an invoice, a password reset — goes from the primary domain. Marketing goes
 * from a separate subdomain, so a bad campaign can never stop a purchase order arriving.
 */
enum MessageClass {
  TRANSACTIONAL
  MARKETING
}

enum ProviderKind {
  EMAIL
  WHATSAPP
}

/**
 * What somebody is consenting to, separately. A customer who wants renewal reminders has not
 * thereby asked for the newsletter, and the preference centre lets them say so.
 */
enum MarketingTopic {
  RENEWALS
  OFFERS
  PRODUCT_NEWS
  EVENTS
  NEWSLETTER
  SERVICE
}

model MessagingProvider {
  id       String         @id @default(cuid())
  /**
   * "resend" | "ses" | "elastic" | "m365" | "mock" | a WhatsApp BSP.
   */
  key      String         @unique
  kind     ProviderKind   @default(EMAIL)
  label    String
  enabled  Boolean        @default(false)
  /**
   * Lower goes first. Failover walks this order, and only for retryable errors.
   */
  priority Int            @default(100)
  /**
   * Which classes of message this provider carries. Empty means it is configured but routed
   * nothing, which is a safe state rather than a broken one.
   */
  classes  MessageClass[] @default([])

  fromName  String?
  fromEmail String?
  replyTo   String?

  /**
   * Non-secret settings — region, SMTP host and port, API base.
   */
  config       Json?
  /**
   * The API key or password. Encrypted at rest; see src/lib/crypto.ts. Never sent to a client.
   */
  secretCipher String?

  /**
   * The provider's own cap, so a tick stops short of it rather than being throttled.
   */
  dailyCap Int?

  lastVerifiedAt DateTime?
  verifyOk       Boolean?
  verifyDetail   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages MarketingMessage[]

  @@index([kind, enabled])
  @@map("messaging_providers")
}

/**
 * A saved segment.
 * Its own model rather than a third `WorkbookMode`: a calling workbook is frozen into caller
 * allocations and worked through once, whereas an audience is re-evaluated at every send. Same
 * filter DSL though — `companyFilters` is a `WorkbookFilters` and runs through the very same
 * `buildWhere` (src/lib/workspace/filters.ts), so the two can't drift apart.
 */
model Audience {
  id          String  @id @default(cuid())
  name        String
  description String?

  /**
   * WorkbookFilters. Derived on read — membership is always a live query.
   */
  companyFilters Json
  /**
   * ContactFilters — designation, primary only, verified address only, topic.
   */
  contactFilters Json

  createdById String
  createdBy   User     @relation("AudienceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns Campaign[]
  journeys  Journey[]

  @@map("marketing_audiences")
}

model MarketingTemplate {
  id      String         @id @default(cuid())
  name    String
  channel MessageChannel @default(EMAIL)
  topic   MarketingTopic @default(OFFERS)

  subject              String?
  preheader            String?
  body                 String
  /**
   * The template name approved by the WhatsApp BSP. Meaningless for email.
   */
  whatsappTemplateName String?
  /**
   * TEXT is written in the editor — line breaks kept, merged values escaped, wrapped in a plain
   * layout. HTML is uploaded or pasted, and cleaned on save. See src/lib/marketing/html.ts.
   */
  format               TemplateFormat   @default(TEXT)
  /**
   * The file an uploaded template came from, so it can be recognised later.
   */
  sourceFileName       String?
  assets               MarketingAsset[]

  active Boolean @default(true)

  createdById String
  createdBy   User     @relation("TemplateCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns Campaign[]
  steps     JourneyStep[]

  @@map("marketing_templates")
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
}

/**
 * A one-off broadcast to an audience.
 */
model Campaign {
  id        String @id @default(cuid())
  reference String @unique
  name      String

  /**
   * Who it goes to: an audience (derived from the CRM), an uploaded list, or both — at least one.
   */
  audienceId String?
  audience   Audience?         @relation(fields: [audienceId], references: [id], onDelete: Restrict)
  listId     String?
  list       MarketingList?    @relation(fields: [listId], references: [id], onDelete: SetNull)
  templateId String
  template   MarketingTemplate @relation(fields: [templateId], references: [id])

  channel MessageChannel @default(EMAIL)
  status  CampaignStatus @default(DRAFT)

  scheduledFor      DateTime?
  /**
   * Minutes from midnight, local. Outside it, a queued message waits.
   */
  windowStartMinute Int?
  windowEndMinute   Int?

  /**
   * A send above the configured size needs a second pair of eyes, like an order does.
   */
  approvedById String?
  approvedBy   User?     @relation("CampaignApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  startedAt  DateTime?
  finishedAt DateTime?

  createdById String
  createdBy   User     @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages MarketingMessage[]

  @@index([status, scheduledFor])
  @@map("marketing_campaigns")
}

enum JourneyStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

/**
 * A sequence somebody is enrolled into when something happens to them.
 */
model Journey {
  id   String @id @default(cuid())
  name String

  /**
   * A key from the trigger registry — src/lib/marketing/triggers.ts.
   */
  trigger       String
  /**
   * Trigger-specific settings, e.g. `{ "days": 60 }`.
   */
  triggerConfig Json?

  /**
   * Optional extra narrowing on top of what the trigger found.
   */
  audienceId String?
  audience   Audience? @relation(fields: [audienceId], references: [id], onDelete: SetNull)

  status JourneyStatus @default(DRAFT)

  /**
   * What takes somebody out part-way through: they replied, they bought, they raised a ticket.
   */
  exitOn           Json?
  /**
   * Null means never again. Otherwise the same trigger may re-enrol them after this many days.
   */
  reEnrolAfterDays Int?

  createdById String
  createdBy   User     @relation("JourneyCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps      JourneyStep[]
  enrolments JourneyEnrolment[]

  @@index([status, trigger])
  @@map("marketing_journeys")
}

model JourneyStep {
  id        String  @id @default(cuid())
  journeyId String
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  order     Int
  /**
   * Days after the previous step — 0 means immediately.
   */
  delayDays Int @default(0)

  channel    MessageChannel     @default(EMAIL)
  templateId String?
  template   MarketingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /**
   * For a TASK step. The one kind of step that needs no provider and no consent.
   */
  taskTitle    String?
  taskDetail   String?
  taskDueDays  Int?
  /**
   * "OWNER" (the account manager), "ASSIGNEE" (the caller), or a user id.
   */
  taskAssignee String?

  messages MarketingMessage[]

  @@unique([journeyId, order])
  @@map("marketing_journey_steps")
}

enum EnrolmentStatus {
  ACTIVE
  COMPLETED
  EXITED
  SUPPRESSED
}

model JourneyEnrolment {
  id        String  @id @default(cuid())
  journeyId String
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  companyId String
  company   Company  @relation("JourneyCompany", fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation("JourneyContact", fields: [contactId], references: [id], onDelete: SetNull)

  /**
   * What this enrolment is *about* — `renewal:<companyProductId>`, `warranty:<assetId>`. Unique per
   * journey, so a nightly tick that keeps finding the same subscription enrols it once, not once a
   * night. The same trick as `Notification.dedupeKey`.
   */
  triggerKey String

  status      EnrolmentStatus @default(ACTIVE)
  currentStep Int             @default(0)
  nextRunAt   DateTime?

  enrolledAt DateTime  @default(now())
  exitedAt   DateTime?
  exitReason String?

  messages MarketingMessage[]

  @@unique([journeyId, triggerKey])
  @@index([status, nextRunAt])
  @@index([companyId])
  @@map("marketing_enrolments")
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  FAILED
  /**
   * Never sent, and the row says why. A recipient silently dropped is a recipient nobody can explain.
   */
  SUPPRESSED
}

model MarketingMessage {
  id    String @id @default(cuid())
  /**
   * Carried in the tracking and unsubscribe links.
   */
  token String @unique

  campaignId  String?
  campaign    Campaign?         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  enrolmentId String?
  enrolment   JourneyEnrolment? @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  stepId      String?
  step        JourneyStep?      @relation(fields: [stepId], references: [id], onDelete: SetNull)

  companyId String
  company   Company  @relation("MarketingMessageCompany", fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation("MarketingMessageContact", fields: [contactId], references: [id], onDelete: SetNull)

  channel      MessageChannel     @default(EMAIL)
  messageClass MessageClass       @default(MARKETING)
  providerId   String?
  provider     MessagingProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  /**
   * Frozen when the message is queued. Editing a template next month must not rewrite what went out
   * last month — the same reason a letter's body is frozen and its letterhead is not.
   */
  subject        String?
  body           String
  /**
   * The plain-text part, frozen with the body. Null on rows written before there was one — the
   * provider derives it from the HTML then.
   */
  textBody       String?
  /**
   * Where the List-Unsubscribe header points — the one-click unsubscribe Gmail and Yahoo require
   * of anybody sending in bulk.
   */
  unsubscribeUrl String?
  toEmail        String?
  toPhone        String?

  status           MessageStatus @default(QUEUED)
  /**
   * Set only on SUPPRESSED. The answer to "why didn't they get it?".
   */
  suppressedReason String?

  scheduledFor      DateTime
  /**
   * The claim. Two overlapping ticks cannot take the same row.
   */
  lockedAt          DateTime?
  lockedBy          String?
  attempts          Int       @default(0)
  sentAt            DateTime?
  providerMessageId String?
  error             String?

  /// Who pressed send, for a message a person sent by hand (a renewal or fulfilment notice). A
  /// campaign's author is on the campaign and a journey sends by itself, so both leave this null.
  sentByUserId     String?
  sentBy           User?               @relation("MarketingMessageSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)
  /// The order a customer notice was about.
  companyProductId String?
  companyProduct   CompanyProduct?     @relation("MarketingMessageOrder", fields: [companyProductId], references: [id], onDelete: SetNull)
  noticeKind       CustomerNoticeKind?
  /// The form invitation this message carried — first send or a reminder, each its own message.
  formInviteId     String?
  formInvite       FormInvite?         @relation(fields: [formInviteId], references: [id], onDelete: SetNull)
  /** The invoice, proposal or credit note this email carried. */
  tradeDocumentId  String?
  tradeDocument    TradeDocument?      @relation("MarketingMessageDocument", fields: [tradeDocumentId], references: [id], onDelete: SetNull)
  /** The mailbox it went out from, when it was sent as a person rather than through a provider. */
  fromEmail        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events MessageEvent[]

  /**
   * One message per recipient per campaign, and one per step per enrolment. Belt and braces.
   */
  @@unique([campaignId, contactId])
  @@unique([enrolmentId, stepId])
  @@index([status, scheduledFor])
  @@index([companyId])
  /// The mail log: newest first, for one customer or across all of them.
  @@index([companyId, createdAt])
  @@index([createdAt])
  @@index([contactId, sentAt])
  @@index([formInviteId])
  @@index([tradeDocumentId])
  @@map("marketing_messages")
}

enum MessageEventType {
  DELIVERED
  OPEN
  CLICK
  BOUNCE
  COMPLAINT
  UNSUBSCRIBE
  FAILED
}

model MessageEvent {
  id        String           @id @default(cuid())
  messageId String
  message   MarketingMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  type            MessageEventType
  occurredAt      DateTime         @default(now())
  url             String?
  /**
   * The provider's own event id. Unique, so a webhook replay is recorded once.
   */
  providerEventId String?          @unique
  detail          String?

  @@index([messageId, occurredAt])
  @@map("marketing_message_events")
}

enum ConsentStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  PENDING
}

enum ConsentSource {
  IMPORT
  FORM
  VERBAL
  CONTRACT
  PREFERENCE_CENTRE
  CAMPAIGN_LINK
}

/**
 * Consent, as an artefact rather than a boolean.
 * The DPDP Act asks what somebody agreed to, when, how, and how they can take it back — so a row
 * records the purpose, the source and the evidence, and withdrawal is a timestamp rather than a
 * deletion. A deleted consent record cannot demonstrate that consent was ever withdrawn.
 */
model ContactConsent {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation("ContactConsent", fields: [contactId], references: [id], onDelete: Cascade)

  channel MessageChannel @default(EMAIL)
  topic   MarketingTopic

  status   ConsentStatus @default(SUBSCRIBED)
  source   ConsentSource @default(IMPORT)
  /**
   * What we can point at if asked — a form id, a call, a clause in the contract.
   */
  evidence String?

  capturedAt   DateTime  @default(now())
  capturedById String?
  capturedBy   User?     @relation("ConsentCapturedBy", fields: [capturedById], references: [id], onDelete: SetNull)
  withdrawnAt  DateTime?

  @@unique([contactId, channel, topic])
  @@map("marketing_consents")
}

enum SuppressionScope {
  EMAIL
  CONTACT
  COMPANY
  DOMAIN
}

/**
 * Only facts we were *told*. Everything derivable — reseller-managed, an unverified address, an
 * unanswered complaint — is computed fresh by `suppressionReasons`, so resolving the underlying
 * problem restores marketability the moment it is resolved rather than needing a row deleted.
 */
enum SuppressionReason {
  UNSUBSCRIBED
  HARD_BOUNCE
  COMPLAINT
  MANUAL
}

model Suppression {
  id     String            @id @default(cuid())
  scope  SuppressionScope
  /**
   * The address, contact id, company id or domain. Lowercased.
   */
  value  String
  reason SuppressionReason
  note   String?

  createdById String?
  createdBy   User?     @relation("SuppressionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  /**
   * A cooling-off period rather than a permanent block, where that is the right answer.
   */
  expiresAt   DateTime?

  @@unique([scope, value])
  @@index([reason])
  @@map("marketing_suppressions")
}

/**
 * A public page that turns a stranger into a lead.
 */
model InboundForm {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  headline String?
  intro    String?

  /**
   * The questions, as `[{ key, label, type, required, options?, placeholder? }]`.
   * Read through `parseFields` in src/lib/marketing/form-fields.ts, never directly: the public
   * page renders from it and the submit handler validates against it, and those two reading the
   * column differently is how a form comes to accept answers it never asked for. An empty or
   * malformed value falls back to a default set of questions rather than rendering nothing.
   */
  fields Json

  /**
   * Submitting implies consent for this topic, recorded with the submission as evidence.
   */
  topic          MarketingTopic @default(OFFERS)
  createsLead    Boolean        @default(true)
  assignToUserId String?
  assignTo       User?          @relation("FormAssignee", fields: [assignToUserId], references: [id], onDelete: SetNull)
  thankYouText   String?
  active         Boolean        @default(true)

  /**
   * What kind of form this is. Decides the starter questions and, for EVENT, that the form carries
   * a date, a place, an RSVP and an attendance register. See src/lib/forms/categories.ts.
   */
  category FormCategory @default(ENQUIRY)
  /**
   * Who can fill it in: anyone with the public link, only the people sent a personal invitation, or
   * both. An invitation-only form's public address answers "not available", exactly as a closed one
   * does, so the slug gives nothing away.
   */
  fillMode FormFillMode @default(LINK)
  /**
   * Stops taking answers after this moment. Null: open until somebody closes it.
   */
  closesAt DateTime?

  /**
   * EVENT only. Stored as instants; shown in India time.
   */
  eventStartsAt DateTime?
  eventEndsAt   DateTime?
  /**
   * A place, or "Online — link sent on registration". Free text: a roundtable is often a hotel.
   */
  venue         String?
  /**
   * Seats. Registrations that would go past it are refused; a "can't make it" never is.
   */
  capacity      Int?

  /**
   * Whose form it is. Full control — questions, sharing, every response — whatever anybody else was
   * granted. Separate from `createdById` so that a handover can move ownership without rewriting
   * who built it.
   */
  ownerUserId String
  owner       User   @relation("FormOwner", fields: [ownerUserId], references: [id])

  createdById String
  createdBy   User     @relation("FormCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions FormSubmission[]
  grants      FormAccessGrant[]
  invites     FormInvite[]

  @@index([ownerUserId])
  @@map("marketing_forms")
}

enum FormCategory {
  ENQUIRY
  EVENT
  ASSESSMENT
  SURVEY
  OTHER
}

enum FormFillMode {
  LINK
  INVITE
  BOTH
}

enum FormAttendance {
  ATTENDED
  NO_SHOW
}

/**
 * Who else may see a form, change it, invite people to it, or read what people answered.
 * Granted to one person or to everybody holding a role — exactly one of the two, enforced by a CHECK
 * constraint in the migration. The three switches are independent on purpose: somebody can be allowed
 * to build the questions without reading a customer's answers, or to read the answers of an event
 * they did not organise. Holding a grant at all is what lets somebody see the form.
 * The owner and anybody with `forms.manageAll` need no row. See src/lib/forms/access.ts.
 */
model FormAccessGrant {
  id     String      @id @default(cuid())
  formId String
  form   InboundForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  userId  String?
  user    User?   @relation("FormAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  roleKey String?
  role    Role?   @relation(fields: [roleKey], references: [key], onDelete: Cascade)

  canEdit          Boolean @default(false)
  canViewResponses Boolean @default(false)
  canInvite        Boolean @default(false)

  grantedById String?
  grantedBy   User?    @relation("FormAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([formId, userId])
  @@unique([formId, roleKey])
  @@index([userId])
  @@index([roleKey])
  @@map("form_access_grants")
}

/**
 * A personal invitation: one contact, one form, one link.
 * The token in the link is the whole authentication — 192 bits, and it lets the holder answer this
 * one form as this one contact, and nothing else. Reminders reuse it, so every email somebody was
 * sent opens the same answer, and answering again changes that answer rather than adding a second.
 * Status is derived, never stored: withdrawn, answered (and for an event, coming or not), link
 * opened, or just sent. A stored status is one more thing to keep in step with the submission.
 */
model FormInvite {
  id     String      @id @default(cuid())
  formId String
  form   InboundForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  token  String      @unique

  contactId String
  contact   Contact @relation("FormInviteContact", fields: [contactId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation("FormInviteCompany", fields: [companyId], references: [id], onDelete: Cascade)
  /**
   * The address it went to, frozen — the contact's may change after.
   */
  email     String

  invitedById String?
  invitedBy   User?     @relation("FormInviteInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  lastSentAt  DateTime?
  sendCount   Int       @default(0)
  /**
   * First time the link was loaded. A mail scanner following links counts too, so this is "the link
   * was opened", never "they read it".
   */
  openedAt    DateTime?
  revokedAt   DateTime?

  submission FormSubmission?
  messages   MarketingMessage[]

  /**
   * One invitation per person per form: inviting again is a reminder, not a second invitation.
   */
  @@unique([formId, contactId])
  @@index([companyId])
  @@map("form_invites")
}

model FormSubmission {
  id     String      @id @default(cuid())
  formId String
  form   InboundForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  payload Json

  name        String?
  email       String?
  phone       String?
  companyName String?

  companyId String?
  company   Company? @relation("FormSubmissionCompany", fields: [companyId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation("FormSubmissionContact", fields: [contactId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?    @relation("FormSubmissionLead", fields: [leadId], references: [id], onDelete: SetNull)

  /**
   * Hashed. Rate limiting needs to know how often, never who.
   */
  sourceHash String?

  /**
   * Came in through a personal invitation. Answering again updates this row.
   */
  inviteId String?     @unique
  invite   FormInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  /**
   * EVENT forms: the RSVP. Null on every other kind of form.
   */
  attending            Boolean?
  /**
   * EVENT forms, on the day. Only somebody who said they were coming is marked.
   */
  attendance           FormAttendance?
  attendanceMarkedAt   DateTime?
  attendanceMarkedById String?
  attendanceMarkedBy   User?           @relation("FormAttendanceMarkedBy", fields: [attendanceMarkedById], references: [id], onDelete: SetNull)

  /**
   * Somebody here entered this for them — an RSVP given on the phone. Null when they filled it in.
   */
  recordedById String?
  recordedBy   User?   @relation("FormResponseRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([formId, createdAt])
  @@index([companyId])
  @@map("marketing_form_submissions")
}

/**
 * One run of the scheduler.
 * Kept because a cron that silently stopped is the classic way this fails, and the only way to
 * notice is to record that it ran.
 */
model MarketingTick {
  id    String @id @default(cuid())
  runId String @unique

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  enrolled   Int @default(0)
  claimed    Int @default(0)
  sent       Int @default(0)
  failed     Int @default(0)
  suppressed Int @default(0)

  error String?

  @@index([startedAt])
  @@map("marketing_ticks")
}

// ---------------------------------------------------------------------------------------------
// Security, DLP and activity logging
// ---------------------------------------------------------------------------------------------

/**
 * What a user *did*, as distinct from what they *changed*.
 * `AuditLog` answers "who altered this record and when" — it is the history of the data. This
 * answers "who looked, who exported, who was refused, who tried to take a screenshot" — the
 * history of behaviour. Keeping them apart matters because they have different shapes: an audit
 * row always has an entity, an activity row often has none (a login, a blocked crawler), and an
 * activity row often has no user at all.
 */
model ActivityLog {
  id String @id @default(cuid())

  /**
   * Null for anonymous events — a blocked crawler, a sign-in attempt against an address that
   * isn't an account — and for users deleted since.
   */
  userId String?
  user   User?   @relation("UserActivity", fields: [userId], references: [id], onDelete: SetNull)

  /**
   * Frozen at write time, and the reason `userId` is `SetNull` rather than `Cascade`.
   * `AuditLog` cascades, so deleting a user takes their audit trail with them. For a security log
   * that would be a hole big enough to drive through: the last act of a departing employee's
   * account could erase the record of everything they exported on the way out. The name and
   * address are copied onto the row so the trail outlives the account it describes.
   */
  userName  String?
  userEmail String?

  /**
   * Set when an admin was viewing as `userId` at the time — same reasoning as
   * `AuditLog.impersonatedByUserId`. Without it, "view as" is a way to browse somebody's data
   * under their name.
   */
  impersonatedByUserId String?
  impersonatedBy       User?   @relation("ActivityImpersonatedBy", fields: [impersonatedByUserId], references: [id], onDelete: SetNull)

  kind     ActivityKind
  severity ActivitySeverity @default(INFO)

  /**
   * A readable sentence, written at the call site — the log is meant to be skimmed, not decoded.
   */
  summary String

  /**
   * Optional subject, so a record's own page can show what happened to it.
   */
  entityType String?
  entityId   String?

  path      String?
  ipAddress String?
  userAgent String?

  /**
   * Anything kind-specific: row counts on an export, the blocked user agent, the search term.
   */
  metadata Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@index([severity, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

enum ActivityKind {
  // Getting in and out
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  TWO_FACTOR_ENABLED
  IMPERSONATION_STARTED
  IMPERSONATION_ENDED

  // Reading data — the half that leakage actually happens through
  VIEW
  SEARCH
  EXPORT
  PRINT
  /**
   * Read volume past the configured threshold: the one signal a scraper cannot hide.
   */
  BULK_READ

  // Client-side deterrents firing
  SCREENSHOT
  SCREENSHOT_BLOCKED
  COPY_BLOCKED
  CUT_BLOCKED
  PASTE_BLOCKED
  CONTEXT_MENU_BLOCKED
  PRINT_BLOCKED
  DEVTOOLS_OPENED

  // The perimeter
  BOT_BLOCKED
  PERMISSION_DENIED
  RATE_LIMITED

  // Where and on what people sign in — src/lib/access
  /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * A browser this account has not used before. Waiting for approval when the role requires it.
   */
  NEW_DEVICE
  DEVICE_APPROVED
  /**
   * Rejected before it was ever used, or revoked after — either way it no longer gets in.
   */
  DEVICE_BLOCKED
  /**
   * An address nobody on this account's role has an allow rule for, seen for the first time.
   */
  NEW_NETWORK
  /**
   * A request turned away or held by the access rules: a blocked network, a device waiting for
   * approval, a device type the role may not use, a location not shared.
   */
  ACCESS_HELD
  /**
   * Two sign-ins further apart than anybody could have travelled in the time between them.
   */
  IMPOSSIBLE_TRAVEL
  /**
   * An admin ended somebody's session, or a device was revoked with sessions open on it.
   */
  SESSION_ENDED

  // Administration
  SECURITY_POLICY_CHANGED
}

enum ActivitySeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

/**
 * The per-day screenshot counter.
 * A separate row with a unique key rather than counting `ActivityLog` rows, so the increment is
 * atomic and two quick attempts cannot both see "1 used" and both be allowed. Cascade-deletes with
 * the user because it is only a counter — the evidence lives in `ActivityLog`, which does not.
 */
model ScreenshotAllowance {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserScreenshotAllowance", fields: [userId], references: [id], onDelete: Cascade)

  /**
   * `YYYY-MM-DD` in IST — the working day the cap resets on, not a UTC one.
   */
  day    String
  count  Int      @default(0)
  lastAt DateTime @default(now())

  @@unique([userId, day])
  @@index([day])
  @@map("screenshot_allowances")
}

/**
 * Singleton row (id is always "global") holding the data-loss-prevention policy.
 * Read honestly, this model has two halves that are not equally strong, and the settings screen
 * says so rather than letting an admin believe otherwise:
 * - The `block*` flags and the screenshot cap are **deterrents**. They stop the casual copy and
 * they create a record, but anyone willing to open devtools, disable JavaScript or point a
 * phone at the screen defeats every one of them. No web application can do better.
 * - The export limits, bulk-read threshold and bot blocking are **enforced server-side** and
 * hold regardless of what the browser does.
 * The deterrents are worth having anyway: most leakage is careless rather than determined, and the
 * log they produce is what makes the determined kind attributable afterwards.
 */
model SecurityPolicy {
  id String @id @default("global")

  // --- Deterrents (client side, defeatable) ---
  blockCopy          Boolean @default(false)
  blockCut           Boolean @default(false)
  blockPaste         Boolean @default(false)
  blockContextMenu   Boolean @default(false)
  blockTextSelection Boolean @default(false)
  blockPrint         Boolean @default(false)
  blockDevTools      Boolean @default(false)
  /**
   * Blanks the screen when the window loses focus — aimed at screen sharing, not at attackers.
   */
  blurOnBlur         Boolean @default(false)

  /**
   * 0 refuses every screenshot; -1 is unlimited. Attempts are logged either way.
   */
  screenshotLimitPerDay  Int     @default(2)
  screenshotNotifyAdmins Boolean @default(true)

  /**
   * Prints the viewer's name, address and the time faintly across the page. The only measure here
   * that survives a photograph — it does not prevent the capture, it makes it traceable.
   */
  watermarkEnabled Boolean @default(false)
  watermarkOpacity Int     @default(7)

  // --- Enforced server side ---
  exportRowLimit       Int     @default(1000)
  exportRequiresReason Boolean @default(false)

  /**
   * Records read per window before it is treated as scraping rather than working.
   */
  bulkReadThreshold     Int @default(400)
  bulkReadWindowMinutes Int @default(10)

  blockBots       Boolean @default(true)
  blockAiCrawlers Boolean @default(true)
  botMode         BotMode @default(BLOCK)

  // --- Logging ---

  /**
   * Off by default: a row per page view is a lot of rows, and rarely the row you want.
   */
  logPageViews  Boolean @default(false)
  retentionDays Int     @default(365)

  /**
   * Roles the deterrents do not apply to. ADMIN is always exempt and is not stored here — an admin
   * locked out of copying cannot administer the thing that locked them out.
   */
  /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * Plain strings, not a relation.
   * Postgres cannot put a foreign key on the elements of an array, so a deleted role simply stops
   * matching anything here — which is the right outcome: an exemption for a role nobody holds is
   * not an exemption, and blocking a role deletion over a stale DLP entry would be worse.
   */
  exemptRoles String[] @default([])

  updatedAt DateTime @updatedAt

  @@map("security_policy")
}

enum BotMode {
  /**
   * Answer 403 and log it.
   */
  BLOCK
  /**
   * Let it through, but record that it came — for finding out what is hitting you first.
   */
  LOG
}

// ---------------------------------------------------------------------------------------------
// Access control: who may sign in, from where, and on what — src/lib/access
// ---------------------------------------------------------------------------------------------

enum DeviceKind {
  MOBILE
  TABLET
  /**
   * A laptop or a desktop. A browser cannot tell the two apart, so the app does not pretend to —
   * approving one specific machine is how a laptop is told from the desktop beside it.
   */
  COMPUTER
}

enum DeviceStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

/**
 * What happens when somebody on a role arrives from an address no allow rule covers.
 */
enum UnknownNetworkAction {
  /**
   * Let them in and record where from.
   */
  ALLOW
  /**
   * Let them in, and tell the security admins the first time the address is seen.
   */
  ALERT
  /**
   * Hold them until an admin allows the address.
   */
  HOLD
  /**
   * Only allow-listed networks. There is no approval path — an admin adds a rule.
   */
  BLOCK
}

enum IpRuleAction {
  ALLOW
  BLOCK
}

/**
 * A browser somebody signs in on.
 * Identified by a random token in an http-only cookie, stored here only as a hash. So a "device" is
 * one browser on one machine: another browser, a private window or cleared cookies is a new device.
 * That is the honest unit — nothing a web page can read identifies the hardware — and it is enough
 * to make approval mean something: the token has to be taken off the approved machine to be used.
 * Checked on every request, not only at sign-in, which is also what gives a signed-in session a way
 * to be ended: revoking the device ends every session on it within seconds.
 */
model UserDevice {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation("DeviceOwner", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  kind      DeviceKind
  /**
   * "Chrome on Windows" — from the browser's own description of itself.
   */
  label     String
  userAgent String?
  status    DeviceStatus @default(PENDING)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  lastIp      String?
  lastPlace   String?

  /**
   * Null with status APPROVED means it was allowed automatically: its role did not require
   * approval when it was first seen.
   */
  decidedById  String?
  decidedBy    User?     @relation("DeviceDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?

  /**
   * The sign-in whose location was last shared from this device. A role that requires location
   * asks again at every new sign-in, not once per device.
   */
  locationSessionId String?

  signIns SignIn[]

  @@unique([userId, tokenHash])
  @@index([status])
  @@map("user_devices")
}

/**
 * One sign-in, and the session that follows it: where from, on what, and — for a role that requires
 * it — where the person said they were.
 * `sid` is written into the session token at sign-in, which is what lets one session be ended
 * without ending every other one the person has open.
 */
model SignIn {
  id       String      @id @default(cuid())
  sid      String      @unique
  userId   String
  user     User        @relation("SignInUser", fields: [userId], references: [id], onDelete: Cascade)
  deviceId String?
  device   UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  /**
   * "credentials" or "microsoft-entra-id".
   */
  provider String

  at         DateTime    @default(now())
  lastSeenAt DateTime    @default(now())
  ip         String?
  userAgent  String?
  deviceKind DeviceKind?

  /**
   * From the address, at the moment of sign-in: approximate, city-level, and for mobile data often
   * the operator's hub rather than the person. Null when no location database is installed, or for
   * a private address.
   */
  city        String?
  region      String?
  countryCode String?
  country     String?
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)

  /**
   * From the browser, when the role requires it. Reported by the device, so a determined person
   * can fake it — it is evidence, not proof.
   */
  gpsLatitude  Decimal?  @db.Decimal(9, 6)
  gpsLongitude Decimal?  @db.Decimal(9, 6)
  gpsAccuracyM Int?
  gpsAt        DateTime?

  /**
   * NEW_DEVICE, NEW_NETWORK, IMPOSSIBLE_TRAVEL — what was unusual about it, worked out when it happened.
   */
  flags String[] @default([])

  endedAt   DateTime?
  endedById String?
  endedBy   User?     @relation("SignInEndedBy", fields: [endedById], references: [id], onDelete: SetNull)

  @@index([userId, at])
  @@index([at])
  @@map("sign_ins")
}

/**
 * The access rules for one role. A role with no row has none: every device, every network, no
 * location asked for.
 */
model RoleAccessPolicy {
  roleKey String @id
  role    Role   @relation(fields: [roleKey], references: [key], onDelete: Cascade)

  allowMobile   Boolean @default(true)
  allowTablet   Boolean @default(true)
  allowComputer Boolean @default(true)

  requireDeviceApproval Boolean              @default(false)
  unknownNetwork        UnknownNetworkAction @default(ALLOW)
  requireLocation       Boolean              @default(false)

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("AccessPolicyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("role_access_policies")
}

/**
 * An address or range that is allowed or blocked — the office network, a branch, a known-bad host.
 * `cidr` is canonical: a single address is stored as /32 (or /128), and host bits are cleared. A
 * rule applies to the roles listed, or to everybody when the list is empty. A block beats an allow
 * wherever both match.
 */
model IpRule {
  id       String       @id @default(cuid())
  cidr     String
  action   IpRuleAction
  label    String
  roleKeys String[]     @default([])

  createdById String?
  createdBy   User?     @relation("IpRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  /**
   * A rule that lapses on its own is one nobody has to remember to take away.
   */
  expiresAt   DateTime?

  @@index([action])
  @@map("ip_rules")
}

/**
 * Every address a signed-in person has arrived from, and where it is. The list an admin works
 * through to allow the new branch office or block the address that should not be there.
 */
model NetworkAddress {
  ip           String   @id
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  lastUserId   String?
  lastUserName String?

  city        String?
  region      String?
  countryCode String?
  country     String?
  isPrivate   Boolean @default(false)

  /**
   * When somebody was first held on it for want of an allow rule, and when admins were told.
   */
  heldAt      DateTime?
  alertedAt   DateTime?
  /**
   * Looked at and left as it is — neither allowed nor blocked. Takes it off the review list.
   */
  dismissedAt DateTime?

  @@index([lastSeenAt])
  @@map("network_addresses")
}

// ---------------------------------------------------------------------------------------------
// Access control: the super-admin tier, per-user grants, and the authorization audit trail
// ---------------------------------------------------------------------------------------------

/**
 * A permission granted or denied to one person, over and above whatever their role gives them.
 * `RolePermission` answers "what can an ACCOUNTS user do"; this answers "what can *Priya* do".
 * Both are needed, and the second is the one real organisations actually run on: somebody covering
 * a colleague's maternity leave, an accountant who also sells, a new joiner who should not touch
 * payroll for the first month. Without it the only way to give one person one extra capability is
 * to widen the whole role, which is how a permission system quietly becomes decorative.
 * `allowed: false` is a genuine denial and outranks the role — see the precedence table in
 * src/lib/authz/resolve.ts. The role table cannot express that usefully today.
 */
model UserPermission {
  userId     String
  permission String
  allowed    Boolean

  /**
   * Why the exception exists. Required by the UI, not the database — an unexplained grant is one nobody dares remove later.
   */
  reason      String?
  grantedById String?
  /**
   * Optional expiry, so a cover-while-she-is-away grant cleans itself up. Null is permanent.
   * Checked in the resolver rather than by a job: an expired row must stop working at the instant
   * it expires, not whenever a sweep next runs.
   */
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User  @relation("UserPermissionSubject", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("UserPermissionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id(name: "user_permission", [userId, permission])
  @@index([permission])
  @@index([expiresAt])
  @@map("user_permissions")
}

/**
 * Append-only record of every change to who can do what.
 * `RolePermission.updatedAt` is overwritten on every edit, so today the question "who held
 * payroll.manage in March, and who gave it to them" has no answer at all. Authorization changes are
 * exactly the changes that matter after an incident, and they are the ones currently least
 * recorded — `setRolePermission` writes nothing, and neither do any of the four user actions.
 * Rows are never updated or deleted.
 */
model PermissionChange {
  id String @id @default(cuid())

  actorUserId          String
  /**
   * Set when an admin was viewing as somebody else, resolved the same way src/lib/audit.ts does.
   * Without it "view as" is a way to launder a grant onto another person's name.
   */
  impersonatedByUserId String?

  subjectType   PermissionSubjectType
  /**
   * Set for a role-level change.
   */
  /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * Deliberately a bare string with no foreign key.
   * This is the audit trail. A role that has since been deleted must still appear in its own
   * history — a reference that forced the row to disappear with the role, or that stopped the role
   * being deleted at all, would make the log describe only the present.
   */
  subjectRole   String?
  /**
   * Set for a per-user change.
   */
  subjectUserId String?

  /**
   * Null for the kinds that are not about a single key — a role assignment, a preset, a status change.
   */
  permission  String?
  fromAllowed Boolean?
  toAllowed   Boolean?

  changeKind PermissionChangeKind
  /**
   * Free text: the preset name, "SALES → ACCOUNTS", the diff summary of a bulk apply.
   */
  detail     String?

  createdAt DateTime @default(now())

  actor       User  @relation("PermissionChangeActor", fields: [actorUserId], references: [id])
  subjectUser User? @relation("PermissionChangeSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([subjectUserId, createdAt])
  @@index([subjectRole, createdAt])
  @@index([permission, createdAt])
  @@index([createdAt])
  @@map("permission_changes")
}

enum PermissionSubjectType {
  ROLE
  USER
}

enum PermissionChangeKind {
  GRANT
  REVOKE
  RESET_TO_DEFAULT
  PRESET_APPLIED
  ROLE_ASSIGNED
  MANAGER_CHANGED
  DEPARTMENT_CHANGED
  USER_CREATED
  USER_ACTIVATED
  USER_DEACTIVATED
  TWO_FACTOR_RESET
  SUPER_ADMIN_GRANTED
  SUPER_ADMIN_REVOKED

  /**
   * The role itself, as against somebody being put into one.
   * Roles became data, so defining one is now an act somebody performs rather than a deploy. These
   * three are the audit trail for it: an access review asking "where did this role come from"
   * should not have to infer it from the permissions that appeared underneath it.
   */
  ROLE_CREATED
  ROLE_RENAMED
  ROLE_DELETED
}

/**
 * Which columns one person wants to see on one table.
 * Per user and per table rather than a single blob on `User`, for the reason the dashboard widget
 * list already demonstrates: a column added to the orders table next release must appear for
 * everybody who has not deliberately hidden it. A stored list of *visible* keys does that on its
 * own — a key nobody has an opinion about is simply absent, and the registry default decides.
 * Absence of a row means "has never customised this table", which is different from "has hidden
 * every column" and must stay distinguishable: the first shows the defaults, the second shows an
 * empty table and a way back.
 */
model TablePreference {
  userId   String
  /**
   * Matches a key in TABLE_REGISTRY — see src/lib/tables/registry.ts.
   */
  tableKey String
  /**
   * The column keys this person wants visible. Order follows the registry, not this array.
   */
  columns  String[] @default([])

  updatedAt DateTime @updatedAt

  user User @relation("UserTablePreferences", fields: [userId], references: [id], onDelete: Cascade)

  @@id(name: "user_table", [userId, tableKey])
  @@map("table_preferences")
}

/**
 * A user's profile photo, kept out of the `users` row on purpose.
 * The obvious shape is a `photoDataUrl` column on `User`, matching `BrandingSettings`. That works
 * there because branding is a single row read once; `User` is queried in lists — the team screen,
 * the access review, every "assigned to" picker — and a base64 image on the row means a hundred
 * kilobytes travelling with every one of them, for a column most of those queries never render.
 * So the bytes live here and are served by `/api/users/[id]/photo`, which the browser caches like
 * any other image. `User.photoUpdatedAt` carries the only thing a list actually needs: whether
 * there is a photo at all, and a value to bust the cache with when it changes.
 */
model UserPhoto {
  userId String @id
  user   User   @relation("UserPhoto", fields: [userId], references: [id], onDelete: Cascade)

  /**
   * `data:image/...;base64,...` — same storage decision as BrandingSettings, no object store needed.
   */
  dataUrl   String
  mimeType  String
  byteSize  Int
  updatedAt DateTime @updatedAt

  @@map("user_photos")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sticky notes
// ─────────────────────────────────────────────────────────────────────────────

enum StickyNoteColor {
  YELLOW
  GREEN
  BLUE
  PINK
  PURPLE
  ORANGE
  GREY
}

/**
 * Who can read a note.
 * PRIVATE means private, including from an admin. A scratchpad that somebody else can read is not
 * a scratchpad, and a person who suspects otherwise simply stops using it — so there is deliberately
 * no permission anywhere that lifts this.
 * TEAM is the owner's department. The reporting line was the obvious alternative and is wrong here:
 * it is not symmetric. A note shared "with my team" by a manager would reach their reports, while
 * the same note from a report would not reach their peers — so the two people either side of a desk
 * get different answers to the same word. A department is one set, both ways round, and needs
 * nothing configured beyond the field already on the user.
 * An owner with no department therefore shares with nobody: TEAM collapses to PRIVATE rather than
 * pooling everyone unassigned into an accidental team. See scripts/check-notes.ts, which asserts it.
 */
enum StickyNoteVisibility {
  PRIVATE
  TEAM
  EVERYONE
}

/**
 * A note somebody wrote down.
 * Deliberately not a Task. A task is assigned, has a due date and is chased; a note is a thing you
 * did not want to forget, and the moment it needs a date and an owner it should become a task. That
 * boundary is why there is no reminder here — reminders already exist on tasks, and two half-systems
 * for "remind me" is how both end up untrusted.
 * A note can be stuck to a company, a lead or a ticket, which is what makes it more than a
 * scratchpad: "they always order in March" belongs on the account, not in somebody's head. A note
 * attached to a company is additionally hidden from anybody who cannot see that company, whatever
 * its visibility says — otherwise a note would be a way to read an account you were not given.
 */
model StickyNote {
  id      String  @id @default(cuid())
  noteSeq Int     @unique @default(autoincrement())
  title   String?
  body    String

  color      StickyNoteColor      @default(YELLOW)
  visibility StickyNoteVisibility @default(PRIVATE)
  pinned     Boolean              @default(false)
  /**
   * Manual order on the board. Lower sorts first; ties fall back to most recently updated.
   */
  position   Int                  @default(0)

  ownerUserId String
  owner       User   @relation("StickyNoteOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation("StickyNoteCompany", fields: [companyId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation("StickyNoteLead", fields: [leadId], references: [id], onDelete: Cascade)
  ticketId  String?
  ticket    Ticket?  @relation("StickyNoteTicket", fields: [ticketId], references: [id], onDelete: Cascade)

  /**
   * When to put this note back in front of its author.
   * The reminder belongs to whoever set it, not to everyone who can read the note. A shared note
   * whose reminder alerted a whole department would make every note a potential alarm for people
   * who never asked for one — and reminding a group about something is what a task assigned to
   * them is for.
   * Single-shot, deliberately. A note that needs to nag every week is a recurring task wearing
   * the wrong shape, and two systems that both half-remember things is how neither gets trusted.
   */
  remindAt DateTime?

  /**
   * Archived rather than deleted, so a note cleared off the board can still be found.
   */
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId, archivedAt])
  @@index([remindAt])
  @@index([visibility, archivedAt])
  @@index([companyId])
  @@index([leadId])
  @@index([ticketId])
  @@map("sticky_notes")
}

/**
 * Where somebody has dragged the cards on a page.
 * Deliberately not another column on `User`. The dashboard's order lives in `dashboardWidgets`
 * because that array does double duty — it is both the selection and the order — but every other
 * page only wants the order, and adding a column per page would mean a migration every time a
 * screen gains a rearrangeable card. One row per person per page costs nothing and the third page
 * to want this needs no schema change at all.
 * A key absent from `PAGE_LAYOUTS` is refused on write and ignored on read, so a renamed widget
 * leaves a stale row rather than an empty slot on somebody's screen.
 */
model PageLayout {
  userId  String
  pageKey String
  widgets String[] @default([])

  updatedAt DateTime @updatedAt

  user User @relation("UserPageLayouts", fields: [userId], references: [id], onDelete: Cascade)

  @@id(name: "user_page", [userId, pageKey])
  @@map("page_layouts")
}

/**
 * A record of one person's work being moved to colleagues.
 * Kept as its own row rather than read back out of the audit log, because the audit entry is a
 * sentence and this has to answer questions: what did she take over, who else got a share, and was
 * anything missed. It is also the only place that records a handover that moved nothing — an area
 * left as "leave as is" is a decision somebody made, and three months later "why does he still own
 * forty accounts" has an answer.
 * Written in the same transaction as the reassignment it describes. A handover that happened with
 * no record of it, or a record of one that did not happen, are both worse than neither.
 */
model Handover {
  id String @id @default(cuid())

  /**
   * Whose work moved.
   */
  fromUserId String
  fromUser   User   @relation("HandoverFrom", fields: [fromUserId], references: [id], onDelete: Cascade)

  /**
   * Who ran it. Not the same person, and frequently neither of the two it concerns.
   */
  performedById String
  performedBy   User   @relation("HandoverBy", fields: [performedById], references: [id])

  /**
   * Why, in the words of whoever did it — "maternity cover", "resigned", "Gujarat to Maharashtra".
   */
  reason String?

  createdAt DateTime @default(now())

  lines HandoverLine[]

  @@index([fromUserId])
  @@map("handovers")
}

/**
 * One area of one handover, going to one person.
 * A split produces several of these for the same area, which is exactly the shape the question
 * "who got his accounts" wants back.
 */
model HandoverLine {
  id         String   @id @default(cuid())
  handoverId String
  handover   Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  areaKey   String
  /**
   * The area's name as it read on the day.
   * Frozen rather than looked up: renaming an area in the registry, or dropping one, must not
   * silently rewrite what a handover from last March says happened.
   */
  areaLabel String

  toUserId String
  toUser   User   @relation("HandoverTo", fields: [toUserId], references: [id], onDelete: Cascade)

  count Int

  @@index([handoverId])
  @@index([toUserId])
  @@map("handover_lines")
}

// ─── Projects ───────────────────────────────────────────────────────────────────────────────────

/**
 * Where a project has got to.
 * Deliberately separate from `ProjectHealth`. "In progress" and "off track" are different facts,
 * and a single field that has to carry both is how a project stays green until the week it slips.
 */
enum ProjectStatus {
  /**
   * Scoped and quoted, not yet won.
   */
  PROPOSED
  /**
   * Won. Working out what they actually have and actually need.
   */
  DISCOVERY
  PLANNING
  IN_PROGRESS
  /**
   * With the customer to test.
   */
  UAT
  GO_LIVE
  /**
   * Live, but not yet signed off or handed to support.
   */
  HANDOVER
  COMPLETED
  /**
   * Paused by somebody's decision, and the reason belongs in an update.
   */
  ON_HOLD
  CANCELLED
}

enum ProjectHealth {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

/**
 * Why somebody is on a project.
 * Internal and customer-side roles in one list, because the question a project asks is "who is
 * involved", not "who is involved from each organisation".
 */
enum ProjectStakeholderRole {
  SPONSOR
  PROJECT_MANAGER
  TECHNICAL_LEAD
  TEAM_MEMBER
  CUSTOMER_SPONSOR
  CUSTOMER_TECHNICAL
  CUSTOMER_USER
  VENDOR
  OBSERVER
}

enum ProjectDocumentType {
  AGREEMENT
  NDA
  SOW
  PROPOSAL
  DESIGN
  SIGN_OFF
  HANDOVER
  REPORT
  OTHER
}

enum ProjectRiskKind {
  /**
   * Might happen.
   */
  RISK
  /**
   * Has happened.
   */
  ISSUE
}

enum ProjectRiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectRiskStatus {
  OPEN
  MITIGATING
  RESOLVED
  /**
   * Knowingly lived with — a decision, not a failure to act.
   */
  ACCEPTED
  CLOSED
}

enum ProjectBillingStatus {
  PENDING
  DUE
  INVOICED
  PAID
  WAIVED
}

/**
 * A kind of project, as a row rather than an enum.
 * Website development, mail migration, an implementation, a security audit, a cabling job — the
 * list is whatever this business sells, and it grows. An enum would mean a migration every time,
 * which in practice means somebody files the new work under "Other" forever.
 */
model ProjectType {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  /**
   * The milestones every project of this kind starts with.
   */
  templateMilestones ProjectTemplateMilestone[]
  projects           Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_types")
}

/**
 * One step in a project type's standard plan.
 * A mail migration is the same twelve steps every time, and retyping them is how the thirteenth
 * gets forgotten. `dayOffset` is from the project's start date, so applying a template to a project
 * that starts in March produces March dates.
 */
model ProjectTemplateMilestone {
  id     String      @id @default(cuid())
  typeId String
  type   ProjectType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  name      String
  note      String?
  dayOffset Int     @default(0)
  sortOrder Int     @default(0)

  @@index([typeId])
  @@map("project_template_milestones")
}

/**
 * A piece of delivered work for a customer.
 * ## Who can see one
 * Stakeholders only — see `visibleProjectsWhere`. That is stricter than leads or tickets, and
 * deliberately: an implementation reveals a customer's internal systems, their headcount, and
 * frequently their credentials. Being on the stakeholder list is what grants sight of it, which is
 * what makes maintaining that list worth somebody's time.
 * The manager and whoever created it are stakeholders automatically, so a project can never be
 * created into a state nobody can open.
 */
model Project {
  id   String @id @default(cuid())
  /**
   * Human reference, e.g. PRJ-2026-0041. Unique, and quoted in email.
   */
  code String @unique

  companyId String
  company   Company @relation("ProjectCompany", fields: [companyId], references: [id], onDelete: Cascade)

  typeId String?
  type   ProjectType? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  name        String
  description String?

  status ProjectStatus @default(PROPOSED)
  health ProjectHealth @default(ON_TRACK)

  startDate     DateTime?
  /**
   * What was promised. Kept even after it slips — a target nobody can see missing is not a target.
   */
  targetEndDate DateTime?
  actualEndDate DateTime?

  managerId String?
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  /**
   * The order this work was sold on, when there is one.
   */
  companyProductId String?
  companyProduct   CompanyProduct? @relation("ProjectOrder", fields: [companyProductId], references: [id], onDelete: SetNull)

  /**
   * Contract value, in the books' currency. Billing milestones are drawn against it.
   */
  value Decimal? @db.Decimal(14, 2)

  createdById String
  createdBy   User     @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stakeholders      ProjectStakeholder[]
  documents         ProjectDocument[]
  credentials       ProjectCredential[]
  milestones        ProjectMilestone[]
  billingMilestones ProjectBillingMilestone[]
  risks             ProjectRisk[]
  updates           ProjectUpdate[]
  tasks             Task[]                    @relation("TaskProject")

  @@index([companyId])
  @@index([managerId])
  @@index([status])
  @@map("projects")
}

/**
 * Somebody involved in a project.
 * Exactly one of `userId` and `contactId` is set: a colleague, or somebody at the customer. Both
 * belong on the same list because "who is on this project" is one question, and splitting it into
 * two tables means every screen joins them back together again.
 * A row with a `userId` is also the visibility grant. That is the whole design.
 */
model ProjectStakeholder {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("ProjectStakeholderUser", fields: [userId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation("ProjectStakeholderContact", fields: [contactId], references: [id], onDelete: Cascade)

  role ProjectStakeholderRole @default(TEAM_MEMBER)
  note String?

  addedById String?
  addedBy   User?    @relation("ProjectStakeholderAddedBy", fields: [addedById], references: [id])
  createdAt DateTime @default(now())

  // One row per person per project. Adding somebody twice in two roles would double them on every
  // list and make the visibility query lie about who has access.
  @@unique([projectId, userId])
  @@unique([projectId, contactId])
  @@index([userId])
  @@map("project_stakeholders")
}

/**
 * An agreement, an NDA, a scope document, a signed acceptance. Same storage as HR documents.
 */
model ProjectDocument {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type ProjectDocumentType @default(OTHER)
  name String
  note String?

  /**
   * The file itself, base64 in a data URL — see EmployeeDocument for why.
   */
  fileDataUrl String
  mimeType    String
  sizeBytes   Int

  uploadedById String?
  uploadedBy   User?    @relation("ProjectDocumentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([projectId])
  @@map("project_documents")
}

/**
 * A credential the customer has given us, or one we hold on their behalf.
 * ## What this protects against, and what it does not
 * The secret is encrypted at rest with `encryptSecret` — AES-256-GCM, keyed from `AUTH_SECRET`.
 * That defeats a database dump, a stolen backup, and anybody reading the table directly. It does
 * **not** defeat somebody with access to the running server, who has the key. This is the same
 * standing as the e-invoice credentials, and it is a real improvement on a shared spreadsheet, but
 * it is not a vault and nothing here should pretend otherwise.
 * `secretCipher` is never selected into a list query and never returned to a client except through
 * `revealCredential`, which requires the viewer's own password, writes a `CredentialReveal` row and
 * tells the project manager.
 */
model ProjectCredential {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /**
   * What it is for — "cPanel", "Microsoft 365 global admin", "Router 192.168.1.1".
   */
  label    String
  /**
   * Not a secret, and useful on its own — shown unmasked.
   */
  username String?
  url      String?
  note     String?

  secretCipher String

  /**
   * Prompts a rotation after a handover or somebody leaving.
   */
  rotatedAt DateTime?
  expiresAt DateTime?

  createdById String?
  createdBy   User?    @relation("ProjectCredentialCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reveals CredentialReveal[]

  @@index([projectId])
  @@map("project_credentials")
}

/**
 * Every time somebody looked at a stored secret.
 * Its own table rather than only an audit entry, so the credential screen can answer "who has seen
 * this" in place — which is the question asked when deciding whether a password needs changing
 * after somebody leaves. Rows are never deleted while the credential exists.
 */
model CredentialReveal {
  id           String            @id @default(cuid())
  credentialId String
  credential   ProjectCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("CredentialRevealedBy", fields: [userId], references: [id], onDelete: Cascade)

  at DateTime @default(now())

  @@index([credentialId])
  @@index([userId])
  @@map("credential_reveals")
}

/**
 * A phase or checkpoint. What a progress percentage is computed from, rather than guessed at.
 */
model ProjectMilestone {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String
  note      String?
  dueDate   DateTime?
  sortOrder Int       @default(0)

  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("MilestoneCompletedBy", fields: [completedById], references: [id])

  @@index([projectId])
  @@map("project_milestones")
}

/**
 * A stage at which something becomes billable.
 * 30% advance, 40% on UAT, 30% on sign-off. Linked to the document actually raised for it, so
 * "what have we billed on this project" is answerable next to the work rather than by cross-
 * referencing the ledger.
 */
model ProjectBillingMilestone {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  label   String
  /**
   * Share of the contract value, when it was agreed as a percentage. Informational.
   */
  percent Decimal?  @db.Decimal(5, 2)
  amount  Decimal   @db.Decimal(14, 2)
  dueOn   DateTime?

  status ProjectBillingStatus @default(PENDING)

  /**
   * The invoice or proforma raised for this stage.
   */
  documentId String?
  document   TradeDocument? @relation("BillingMilestoneDocument", fields: [documentId], references: [id], onDelete: SetNull)

  sortOrder Int @default(0)

  @@index([projectId])
  @@map("project_billing_milestones")
}

/**
 * Something that might go wrong, or already has. What a project review meeting runs on.
 */
model ProjectRisk {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind     ProjectRiskKind     @default(RISK)
  title    String
  detail   String?
  severity ProjectRiskSeverity @default(MEDIUM)
  status   ProjectRiskStatus   @default(OPEN)

  /**
   * What is being done about it. Empty on an open risk is itself worth seeing.
   */
  mitigation String?

  ownerId String?
  owner   User?   @relation("ProjectRiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  raisedById String?
  raisedBy   User?     @relation("ProjectRiskRaisedBy", fields: [raisedById], references: [id])
  raisedOn   DateTime  @default(now())
  resolvedOn DateTime?

  @@index([projectId])
  @@map("project_risks")
}

/**
 * Whose account this actually is.
 * The distinction matters on the day somebody asks it, and it is always the same day: a client
 * leaves, and the question is which of these passwords go with them. It also changes what may be
 * done with one — rotating our own registrar password is housekeeping, rotating a client's is
 * something you ring them about first.
 */
enum VaultOwnership {
  /**
   * The company's own. Ours to change, ours to lose.
   */
  OURS
  /**
   * Held on a customer's behalf. Theirs, and we are looking after it.
   */
  CLIENT
}

/**
 * A written update, kept as a history.
 * The health at the time is stored on the row rather than read from the project, so a run of
 * updates reads as a narrative — "amber for three weeks, then red" — instead of every past update
 * silently adopting today's colour.
 */
model ProjectUpdate {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  body   String
  health ProjectHealth @default(ON_TRACK)

  authorId String?
  author   User?    @relation("ProjectUpdateAuthor", fields: [authorId], references: [id])
  at       DateTime @default(now())

  @@index([projectId])
  @@map("project_updates")
}

// ─── Credential vault ───────────────────────────────────────────────────────────────────────────

/**
 * What a share lets its recipient do. Chosen per share by whoever grants it.
 */
enum VaultAccessLevel {
  /**
   * Open the secret. Nothing else.
   */
  VIEW
  /**
   * Also edit, rotate, and share it onward. A co-owner in everything but name.
   */
  MANAGE
}

/**
 * How somebody was entitled to open a secret, recorded on every reveal.
 * Kept because "who opened this" is a weaker question than it looks: an owner opening their own
 * password and an admin opening somebody else's are the same row otherwise, and only one of them
 * is worth anybody's attention.
 */
enum VaultRevealVia {
  OWNER
  SHARE
  DEPARTMENT
  ADMIN
}

/**
 * Which secret on the record was opened. A recovery key is not a password.
 */
enum VaultField {
  PASSWORD
  RECOVERY_KEY
}

enum CredentialTagKind {
  /**
   * What service it is — Hosting, Domain, Partner portal, Government, Banking.
   */
  CATEGORY
  /**
   * What kind of access it grants — Admin, User, Billing, cPanel, API.
   */
  ACCESS_TYPE
}

/**
 * The two lists a credential is filed under, in one table.
 * One table rather than two because they are the same shape and the same settings screen, and the
 * alternative is two near-identical models that drift. Rows rather than enums because both lists
 * grow — the moment somebody signs up for a new kind of portal, an enum means a migration.
 */
model CredentialTag {
  id        String            @id @default(cuid())
  kind      CredentialTagKind
  name      String
  sortOrder Int               @default(0)
  active    Boolean           @default(true)

  createdAt DateTime @default(now())

  categoryOf   VaultCredential[] @relation("CredentialCategory")
  accessTypeOf VaultCredential[] @relation("CredentialAccessType")

  @@unique([kind, name])
  @@map("credential_tags")
}

/**
 * A login this company holds — a registrar, a hosting panel, a partner portal, a tax account.
 * ## How this differs from ProjectCredential
 * That one is a customer's system, held for the duration of an engagement and visible to the
 * project's stakeholders. This is the company's own estate: it belongs to a person, it is shared
 * deliberately, and it outlives any project.
 * ## What is encrypted, and what that buys
 * `secretCipher` and `recoveryKeyCipher` are AES-256-GCM, keyed from `AUTH_SECRET`. The recovery
 * key is encrypted separately and revealed separately, because it is the more dangerous of the two
 * — a password can be rotated after it leaks, and a recovery key is what somebody uses to take the
 * account away from you.
 * This defeats a database dump, a stolen backup, and anybody reading the table. It does not defeat
 * somebody with access to the running server, who holds the key. Nothing here should pretend
 * otherwise.
 * ## secretDigest
 * A keyed HMAC, so two rows holding the same password produce the same digest and nothing about
 * the digest reveals what that password is. It exists to answer "is this reused", which is how one
 * leaked password becomes five compromised accounts.
 */
model VaultCredential {
  id String @id @default(cuid())

  /**
   * What somebody would call it out loud — "GoDaddy — wroffy.com", "SBI current account".
   */
  loginName String

  categoryId String?
  category   CredentialTag? @relation("CredentialCategory", fields: [categoryId], references: [id], onDelete: SetNull)

  accessTypeId String?
  accessType   CredentialTag? @relation("CredentialAccessType", fields: [accessTypeId], references: [id], onDelete: SetNull)

  username String?
  email    String?
  loginUrl String?
  /**
   * The number a two-step code goes to. Useless without the password, and useless to withhold.
   */
  phone    String?

  secretCipher      String
  secretDigest      String
  recoveryKeyCipher String?

  remarks String?

  /**
   * When the subscription behind this login lapses — a domain, a licence, a hosting plan.
   */
  billingExpiry DateTime?

  /**
   * Set whenever the stored secret actually changes, which is what makes "last changed" true.
   */
  passwordChangedAt DateTime?
  /**
   * Recommend a change after this many days. Null means nobody has an opinion.
   */
  rotateAfterDays   Int?

  /**
   * A deadline set by something that happened, rather than by the standing policy above.
   * The case it exists for is somebody leaving: their passwords are now known to a person who no
   * longer works here, and that is true whether or not the record was otherwise due. Folding it
   * into `rotateAfterDays` would mean editing the record's own policy to record a one-off fact,
   * and nobody reading it later could tell which was which.
   */
  rotateBy     DateTime?
  /**
   * Why, in words. "Change this by Friday" with no reason is a notification people mute.
   */
  rotateReason String?

  /**
   * Deleted, but not yet gone.
   * A stored password is the one thing in this system where an accidental delete cannot be undone
   * by asking somebody what it was — the plaintext existed nowhere else. So deleting archives, and
   * the archive is destroyed on a clock rather than kept forever: a shadow copy of every password
   * the company has ever used, sitting where nobody looks, is a worse outcome than the mistake it
   * was meant to protect against.
   * Archived records are excluded from every list, every reveal and every share. They exist for
   * the admin who has to put one back.
   */
  archivedAt    DateTime?
  archivedById  String?
  archivedBy    User?     @relation("VaultArchivedBy", fields: [archivedById], references: [id])
  /**
   * What they said when they deleted it. The first question on restoring one is "why did this go".
   */
  archiveReason String?

  ownership VaultOwnership @default(OURS)
  /**
   * Which client, when it is theirs. Optional even for a client credential, because somebody
   * recording one in a hurry should not be stopped by a company record that does not exist yet.
   */
  companyId String?
  company   Company?       @relation("VaultCredentialCompany", fields: [companyId], references: [id], onDelete: SetNull)

  /**
   * Whose record it is. They see every share and every reveal on it.
   */
  ownerId String
  owner   User   @relation("VaultOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?    @relation("VaultCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shares  VaultShare[]
  reveals VaultReveal[]
  pins    VaultPin[]

  @@index([ownerId])
  @@index([secretDigest])
  @@index([archivedAt])
  @@map("vault_credentials")
}

/**
 * Somebody else who may open this.
 * Exactly one of `userId` and `departmentId` is set. A department share is a standing grant: people
 * joining that department inherit it, which is convenient for a support team's shared logins and is
 * precisely why the owner is shown the department by name rather than the resulting head count.
 */
model VaultShare {
  id           String          @id @default(cuid())
  credentialId String
  credential   VaultCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("VaultSharedWith", fields: [userId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation("VaultSharedWithDepartment", fields: [departmentId], references: [id], onDelete: Cascade)

  level VaultAccessLevel @default(VIEW)

  sharedById String?
  sharedBy   User?     @relation("VaultSharedBy", fields: [sharedById], references: [id])
  createdAt  DateTime  @default(now())
  /**
   * Optional: access that lapses on its own is access nobody has to remember to take away.
   */
  expiresAt  DateTime?

  @@unique([credentialId, userId])
  @@unique([credentialId, departmentId])
  @@index([userId])
  @@index([departmentId])
  @@map("vault_shares")
}

/**
 * Somebody's own shortlist.
 * A pin is a fact about the person, not about the credential: the registrar login is the one
 * thing the domains person touches weekly and the one thing nobody in accounts ever opens, and a
 * single shared ordering cannot be right for both. So it is keyed on the pair, and one person
 * pinning something is invisible to everybody else.
 * Deliberately not a column on the credential. `isPinned` there would be a global flag that the
 * first person to use it quietly sets for the whole company.
 * It confers nothing. Pinning a record you can see does not keep it visible if the share that let
 * you see it is withdrawn — the list is filtered first and ordered second, never the reverse.
 */
model VaultPin {
  userId String
  user   User   @relation("VaultPinnedBy", fields: [userId], references: [id], onDelete: Cascade)

  credentialId String
  credential   VaultCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  at DateTime @default(now())

  @@id([userId, credentialId])
  @@index([userId])
  @@map("vault_pins")
}

/**
 * Every time a stored secret was opened.
 * Never deleted while the credential exists. This is the record that answers the only question
 * that matters after somebody leaves or a breach is suspected: what did they have sight of, and
 * therefore what has to be changed.
 */
model VaultReveal {
  id           String          @id @default(cuid())
  credentialId String
  credential   VaultCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("VaultRevealedBy", fields: [userId], references: [id], onDelete: Cascade)

  via   VaultRevealVia
  field VaultField     @default(PASSWORD)
  at    DateTime       @default(now())

  @@index([credentialId])
  @@index([userId])
  @@map("vault_reveals")
}

// ─── Anonymous feedback, forms and polls ────────────────────────────────────────────────────────

enum InternalFeedbackKind {
  PRAISE
  CONCERN
  SUGGESTION
  GRIEVANCE
  OTHER
}

enum SurveyKind {
  /**
   * Several questions. An engagement survey, a form to collect something.
   */
  FORM
  /**
   * One question, several options.
   */
  POLL
  /**
   * One question, and the result decides something.
   */
  VOTE
}

enum SurveyStatus {
  DRAFT
  OPEN
  CLOSED
}

enum SurveyAudience {
  EVERYONE
  DEPARTMENT
  INDIVIDUAL
}

enum SurveyQuestionKind {
  RATING
  SCALE_1_10
  SINGLE_CHOICE
  MULTI_CHOICE
  YES_NO
  TEXT
}

/**
 * Feedback written by somebody who is not recorded.
 * ## There is no author column, and that is the entire design
 * Not a nullable one that happens to be empty — none. Nothing in this table, in any index on it, or
 * in any row written alongside it, says who wrote an entry. The rate limit that stops one person
 * flooding the channel lives in `FeedbackQuota`, which counts submissions per person per day and
 * holds no content, so the two can be kept and neither can be joined to the other.
 * That is the paper ballot arrangement: the roll marks you off, the ballot goes in the box, and the
 * two are never brought together.
 * ## submittedOn is a date, not a timestamp
 * Deliberately. A timestamp accurate to the second, against a company of forty people, is an
 * identifier — it correlates with a login, a door swipe, an idle-time record. A date is enough to
 * sort by and too coarse to single anybody out.
 * ## What this cannot protect against
 * What somebody writes. A person describing an argument only four people witnessed has identified
 * themselves regardless of what this table stores, and the submission screen says so plainly rather
 * than letting them find out afterwards.
 */
model InternalFeedback {
  id String @id @default(cuid())

  kind InternalFeedbackKind @default(OTHER)

  /**
   * Optional: feedback can be about a person or about the company.
   */
  aboutUserId String?
  aboutUser   User?   @relation("FeedbackAboutSubject", fields: [aboutUserId], references: [id], onDelete: SetNull)

  /**
   * One to five, when the writer gave one.
   */
  rating Int?
  body   String

  /**
   * Date only — see above. No time, ever.
   */
  submittedOn DateTime @db.Date

  /**
   * HR marking an item as dealt with. Says nothing about who wrote it.
   */
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("FeedbackReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?

  @@index([submittedOn])
  @@index([aboutUserId])
  @@map("internal_feedback")
}

/**
 * How many anonymous items somebody has sent today.
 * The roll, not the ballot. It exists so one person cannot flood the channel, and it holds no
 * content whatsoever — a count and a date. Kept deliberately separate from `InternalFeedback` and
 * never joined to it; if these two tables were ever brought together the feature would be over.
 */
model FeedbackQuota {
  userId String
  onDate DateTime @db.Date
  count  Int      @default(0)

  user User @relation("FeedbackQuotaUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id(name: "user_day", [userId, onDate])
  @@map("feedback_quotas")
}

/**
 * A form, a poll or a vote.
 * `anonymous` is a promise made to the people filling it in, and it is kept structurally: see
 * `SurveyResponse`, which has no respondent column, and `SurveyParticipation.responseId`, which is
 * the only link between a person and their answers and is written **only** when this flag is false.
 */
model Survey {
  id          String     @id @default(cuid())
  kind        SurveyKind @default(FORM)
  title       String
  description String?

  /**
   * Stated on the form itself, because a respondent deciding how frankly to answer needs to know.
   */
  anonymous Boolean @default(true)

  /**
   * Covers the screen on next sign-in, skippable once per session until it is done.
   */
  mandatory Boolean @default(false)

  audience SurveyAudience @default(EVERYONE)
  status   SurveyStatus   @default(DRAFT)

  opensAt   DateTime?
  /**
   * After this it accepts nothing, whatever its status says.
   */
  expiresAt DateTime?

  createdById String
  createdBy   User     @relation("SurveyCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions      SurveyQuestion[]
  targets        SurveyTarget[]
  participations SurveyParticipation[]
  responses      SurveyResponse[]

  @@index([status])
  @@map("surveys")
}

model SurveyQuestion {
  id       String             @id @default(cuid())
  surveyId String
  survey   Survey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  kind     SurveyQuestionKind @default(SINGLE_CHOICE)

  prompt   String
  helpText String?
  required Boolean  @default(true)
  /**
   * For the choice kinds. Empty otherwise.
   */
  options  String[] @default([])

  sortOrder Int @default(0)

  answers SurveyAnswer[]

  @@index([surveyId])
  @@map("survey_questions")
}

/**
 * Who a DEPARTMENT or INDIVIDUAL survey is for. Unused when the audience is EVERYONE.
 */
model SurveyTarget {
  id       String @id @default(cuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("SurveyTargetUser", fields: [userId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation("SurveyTargetDepartment", fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([surveyId, userId])
  @@unique([surveyId, departmentId])
  @@map("survey_targets")
}

/**
 * The electoral roll: that this person responded, not what they said.
 * Needed for three honest reasons — stopping a second submission, chasing the people who have not
 * answered, and knowing whether to show somebody the splash screen. None of those require knowing
 * anybody's answers.
 * `responseId` is the single exception and the single risk. It is written only when the survey is
 * openly attributed (`anonymous = false`), and `check:engagement` asserts it is null for every
 * participation in an anonymous survey. If that assertion ever fails, the feature is broken in the
 * one way that matters.
 */
model SurveyParticipation {
  id       String @id @default(cuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("SurveyParticipant", fields: [userId], references: [id], onDelete: Cascade)

  respondedAt DateTime?
  /**
   * They pushed the splash screen away. It comes back next session.
   */
  skippedAt   DateTime?

  /**
   * Null on every anonymous survey. See above.
   */
  responseId String?         @unique
  response   SurveyResponse? @relation(fields: [responseId], references: [id], onDelete: SetNull)

  @@unique([surveyId, userId])
  @@index([userId])
  @@map("survey_participations")
}

/**
 * The ballot.
 * No respondent column, no IP, no user agent, no created-at timestamp — only the date. Everything
 * that could tie this row to a person has been left out rather than left empty.
 */
model SurveyResponse {
  id       String @id @default(cuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  /**
   * Date only, for the same reason as InternalFeedback.
   */
  submittedOn DateTime @db.Date

  answers       SurveyAnswer[]
  participation SurveyParticipation?

  @@index([surveyId])
  @@map("survey_responses")
}

model SurveyAnswer {
  id         String         @id @default(cuid())
  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /**
   * Ratings, scales and yes/no (1 or 0).
   */
  number  Int?
  text    String?
  /**
   * Chosen options, by their text — so a later edit to the question cannot rewrite an answer.
   */
  choices String[] @default([])

  @@index([responseId])
  @@index([questionId])
  @@map("survey_answers")
}

// ─── Visitor management ─────────────────────────────────────────────────────────────────────────

enum VisitorPurpose {
  MEETING
  INTERVIEW
  DELIVERY
  VENDOR
  OTHER
}

enum VisitorStatus {
  /**
   * Signed in at reception, not yet left.
   */
  IN
  OUT
  /**
   * Signed in and never signed out, closed automatically at end of day.
   */
  ABANDONED
}

/**
 * A tablet at a reception desk.
 * ## The token is the authentication
 * There is no login on a reception tablet — a receptionist is not going to sign in for every
 * visitor, and a shared account left signed in on a device in a lobby is worse than no account.
 * So the URL carries 192 bits of randomness and that is the whole of it, the same arrangement the
 * feedback and preference links already use.
 * ## What a leaked URL would expose
 * The staff list: names and departments, so a visitor can say who they are here to see. No email,
 * no phone, no designation, nothing about customers. That is a real disclosure and worth stating
 * plainly rather than discovering — which is why the token can be rotated from Settings, and why
 * rotating it is one click.
 */
model VisitorKiosk {
  id    String @id @default(cuid())
  /**
   * "Main reception", "Factory gate" — appears on the tablet and on every entry it takes.
   */
  name  String
  token String @unique

  active Boolean @default(true)

  /**
   * Set on every check-in, so a tablet that has stopped working is visible rather than assumed fine.
   */
  lastUsedAt DateTime?

  /**
   * Wrong invite codes typed at this desk, and when the current window started.
   * A visitor mistypes once; somebody working through the keyspace does not. Kept on the kiosk
   * rather than in memory so it survives a restart, which is exactly when a limiter is most
   * useful to whoever is probing it.
   */
  failedLookups Int       @default(0)
  failedSince   DateTime?

  createdById String?
  createdBy   User?    @relation("KioskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  entries VisitorEntry[]

  @@map("visitor_kiosks")
}

/**
 * Somebody who came to the building.
 * Deliberately not a `Contact` or a `Candidate`. A visitor is a person at a door, and most of them
 * are neither a customer contact nor an applicant — a courier, a candidate's parent, an auditor.
 * Forcing them into one of the existing tables would pollute the CRM with rows nobody wants to see
 * in a company list.
 */
model VisitorEntry {
  id      String        @id @default(cuid())
  kioskId String?
  kiosk   VisitorKiosk? @relation(fields: [kioskId], references: [id], onDelete: SetNull)

  purpose VisitorPurpose @default(MEETING)

  /**
   * Who they came to see. One of these is set; a department alone is fine for "anyone in Accounts".
   */
  hostUserId String?
  host       User?   @relation("VisitorHost", fields: [hostUserId], references: [id], onDelete: SetNull)

  departmentId String?
  department   Department? @relation("VisitorDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  name             String
  phone            String
  /**
   * The company as it was typed, and the row it resolved to.
   * Both nullable at the database level even though the form now demands them: entries taken
   * before that rule existed are history, and a validation change should not rewrite what happened.
   * The rule is enforced in `checkIn`, which is the only thing that writes new ones.
   */
  company          String?
  visitorCompanyId String?
  visitorCompany   VisitorCompany? @relation("EntryVisitorCompany", fields: [visitorCompanyId], references: [id], onDelete: SetNull)
  email            String?
  /**
   * What it is about, in the visitor's own words.
   */
  note             String?

  /**
   * A photo taken at the desk, base64 in a data URL — the same storage as HR documents.
   * Optional, and the form says why it is being asked for rather than simply demanding it. A
   * photograph of a member of the public taken without explanation is a different thing from one
   * taken with it.
   */
  photoDataUrl String?

  /**
   * Taken by the system at the desk, not typed. A self-reported arrival time is not a record.
   */
  checkedInAt  DateTime      @default(now())
  checkedOutAt DateTime?
  status       VisitorStatus @default(IN)

  /**
   * Set when reception or the host closed it rather than the visitor.
   */
  closedById String?
  closedBy   User?   @relation("VisitorClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  /**
   * A short number for a paper badge — unique within a day, not forever.
   */
  badgeNo Int?

  companions VisitorCompanion[]
  /**
   * Set when this visit was pre-registered rather than walked in.
   */
  invite     VisitorInvite?     @relation("EntryFromInvite")

  @@index([checkedInAt])
  @@index([hostUserId])
  @@index([status])
  @@map("visitor_entries")
}

/**
 * Somebody who came in with them. Name only by default — they are not the one with the meeting.
 */
model VisitorCompanion {
  id      String       @id @default(cuid())
  entryId String
  entry   VisitorEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  name         String
  photoDataUrl String?

  @@index([entryId])
  @@map("visitor_companions")
}

enum VisitorInviteStatus {
  PENDING
  ARRIVED
  CANCELLED
  /**
   * The day passed and nobody came. Set by the sweep, not by anybody's memory.
   */
  EXPIRED
}

/**
 * A visitor a host is expecting.
 * ## The code, and why it is shaped the way it is
 * It gets read out over the phone and typed on a tablet by somebody holding a bag, so it is eight
 * characters from an alphabet with no `0/O/1/I/L` in it. That is about 10^12 combinations, which
 * would still be worth brute-forcing if a lookup returned a name — so two other things bound it:
 * a code only resolves on the day it is for (and the morning after), and failed lookups are
 * counted per desk and cut off. See `lookupInvite`.
 * ## What it is not
 * Not an access credential. It skips re-typing details somebody already gave, and nothing else —
 * arriving with a valid code still produces an ordinary visitor entry, still notifies the host, and
 * still leaves the person standing at a desk in front of a receptionist.
 */
model VisitorInvite {
  id   String @id @default(cuid())
  code String @unique

  purpose VisitorPurpose @default(MEETING)

  hostUserId String
  host       User   @relation("InviteHost", fields: [hostUserId], references: [id], onDelete: Cascade)

  name    String
  phone   String?
  email   String?
  company String?
  note    String?

  /**
   * When they are due. The code works on this date and the following morning.
   */
  expectedAt DateTime

  /**
   * How many are coming with them, so reception is not surprised by a party of six.
   */
  expectedCompanions Int @default(0)

  status VisitorInviteStatus @default(PENDING)

  /**
   * The visit it became. Set once, when they actually turn up.
   */
  entryId String?       @unique
  entry   VisitorEntry? @relation("EntryFromInvite", fields: [entryId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?    @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hostUserId])
  @@index([expectedAt])
  @@index([status])
  @@map("visitor_invites")
}

enum VisitorCompanySource {
  /**
   * Typed at a reception desk by somebody who came in.
   */
  VISITOR
  /**
   * Brought across from the CRM's own vendor list.
   */
  VENDOR
  /**
   * Added by hand in Settings.
   */
  MANUAL
}

/**
 * The companies visitors say they are from.
 * ## Why this is not the `Company` table
 * The kiosk searches this, and the kiosk is unauthenticated. Pointing it at `Company` would let
 * anybody holding the tablet link type two letters and read back our customer list — the single
 * most valuable thing in this database. This table holds only vendors somebody deliberately brought
 * across and names visitors have typed themselves, which is a far smaller thing to expose and one
 * the people it concerns have already volunteered.
 * Even so the search is bounded: two characters minimum, eight results, and no way to ask for all
 * of them. See `searchVisitorCompanies`.
 * ## Why it accumulates
 * Visitors come back. The fourth time somebody arrives from Northwind, reception should not be
 * choosing between four spellings of it — so a name typed once becomes a name offered thereafter,
 * matched on a normalised form so "Acme Ltd." and "acme ltd" are the same row.
 */
model VisitorCompany {
  id   String @id @default(cuid())
  name String

  /**
   * Lowercased, punctuation and the usual suffixes stripped — see `normaliseCompany`.
   * Unique, which is what stops the list filling with near-duplicates.
   */
  normalizedName String @unique

  source VisitorCompanySource @default(VISITOR)

  /**
   * Set when this came across from the CRM, so a re-import updates rather than duplicates.
   */
  companyId String?
  company   Company? @relation("VisitorCompanyOrigin", fields: [companyId], references: [id], onDelete: SetNull)

  /**
   * How often somebody has arrived from here, so the common ones can sort first.
   */
  visitCount Int       @default(0)
  lastSeenAt DateTime?

  /**
   * Off means it stays on old entries but is no longer offered at the desk.
   */
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries VisitorEntry[] @relation("EntryVisitorCompany")

  @@index([visitCount])
  @@map("visitor_companies")
}

// ─── Backups ──────────────────────────────────────────────────────────────────

enum BackupStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/**
 * How a backup is stored, which is really a question about what it depends on.
 * `pg_dump` has no incremental mode — both kinds below are complete snapshots of the whole
 * database, and both restore on their own. What differs is where the bytes live.
 */
enum BackupKind {
  /**
   * One standalone file. Copy it off the machine and it is complete: nothing else is needed to
   * restore it, which is what makes it the one to take offsite.
   */
  FULL

  /**
   * Split into content-addressed pieces shared with every other chunked backup, so a run stores
   * only what changed since the last one. Still a full snapshot — its manifest names every piece it
   * needs — but the pieces live in the shared store, so a copy of the manifest alone restores
   * nothing. Offsite copies have to take the whole backup folder.
   */
  INCREMENTAL
}

/**
 * One run of pg_dump, and everything needed to decide whether it can be restored.
 * The row exists before the dump finishes, so a run that dies half way leaves a `RUNNING` record
 * rather than no record at all — a backup log that only shows successes is one that cannot tell
 * you the nightly job has been failing since March.
 * ## Why the fingerprint is here
 * Ten kinds of column in this database are encrypted with a key derived from `AUTH_SECRET`: the
 * vault, e-invoice and M365 credentials, two-factor secrets. A dump restored to an instance with a
 * different secret comes back with every one of them intact and undecryptable — the restore
 * reports success and the vault is gone. So each backup records a fingerprint of the secret it was
 * taken under, and the restore refuses when it does not match.
 * It is an HMAC of a fixed string under the secret, never the secret: the point is to compare two
 * instances, not to be able to read one.
 */
model Backup {
  id String @id @default(cuid())

  /**
   * The file on disk. Stored as a name plus its directory so a moved folder does not orphan the row.
   */
  filename  String
  directory String

  status      BackupStatus @default(RUNNING)
  kind        BackupKind   @default(FULL)
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  /**
   * The size of the snapshot — what a restore of this backup produces.
   * The same number for both kinds, so the two are comparable in the log.
   */
  sizeBytes   BigInt?
  /**
   * What this run actually added to disk.
   * Equal to `sizeBytes` for a FULL backup. For an INCREMENTAL it is only the pieces that were not
   * already stored, which is the number that makes "incremental" mean something on the screen —
   * and the number that goes down as backups get more alike, rather than up.
   */
  storedBytes BigInt?
  /**
   * Whatever pg_dump said when it failed. Kept verbatim — a paraphrased error is not a clue.
   */
  error       String?

  /**
   * The migration the schema was on. A dump cannot be restored into a database whose code has
   * since moved on without somebody deciding that is what they want.
   */
  schemaVersion     String?
  /**
   * See the note above. Compared on restore, never displayed in full.
   */
  secretFingerprint String?
  /**
   * Which tool actually ran: the host's pg_dump, or the one inside the container.
   */
  via               String?

  /**
   * Null when a scheduled run took it, rather than a person.
   */
  triggeredById String?
  triggeredBy   User?   @relation("BackupTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([startedAt])
  @@index([status])
  @@map("backups")
}

/**
 * When the backup runs by itself.
 * A singleton, like the other settings rows. The hour and minute are the *authoritative* schedule:
 * whatever drives the tick — a scheduled task, a cron, a pinger — is meant to be dumb and frequent,
 * and this row decides whether any given knock is the one that takes a backup. That way changing
 * the time is something somebody does on a settings page rather than in Task Scheduler, and it can
 * be changed by whoever holds the permission rather than whoever has the server.
 */
model BackupSchedule {
  id      String  @id @default("global")
  enabled Boolean @default(false)

  /**
   * Local time on the machine that runs the backup. See `src/lib/backup/schedule.ts`.
   */
  hour   Int @default(2)
  minute Int @default(0)

  /**
   * Overrides the defaults in policy.ts when set. Null means "whatever the code says".
   */
  keepDays    Int?
  keepMinimum Int?

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("BackupScheduleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("backup_schedule")
}

// ---------------------------------------------------------------------------------------------
// Vendor reconciliation — what the distributor billed us against what we actually sold
// ---------------------------------------------------------------------------------------------

/**
 * How a statement's lines are billed, which is the only way to compare a cost meaningfully.
 * A monthly NCE line bills a twelfth of what the subscription's `purchasePrice` records for the
 * full term. Without knowing which, every price comparison is noise — either everything looks wrong
 * by a factor of twelve, or the check is dropped and real overbilling goes through.
 */
enum StatementBilling {
  MONTHLY
  ANNUAL
  ONE_OFF
}

/**
 * One file from one distributor, covering one period.
 */
model VendorStatement {
  id String @id @default(cuid())

  vendorId String
  vendor   Company @relation("VendorStatementVendor", fields: [vendorId], references: [id], onDelete: Cascade)

  /**
   * "Ingram — September 2026". Free text, because that is how somebody will look for it.
   */
  label       String
  periodStart DateTime
  periodEnd   DateTime
  billing     StatementBilling @default(MONTHLY)
  currency    String           @default("INR")

  /**
   * The file it came from, or null when somebody typed the lines in.
   */
  filename String?

  /**
   * Whether this is everything the vendor billed for the period.
   * It decides whether an absence means anything. On a complete statement, one of our live orders
   * not appearing is a finding — the vendor has stopped charging for a subscription we are still
   * selling. On a few lines somebody typed to check one thing, every other order is missing by
   * construction, and reporting them buries the one line they came to look at.
   */
  complete Boolean @default(true)

  /**
   * Frozen at import, not recomputed.
   * What the statement said on the day it arrived is the thing being reconciled against. Recomputing
   * these from the lines would quietly follow any later edit and the disagreement — the entire point
   * of the record — would heal itself.
   */
  lineCount   Int
  totalBilled Decimal @db.Decimal(14, 2)

  notes String?

  uploadedAt   DateTime @default(now())
  uploadedById String?
  uploadedBy   User?    @relation("VendorStatementUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  lines VendorStatementLine[]

  @@index([vendorId, periodStart])
  @@map("vendor_statements")
}

/**
 * What the reconciler concluded about one line.
 * Every state is a different thing for a person to do, which is why there are eight rather than
 * "matched" and "not matched". `UNKNOWN_SKU` is a catalogue job, `BILLED_NOT_SOLD` is money going
 * out with nothing coming in, and `SOLD_NOT_BILLED` usually means a subscription that was never
 * actually provisioned. Collapsing them would put all three in one undifferentiated pile.
 */
enum ReconcileState {
  /**
   * Quantity and cost both agree with the order.
   */
  MATCHED
  /**
   * Billed for a different number of seats than the order records.
   */
  QUANTITY_MISMATCH
  /**
   * Billed at a different unit cost than the order records.
   */
  PRICE_MISMATCH
  /**
   * The customer and SKU are both known, but no order of ours covers this period.
   */
  BILLED_NOT_SOLD
  /**
   * The SKU is not in the catalogue at all.
   */
  UNKNOWN_SKU
  /**
   * The SKU is known; the customer on the statement matches no company.
   */
  UNKNOWN_CUSTOMER
  /**
   * More than one order could be the match, so the reconciler refuses to pick.
   */
  AMBIGUOUS
  /**
   * Our side only: a live order in this period that the statement never billed for.
   */
  SOLD_NOT_BILLED
}

/**
 * Where a line came from — the file, or our own records.
 */
enum ReconcileSource {
  STATEMENT
  OURS
}

model VendorStatementLine {
  id String @id @default(cuid())

  statementId String
  statement   VendorStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  source    ReconcileSource @default(STATEMENT)
  /**
   * The row in the uploaded file, for pointing somebody at it. Null for a line we synthesised.
   */
  rowNumber Int?

  /**
   * As it appeared. Frozen — a later catalogue rename must not rewrite what the vendor billed.
   */
  sku         String
  description String?
  customerRef String
  quantity    Int
  unitCost    Decimal   @db.Decimal(12, 2)
  lineTotal   Decimal   @db.Decimal(14, 2)
  periodStart DateTime?
  periodEnd   DateTime?

  /**
   * The original row, whole.
   * Kept because the commonest import problem is a column mapped to the wrong field, and without
   * the untouched row the only way back is to find the file again — which by then is in somebody's
   * downloads folder, or gone.
   */
  raw Json?

  state ReconcileState

  matchedOrderId String?
  matchedOrder   CompanyProduct? @relation("ReconcileMatchedOrder", fields: [matchedOrderId], references: [id], onDelete: SetNull)

  matchedCompanyId String?
  matchedCompany   Company? @relation("ReconcileMatchedCompany", fields: [matchedCompanyId], references: [id], onDelete: SetNull)

  /**
   * What the disagreement is worth, signed: positive means it cost us money.
   * Stored rather than derived so a list can be sorted by it. An exception nobody can rank by value
   * is a list of two hundred rows that gets scrolled past.
   */
  variance Decimal? @db.Decimal(14, 2)

  /**
   * The reconciler's own words about this line, for the cases where the state alone is not enough.
   */
  note String?

  /**
   * Cleared by a person, with a reason. Not a state, because it is orthogonal: a resolved mismatch
   * is still a mismatch, and next month's statement will say so again if nothing was actually fixed.
   */
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?     @relation("VendorStatementLineResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?

  @@index([statementId, state])
  @@map("vendor_statement_lines")
}

/**
 * Which column in this vendor's file means what.
 * Every distributor names its columns differently and none of them will change for us, so the
 * mapping is data rather than code. Stored per vendor and reused, because the second upload should
 * not need the same twenty minutes of column-picking as the first.
 */
model VendorStatementMapping {
  id String @id @default(cuid())

  vendorId String  @unique
  vendor   Company @relation("VendorStatementMappingVendor", fields: [vendorId], references: [id], onDelete: Cascade)

  /**
   * `{ sku: "Part Number", customer: "End Customer", quantity: "Qty", ... }`
   */
  columns Json

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("VendorStatementMappingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("vendor_statement_mappings")
}

// ---------------------------------------------------------------------------------------------
// Customer portal — what a customer can see of their own account, without an account here
// ---------------------------------------------------------------------------------------------

/**
 * Who gets a portal at all.
 * `SELECTED` is the default and the safe one: nobody has access until somebody is given it. `ALL`
 * opens it to every client company, which is what a business wants once it trusts the thing, and is
 * still a decision somebody has to take rather than the state it ships in.
 */
enum PortalAccessMode {
  ALL
  SELECTED
}

/**
 * The portal's settings. One row.
 * Two different questions live here and they are deliberately not merged:
 * 1. **Who may sign in** — the master switch and `access`, overridden per company.
 * 2. **What they see once they have** — the `show*` flags, which apply to everybody.
 * Visibility is global rather than per company on purpose. A per-company visibility matrix is a
 * hundred switches nobody will ever audit, and the failure it invites — one customer quietly able
 * to see something the others cannot — is exactly the kind nobody notices until it is embarrassing.
 * Access is the thing that genuinely varies by customer; what the portal *is* should not.
 */
model PortalSettings {
  id String @id @default("global")

  /**
   * The master switch. Off, and no link works, whatever anybody was granted.
   */
  enabled Boolean          @default(false)
  access  PortalAccessMode @default(SELECTED)

  // ─── What a customer can see ────────────────────────────────────────────────────────────────
  showSubscriptions Boolean @default(true)
  showInvoices      Boolean @default(true)
  showPayments      Boolean @default(false)
  showTickets       Boolean @default(true)
  showAssets        Boolean @default(false)
  /**
   * Their own contact list as we hold it, so they can tell us it is wrong.
   */
  showContacts      Boolean @default(false)

  // ─── What a customer can ask for ────────────────────────────────────────────────────────────
  allowRenewalRequest Boolean @default(true)
  allowSeatRequest    Boolean @default(true)
  allowQuestion       Boolean @default(true)

  /**
   * How long a link lasts. Null means until it is revoked.
   * A portal link is a bearer credential that will live in somebody's inbox for years, so an expiry
   * is the difference between "a former employee of our customer can still read their invoices"
   * being a possibility and being a certainty.
   */
  linkValidityDays Int?

  /**
   * Shown at the top of the portal. Their account manager's name and number belongs here.
   */
  welcomeMessage String?

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("PortalSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("portal_settings")
}

/**
 * One person's way in.
 * Per contact rather than per company, which is the whole reason this is a table: when somebody
 * leaves the customer, their link is revoked and their colleagues' keep working. A company-wide
 * token would mean revoking one person costs everybody else theirs, so in practice nobody would
 * ever revoke one.
 * ## The token is stored as written
 * Not hashed, and that is a considered choice rather than an oversight. The same decision as the
 * preference centre and the feedback form, for the same reason: this is a bearer link that lives in
 * the customer's inbox, and an admin re-sending it has to be able to copy it again. Hashing would
 * buy protection against a database read by somebody who could, with that same access, simply read
 * the invoices directly.
 * What does the work instead: 192 bits of randomness, an expiry, revocation, and a scope of exactly
 * one company's own records.
 */
model PortalLogin {
  id String @id @default(cuid())

  token String @unique

  companyId String
  company   Company @relation("PortalLoginCompany", fields: [companyId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation("PortalLoginContact", fields: [contactId], references: [id], onDelete: SetNull)

  /**
   * Frozen, so a revoked link still says who it was for after the contact is deleted.
   */
  personName  String
  personEmail String?

  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   User?     @relation("PortalLoginCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime?
  lastSeenAt  DateTime?
  /**
   * How many times it has been opened. A link never used is one the email never arrived from.
   */
  visits      Int       @default(0)

  revokedAt   DateTime?
  revokedById String?
  revokedBy   User?     @relation("PortalLoginRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  requests PortalRequest[]

  @@index([companyId])
  @@map("portal_logins")
}

/**
 * What a customer came to ask for.
 */
enum PortalRequestKind {
  RENEWAL
  ADD_SEATS
  QUESTION
}

enum PortalRequestStatus {
  NEW
  IN_PROGRESS
  DONE
  DECLINED
}

/**
 * Something a customer asked for from the portal.
 * Deliberately not a Lead and not an Order. It is a *request*, which somebody here reads and turns
 * into whichever of those it should be — because "we want 5 more seats" from a customer is not yet
 * a sale, and creating one automatically would put unapproved orders in the pipeline written by
 * people outside the company.
 */
model PortalRequest {
  id String @id @default(cuid())

  companyId String
  company   Company @relation("PortalRequestCompany", fields: [companyId], references: [id], onDelete: Cascade)

  loginId String?
  login   PortalLogin? @relation(fields: [loginId], references: [id], onDelete: SetNull)

  /**
   * Frozen: who asked, as they were when they asked.
   */
  personName  String
  personEmail String?

  kind PortalRequestKind

  /**
   * The subscription it is about, for a renewal or a seat change.
   */
  companyProductId String?
  companyProduct   CompanyProduct? @relation("PortalRequestOrder", fields: [companyProductId], references: [id], onDelete: SetNull)

  /**
   * Seats wanted, for ADD_SEATS.
   */
  quantity Int?
  message  String?

  status      PortalRequestStatus @default(NEW)
  createdAt   DateTime            @default(now())
  handledById String?
  handledBy   User?               @relation("PortalRequestHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt   DateTime?
  response    String?

  @@index([status, createdAt])
  @@index([companyId])
  @@map("portal_requests")
}

// ---------------------------------------------------------------------------------------------
// Transporters, and e-way bills against the documents that carry the goods
// ---------------------------------------------------------------------------------------------

/**
 * A courier or transport company.
 * A record rather than the free-text `Consignment.courier` it replaces, for the reason free text
 * always fails: "Gati", "GATI", "Gati Ltd" and "gati courier" are four transporters as far as any
 * report is concerned, and none of them carries the GSTIN the e-way bill portal asks for. A
 * transporter is a party you deal with repeatedly, so it gets a row.
 * Deliberately not a `Company` with `relationshipType: VENDOR`. A transporter is not somebody we
 * raise purchase orders on or run an onboarding lifecycle for — it is a name, a registration and a
 * phone number that the despatch desk picks from a list. Putting it in the vendor directory would
 * mean every courier appearing in vendor reports, ageing and payables.
 */
model Transporter {
  id   String @id @default(cuid())
  name String

  /**
   * GSTIN, or the 15-character TRANSIN a transporter gets when they are not registered for GST.
   * The portal accepts either in the same field, which is why this is one column and not two.
   */
  gstin String?

  contactName String?
  phone       String?
  email       String?
  /**
   * What they usually move things by, so the despatch desk is not asked every time.
   */
  defaultMode TransportMode @default(ROAD)
  notes       String?

  /**
   * Retired rather than deleted, so historic consignments keep naming who carried them.
   */
  active Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("TransporterCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  consignments Consignment[]
  ewayBills    EwayBill[]

  @@index([active, name])
  @@map("transporters")
}

/**
 * An e-way bill, against the document the goods travel on.
 * ## Why it hangs off a document rather than a consignment
 * Because that is what the portal asks for: every bill names a document type and number — INV, CHL
 * or BIL — and a check compares the bill against the paper in the driver's hand. Attaching it to a
 * consignment covered asset movements and missed the larger half entirely: a hardware reseller's
 * e-way bills come mostly from **sales invoices**, and a consignment-shaped model has nowhere to
 * put those.
 * A consignment still raises one — against the delivery challan it generates.
 * ## Part A and Part B
 * The portal splits the bill in two, and so does this. Part A is the goods, the parties and the
 * distance; Part B is the vehicle. A bill is routinely raised with Part A complete and Part B to
 * follow, because the paperwork is done in the morning and the lorry is assigned at four — so the
 * vehicle is nullable and updating it later is an ordinary operation rather than a correction.
 */
model EwayBill {
  id String @id @default(cuid())

  /**
   * Indexed rather than unique.
   * A cancelled bill does not free the document: it stays as the record that one was raised and
   * withdrawn, and a replacement is a second row. The document's *current* bill is the most recent
   * one that is not cancelled.
   */
  documentId String
  document   TradeDocument @relation("TradeDocumentEwayBill", fields: [documentId], references: [id], onDelete: Cascade)

  // ── Part A: the goods and the journey ───────────────────────────────────────
  declaredValue Decimal @db.Decimal(14, 2)
  interstate    Boolean @default(false)
  distanceKm    Int

  // ── Part B: the vehicle ─────────────────────────────────────────────────────
  transporterId      String?
  transporter        Transporter?  @relation(fields: [transporterId], references: [id], onDelete: SetNull)
  transportMode      TransportMode @default(ROAD)
  vehicleType        VehicleType   @default(REGULAR)
  vehicleNumber      String?
  /**
   * The transporter's own consignment note — the LR number.
   */
  transportDocNumber String?
  transportDocDate   DateTime?

  // ── What the portal said ────────────────────────────────────────────────────
  status         EwayBillStatus @default(REQUIRED)
  ewayBillNumber String?
  ewayBillDate   DateTime?
  validUntil     DateTime?
  /**
   * Kept verbatim — a paraphrased rejection is not a clue.
   */
  error          String?
  cancelledAt    DateTime?
  cancelReason   String?

  /**
   * True when the number was raised on the portal by hand and recorded here afterwards.
   * Worth distinguishing: a bill this app generated can be cancelled and updated through the API,
   * while one typed in from the portal can only be *recorded* — we hold no session that owns it.
   * Offering a Cancel button for one we cannot cancel would be a lie.
   */
  associated Boolean @default(false)

  /// When a request to the portal was claimed, and by nobody else since.
  ///
  /// Generating went: read the row, see no number on it, call NIC, write the number back. Two
  /// clicks on a slow connection both read an empty row and both called the portal, so one
  /// consignment came back with two live e-way bills against it — and only the second was recorded,
  /// leaving the first neither visible here nor cancellable from here. A driver carrying one of a
  /// pair is a discrepancy an officer will find.
  ///
  /// So the row is claimed first, atomically, and released on the way out. A claim older than
  /// `EWAY_CLAIM_STALE_MS` is reclaimable — a crashed request must not wedge the document forever.
  generatingAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("EwayBillCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([status, createdAt])
  @@map("eway_bills")
}

// Reference data (the PIN directory, world places) lives in the shared reference database:
// prisma/reference/schema.prisma.

/// Where a lead came from. The first stop for "which channel is worth the money".
enum LeadSource {
  WEBSITE
  REFERRAL
  LINKEDIN
  CALLING
  EMAIL
  EVENT
  PARTNER
  ADVERTISEMENT
  EXISTING_CUSTOMER
  WALK_IN
  OTHER
}

/// A website's credential for the lead capture API (POST /api/v1/leads).
///
/// One per site or form, so each can be revoked alone and every lead says which one sent it. The
/// secret is shown once, at creation, and only its digest is kept — like a password, it cannot be
/// read back, only replaced.
model LeadCaptureKey {
  id           String    @id @default(cuid())
  /// What the person who made it called it — "wroffy.com contact form".
  name         String
  /// The public half, sent as the username. `lck_` and random; unique.
  keyId        String    @unique
  /// `digestSecret` of the secret half. The secret itself is never stored.
  secretDigest String
  /// Written into every lead this key creates, after the page URL the site sends.
  sourceLabel  String?
  active       Boolean   @default(true)
  lastUsedAt   DateTime?
  useCount     Int       @default(0)
  createdById  String?
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  leads Lead[]

  @@map("lead_capture_keys")
}

enum LeadAssignmentStrategy {
  /// Each of the people in turn.
  ROUND_ROBIN
  /// Whoever has the fewest open leads right now.
  LEAST_LOADED
  /// Always the one person named.
  SPECIFIC_USER
  /// The account manager of the company the lead is for — when it has one who can take it. Placed
  /// first, it keeps existing customers with the person who already knows them.
  ACCOUNT_MANAGER
}

/// A rule for who a new lead goes to when nobody has been chosen — see src/lib/leads/assign.ts.
///
/// Rules are tried in `priority` order and the first whose conditions all hold decides. Every
/// condition list is "any of these"; an empty list matches everything, so a rule with none is a
/// catch-all, and belongs last.
model LeadAssignmentRule {
  id           String                 @id @default(cuid())
  name         String
  priority     Int                    @default(100)
  active       Boolean                @default(true)
  /// Product brands on the lead — Microsoft, Adobe, Autodesk, Dell.
  brandIds     String[]
  itemTypes    ItemType[]
  /// The contact's designation.
  designations ContactDesignation[]
  sources      LeadSource[]
  /// The company's state, as the address picker spells it — for territories.
  states       String[]
  strategy     LeadAssignmentStrategy @default(ROUND_ROBIN)
  /// The people it chooses between. Inactive users are skipped when a lead is assigned, never removed.
  userIds      String[]
  /// Leave the person out on a day they are on approved leave.
  skipOnLeave  Boolean                @default(true)
  /// Round-robin position. Advanced atomically, so two leads at once go to two different people.
  rrCursor     Int                    @default(0)
  createdById  String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([active, priority])
  @@map("lead_assignment_rules")
}

/**
 * Where a customer stands on credit — see src/lib/credit/engine.ts.
 */
enum CreditRating {
  RELIABLE
  FAIR
  RISKY
  NEW
}

enum CreditDecisionKind {
  /// A customer's default payment terms set longer than their rating supports.
  TERMS
  /// A credit limit set, changed or cleared by hand.
  LIMIT
  /// An order given longer terms than suggested, or approved over the credit limit.
  ORDER
}

/**
 * Every time somebody gave a customer more credit than the engine suggested, and why.
 * Append-only: this is the answer to "who put them on Net 45?" a year later, so it is never edited
 * and a changed mind is a new row. The rating and score are the ones in front of the person when
 * they decided — the rating now may be different, and that difference is the point of keeping it.
 */
model CreditDecision {
  id          String             @id @default(cuid())
  companyId   String
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderId     String?
  order       CompanyProduct?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  kind        CreditDecisionKind
  /// What was decided, in words — "Net 30 on ORD-000042", "limit ₹5,00,000 (was suggested ₹2,50,000)".
  detail      String
  reason      String
  rating      CreditRating
  score       Int?
  decidedById String
  decidedBy   User               @relation("CreditDecidedBy", fields: [decidedById], references: [id])
  createdAt   DateTime           @default(now())

  @@index([companyId, createdAt])
  @@index([orderId])
  @@map("credit_decisions")
}

/**
 * Which customer notice a message was — see src/lib/marketing/customer-notices.ts.
 */
enum CustomerNoticeKind {
  RENEWAL
  FULFILMENT
}

// ---------------------------------------------------------------------------------------------
// Forecasting — src/lib/forecast
// ---------------------------------------------------------------------------------------------

/**
 * An admin's override of one stage's weight in the sales forecast.
 * Without a row, a stage is weighted by the win rate actually achieved from it over the last twelve
 * months, or by a standard figure until there is enough history to learn from. An override is for
 * when the business knows something the history does not — a new product line, a changed team.
 */
model ForecastStageWeight {
  stage       LeadStatus @id
  percent     Int
  updatedById String?
  updatedBy   User?      @relation("ForecastWeightUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime   @updatedAt

  @@map("forecast_stage_weights")
}

/**
 * A salesperson's own number for a month — what they commit to, and what they could reach if things
 * go well — set beside the forecast the system works out from their deals.
 * One per person per month, changed in place: the latest call is the call. Who changed it and when
 * is in the audit log.
 */
model ForecastCommit {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation("ForecastCommitOwner", fields: [userId], references: [id], onDelete: Cascade)
  /**
