   */
  month    String
  commit   Decimal  @db.Decimal(14, 2)
  bestCase Decimal? @db.Decimal(14, 2)
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
  @@index([month])
  @@map("forecast_commits")
}

// ---------------------------------------------------------------------------------------------
// Sales wins — src/lib/wins
