// ---------------------------------------------------------------------------------------------
// Merging duplicate companies — src/lib/companies/merge.ts
// ---------------------------------------------------------------------------------------------

/**
 * A company merged into another: what it was, what moved, and what was kept from which side — and
 * how its old links (its COM number, its id) find the company it became. The duplicate itself is
 * gone; this is the only trace of it, so it is never deleted.
 * A later merge of the survivor re-points `intoCompanyId` like every other link, so a chain of
 * merges always ends at the company that exists.
 */
model CompanyMerge {
  id            String   @id @default(cuid())
  fromCompanyId String   @unique
  fromSeq       Int      @unique
  fromName      String
  intoCompanyId String
  into          Company  @relation("CompanyMergedInto", fields: [intoCompanyId], references: [id], onDelete: Cascade)
  /**
   * The duplicate as it was, with its addresses — enough to answer "what was that company?" later.
   */
  snapshot      Json
  /**
   * How many of each kind of record moved, and every clash and how it was settled.
   */
  moved         Json
  /**
   * For each company detail that differed, which side's value was kept.
   */
  choices       Json
  mergedById    String?
  mergedBy      User?    @relation("CompanyMergedBy", fields: [mergedById], references: [id], onDelete: SetNull)
  mergedAt      DateTime @default(now())

  @@index([intoCompanyId])
  @@map("company_merges")
}

/**
 * Two companies somebody looked at and said are not the same, so the duplicates list stops offering
 * the pair. Plain ids, no foreign keys: a merge must not carry a dismissal across as if it were data.
 * `companyAId` is always the smaller of the two, so a pair is stored one way round.
 */
model CompanyDuplicateDismissal {
  id            String   @id @default(cuid())
  companyAId    String
  companyBId    String
  dismissedById String?
  createdAt     DateTime @default(now())

  @@unique([companyAId, companyBId])
  @@map("company_duplicate_dismissals")
}

/**
 * Planned downtime — src/lib/maintenance.ts. One row, `id = "global"`.
 *
 * While it is on, everybody who can't change organisation settings sees a maintenance page instead
 * of the app; those who can keep working, to check the change they took it down for. Before a
 * scheduled window, everybody sees a banner saying when.
 */
model MaintenanceMode {
  id          String    @id @default("global")
  enabled     Boolean   @default(false)
  /**
   * When it starts. Null means the moment it is switched on.
   */
  startsAt    DateTime?
  /**
   * When it ends by itself. Null means until somebody switches it off.
   */
  endsAt      DateTime?
  /**
   * What everybody else is told on the maintenance page.
   */
  message     String?
  updatedById String?
  updatedBy   User?     @relation("MaintenanceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime  @updatedAt

  @@map("maintenance_mode")
}

// ---------------------------------------------------------------------------------------------
// The AI copilot — src/lib/copilot/
// ---------------------------------------------------------------------------------------------

enum AiProvider {
  ANTHROPIC
  OPENAI
  GEMINI
}

/**
 * Which AI provider and model the copilot uses, and the keys for each. One row, `id = "global"`.
 *
 * The keys are encrypted with `encryptSecret` like every other provider secret, and never leave the
 * server: the settings screen is told only whether one is saved. Each provider keeps its own key so
 * switching between them doesn't mean pasting a key again.
 */
model CopilotSettings {
  id                 String     @id @default("global")
  enabled            Boolean    @default(false)
  provider           AiProvider @default(ANTHROPIC)
  model              String     @default("claude-opus-5")
  anthropicKeyCipher String?
  openaiKeyCipher    String?
  geminiKeyCipher    String?
  /**
   * Tokens one person may use in a day, input and output together. Resets at midnight India time.
   */
  dailyTokenLimit    Int        @default(300000)
  updatedById        String?
  updatedBy          User?      @relation("CopilotSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt          DateTime   @updatedAt

  @@map("copilot_settings")
}

/**
 * One chat. Private to the person who had it — nobody else, admins included, can open it from the
 * app: what somebody asked about is theirs.
 */
model CopilotConversation {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation("CopilotConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  messages  CopilotMessage[]
  proposals CopilotProposal[]

  @@index([userId, updatedAt])
  @@map("copilot_conversations")
}

/**
 * A turn in a chat, in a shape that doesn't belong to any one provider — see
 * src/lib/copilot/types.ts — so a conversation survives the provider being switched mid-way.
 */
model CopilotMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /**
   * user, assistant, or tool — the last being what the copilot looked up, fed back to the model.
   */
  role           String
  content        Json
  provider       AiProvider?
  model          String?
  inputTokens    Int                 @default(0)
  outputTokens   Int                 @default(0)
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@map("copilot_messages")
}

/**
 * Tokens used per person per day — what the daily limit is checked against, and the usage screen.
 */
model CopilotUsage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("CopilotUsageUser", fields: [userId], references: [id], onDelete: Cascade)
  day          DateTime @db.Date
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  requests     Int      @default(0)

  @@unique([userId, day])
  @@map("copilot_usage")
}

enum CopilotProposalKind {
  TASK
  NOTE
}

enum CopilotProposalStatus {
  PENDING
  DONE
  CANCELLED
  FAILED
}

/**
 * Something the copilot offered to create — a task, a note — waiting for the person to confirm it.
 * Nothing is written until they do, and then it is written by the same action the app's own form
 * uses, as them.
 */
model CopilotProposal {
  id             String                @id @default(cuid())
  conversationId String
  conversation   CopilotConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                  @relation("CopilotProposalUser", fields: [userId], references: [id], onDelete: Cascade)
  kind           CopilotProposalKind
  /**
   * The input for the action that will create it, exactly as it will be sent.
   */
  payload        Json
  /**
   * One line for the card: "Call Acme about the renewal — due Fri 26 Sep".
   */
  summary        String
  status         CopilotProposalStatus @default(PENDING)
  /**
   * The id of what was created, or why it couldn't be.
   */
  recordId       String?
  error          String?
  createdAt      DateTime              @default(now())
  decidedAt      DateTime?

  @@index([userId, status])
  @@map("copilot_proposals")
}

/**
 * The whole company locked by the super admin: everybody else can sign in and sees only the notice.
 * One row, `id = "global"`. See src/lib/access/lock.ts.
 */
model CompanyLock {
  id         String    @id @default("global")
  enabled    Boolean   @default(false)
  message    String?
  /**
   * When it lifts by itself. Null means until the super admin lifts it.
   */
  until      DateTime?
  lockedAt   DateTime?
  lockedById String?
  lockedBy   User?     @relation("CompanyLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  updatedAt  DateTime  @updatedAt

  @@map("company_locks")
}

/**
 * Where people go for help: the helpline shown in the corner of the dashboard's welcome header, and
 * the support address. One row, like MaintenanceMode — there is one helpline, not one per record.
 * Every field is optional, and a helpline with no number is simply not shown.
 */
model HelpDesk {
  id                String   @id @default("global")
  /** "Wroffy Support" — what the number is labelled as. */
  helplineLabel     String?
  helplinePhone     String?
  /** Free text, because hours are said differently everywhere: "Mon – Fri • 9:30 AM – 6:30 PM". */
  helplineHours     String?
  /** "English, हिन्दी" — the languages somebody on the line speaks. */
  helplineLanguages String?
  supportEmail      String?
  updatedById       String?
  updatedBy         User?    @relation("HelpDeskUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt         DateTime @updatedAt

  @@map("help_desk")
}

enum HelpLinkKind {
  ARTICLE
  VIDEO
}

/**
 * A help article or a video walkthrough, listed in the rail on the right. Links, not content: the
 * material lives wherever it is written or recorded (a wiki, YouTube, a shared drive), and this is
 * the index people find it through.
 */
model HelpLink {
  id          String       @id @default(cuid())
  kind        HelpLinkKind
  title       String
  /** https only, or an in-app path beginning with "/". Checked on save — see src/lib/help/links.ts. */
  url         String
  description String?
  sortOrder   Int          @default(0)
  active      Boolean      @default(true)
  createdById String?
  createdBy   User?        @relation("HelpLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([kind, active, sortOrder])
  @@map("help_links")
}

/**
 * A "What's new" post: a change to the system, a new process, anything everybody should know. Shown
 * under Recent Updates on the dashboard and in the rail, with a dot until it has been read.
 *
 * `publishedAt` may be in the future — the post stays out of sight until then, so an update can be
 * written ahead of the release it describes.
 */
model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  /** Optional "read more": https, or an in-app path beginning with "/". */
  linkUrl     String?
  pinned      Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
  @@map("announcements")
}

enum MailConnectionProvider {
  MICROSOFT
}

/**
 * A person's own mailbox, connected so the ERP can send as them — an invoice goes out from their
 * address and lands in their Sent Items. See src/lib/mail/microsoft.ts.
 *
 * One per person, and only ever their own: the mailbox Microsoft reports has to be the address on
 * their account here, or the connection is refused. The refresh token is encrypted with
 * encryptSecret and never leaves the server.
 */
model MailConnection {
  id                   String                 @id @default(cuid())
  userId               String                 @unique
  user                 User                   @relation("UserMailConnection", fields: [userId], references: [id], onDelete: Cascade)
  provider             MailConnectionProvider @default(MICROSOFT)
  /** The address mail goes out from. */
  mailbox              String
  displayName          String?
  refreshTokenCipher   String
  accessTokenCipher    String?
  accessTokenExpiresAt DateTime?
  /** What Microsoft granted, as it said so. */
  scopes               String
  connectedAt          DateTime               @default(now())
  lastUsedAt           DateTime?
  /**
   * Set when Microsoft refuses the stored token — a changed password, a revoked consent, an account
   * disabled. Nothing is sent until the person connects again.
   */
  brokenAt             DateTime?
  lastError            String?
  updatedAt            DateTime               @updatedAt

  @@map("mail_connections")
}

/**
 * The words that go with a document when it is emailed — one per document type, with merge fields.
 * No row means the built-in wording in src/lib/documents/email-template.ts.
 */
model DocumentEmailTemplate {
  docType     TradeDocumentType @id
  subject     String
  body        String
  updatedById String?
  updatedBy   User?             @relation("DocumentEmailTemplateBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime          @updatedAt

  @@map("document_email_templates")
}

/**
 * A one-time pass for the server's own headless browser to open one document's print page, so it
 * can be turned into the PDF that is attached. See src/lib/documents/render-grant.ts.
 *
 * Minted by the send action for the person sending, after it has checked they may see the document;
 * good for that document only, for two minutes, once.
 */
model DocumentRenderGrant {
  id         String        @id
  documentId String
  document   TradeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation("DocumentRenderGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime      @default(now())

  @@index([expiresAt])
  @@map("document_render_grants")
}

/** Towns and cities outside India with at least 1,000 people, from GeoNames' cities1000 — for suggestions. */
/**
 * A link to set a new password, emailed by the platform when somebody asks from the sign-in page
 * (src/actions/password-reset.ts). Good for an hour, once. Only its SHA-256 is kept; the link itself
 * exists in the email alone.
 */
model PasswordResetToken {
  tokenHash String    @id
  userId    String
  user      User      @relation("PasswordResetTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

enum UserKind {
  MEMBER
  SUPPORT
}
