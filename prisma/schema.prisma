/**
 * The order-punching workflow: sales punches an order (PENDING_APPROVAL) → accounts reviews
 * payment terms and either APPROVES or REJECTS it → once approved, the purchase team sources a
 * vendor and cost price (optionally parking it at PROCESSING while they work it) → FULFILLED once
 * the purchase side is complete. CANCELLED can happen from any non-terminal state.
 */
enum OrderStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PROCESSING
  FULFILLED
  CANCELLED
}

/**
 * How far along a renewal is — see `CompanyProduct.renewalStage` and `src/lib/renewals.ts`.
 * Most of these are worked out from what has happened rather than stored: NOT_STARTED, TASK_RAISED,
 * CONTACTED, QUOTED and RENEWED all have evidence behind them. They are in the enum so that a stage
 * the app currently derives could be pinned by hand later without another migration.
 * NEGOTIATING, ON_HOLD and LOST are the reason the column exists at all: nothing in the data says
 * them, and they are what a salesperson most wants to record.
 */
enum RenewalStage {
  NOT_STARTED
  TASK_RAISED
  CONTACTED
  QUOTED
  NEGOTIATING
  ON_HOLD
  LOST
  RENEWED
}

enum OrderExpenseType {
  COMMISSION
  FREIGHT
  INSTALLATION
  OTHER
}

/**
 * Sales categorization of an order — set by the sales person punching it, not auto-derived (the
 * app can suggest RENEWAL when this company already has a prior order for the same item, but it
 * has no way to know whether a customer previously bought the equivalent product elsewhere).
 */
enum OrderBusinessType {
  /**
   * Brand new — this customer has never bought this product from anyone, or it's a genuinely new relationship.
   */
  NEW
  /**
   * Renewing a subscription/product this customer already bought from Wroffy before.
   */
  RENEWAL
  /**
   * The customer already had this product/service elsewhere (a renewal from their perspective) — new revenue for Wroffy, e.g. won from a competitor.
   */
  NEW_TO_US_RENEWAL
  /**
   * Extra seats added to a subscription already running, co-terminating with it and charged for the
   * remaining days only. Its own order because it was sold on its own day, at its own price, on its
   * own invoice — see the note on `parent` below.
   */
  ADDON
}

enum NotificationType {
  CALLBACK_DUE
  TASK_ASSIGNED
  TASK_DUE
  TASK_OVERDUE
  LEAD_ASSIGNED
  LEAD_STATUS_CHANGED
  LEAD_ACTIVITY
  ACCOUNT_MANAGER_ASSIGNED
  CALLER_ASSIGNED
  TICKET_ASSIGNED
  TICKET_STATUS_CHANGED
  TICKET_SLA_OVERDUE
  TICKET_COMMENT
  RENEWAL_EXPIRING
  ORDER_STATUS_CHANGED
  ORDER_WATCHER_ADDED
  VISIT_SCHEDULED
  EXPENSE_SUBMITTED
  EXPENSE_DECIDED
  EXPENSE_REIMBURSED
  LEAVE_REQUESTED
  LEAVE_DECIDED
  REGULARISATION_REQUESTED
  REGULARISATION_DECIDED
  BIRTHDAY_TODAY
  WORK_ANNIVERSARY
  HOLIDAY_UPCOMING
  LETTER_ISSUED
  FEEDBACK_RECEIVED
  NOTE_REMINDER
  /**
   * Raised by the DLP layer: a screenshot, a refused attempt past the cap, or read volume that
   * looks like collection rather than work. Goes to admins, not to the person who triggered it.
   */
  SECURITY_ALERT
  /**
   * Somebody other than the project manager opened a stored credential. Goes to the manager, so
   * quiet harvesting is visible rather than only discoverable afterwards.
   */
  PROJECT_CREDENTIAL_VIEWED
  /**
   * Added to a project, which is also how they got sight of it.
   */
  PROJECT_STAKEHOLDER_ADDED
  PROJECT_STATUS_CHANGED
  /**
   * A customer asked for something from their portal — a renewal, more seats, or a question.
   * Goes to whoever owns the account, because a request nobody is told about is worse than a phone
   * call that at least rang.
   */
  PORTAL_REQUEST
  /**
   * Somebody answered a form, or an invited customer RSVPd. Goes to whoever sent the invitation, else
   * whoever the form routes to, else its owner. A form that also made a lead sends LEAD_ASSIGNED instead.
   */
  FORM_RESPONSE
  /**
   * The fortnight's most active people, announced — to everybody, to managers, or to the winners,
   * as the award settings say. See src/lib/performance/awards.ts.
   */
  ACTIVITY_AWARD
  /**
   * Somebody opened a credential you own. Sent for every reveal that is not your own, including
   * an admin using their override — access nobody is told about is access nobody reviews.
   */
  VAULT_CREDENTIAL_OPENED
  /**
   * A credential was shared with you, which is also how you find out you have it.
   */
  VAULT_SHARED
  /**
   * A form, poll or vote is waiting for them.
   */
  SURVEY_ASSIGNED
  /**
   * Anonymous feedback has arrived for HR to look at. Names nobody.
   */
  FEEDBACK_SUBMITTED
  /**
   * Somebody is at reception asking for them.
   */
  VISITOR_ARRIVED
  /**
   * A visitor they invited is due shortly, or has been added for them by somebody else.
   */
  VISITOR_EXPECTED
  /**
   * A quotation or invoice is waiting for their sign-off. Goes to everyone the policy names as an
   * approver, never to the person who submitted it — they cannot approve their own.
   */
  DOCUMENT_APPROVAL_REQUESTED
  /**
   * Their document was approved, or sent back with a reason. Goes to whoever submitted it, because
   * a rejection nobody is told about is a document that simply stops moving.
   */
  DOCUMENT_APPROVAL_DECIDED
}

model User {
  id                     String    @id @default(cuid())
  name                   String
  email                  String    @unique
  /**
   * MEMBER: somebody who works here. SUPPORT: the platform's support staff, let in for a while by
   * the super admin's grant (src/lib/platform/support.ts) — never listed among the people, never
   * a seat, never assignable. Every list of users leaves them out (src/lib/db.ts).
   */
  kind                   UserKind  @default(MEMBER)
  /**
   * A work contact number, for putting on a quote so the customer can reach whoever sent it.
   * Deliberately on User rather than reusing `EmployeeProfile.personalPhone`: that field is what
   * it says it is, and printing somebody's personal mobile on a document that goes to a customer
   * is not a decision a form should make on their behalf.
   */
  phone                  String?
  /**
   * The stable identity for exports and migrations.
   * Email is unique but mutable: a surname change or a domain move rewrites it. Every ownership
   * link in the system resolves through this person — account manager, lead owner, who approved
   * an order, who verified a contact — so keying an export on the address means one edit between
   * two runs silently re-points or orphans everything they own, with nothing recording that the
   * old address and the new one are the same human.
   */
  userSeq                Int       @unique @default(autoincrement())
  passwordHash           String
  /**
   * The role's `key`, not its name.
   * A string rather than an id, and that is the whole reason this migration was affordable: every
   * `role === "ADMIN"` comparison in the application, the super-admin CHECK constraint, and all
   * sixteen built-in presets compare against this exact literal and go on working untouched. An
   * id-based relation would have meant loading the role on every query that asks "is this an admin".
   */
  role                   String
  roleRef                Role      @relation(fields: [role], references: [key])
  /**
   * The tier above ADMIN.
   * A super admin holds every permission unconditionally — the resolver returns true before it
   * reads any table — and cannot be demoted, deactivated or impersonated by an ordinary admin.
   * Invariant, enforced by a CHECK constraint: a super admin always also has role = ADMIN. That is
   * deliberate and load-bearing. Adding SUPER_ADMIN as a new `Role` enum member instead would make
   * every one of the ~77 existing `role === "ADMIN"` comparisons across src/ evaluate FALSE for the
   * super admin, locking the only one out of Settings on the day it shipped. A flag on top of ADMIN
   * is the only shape that is genuinely additive.
   */
  isSuperAdmin           Boolean   @default(false)
  /**
   * Set whenever the photo changes, null when there is none. Lives on the row so a list can tell
   * whether to render an <img> or initials without carrying the image itself, and doubles as the
   * cache-buster in the photo URL.
   */
  photoUpdatedAt         DateTime?
  active                 Boolean   @default(true)
  /**
   * Forces a password change on next login — set when an admin creates the account or resets a password.
   */
  mustChangePassword     Boolean   @default(false)
  /**
   * An administrator's lock: they can sign in, and see nothing but the notice below until it is
   * lifted — or until `lockedUntil`, when set, passes. See src/lib/access/lock.ts.
   */
  lockedAt               DateTime?
  lockedUntil            DateTime?
  lockMessage            String?
  lockedById             String?
  lockedBy               User?     @relation("UserLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  locksApplied           User[]    @relation("UserLockedBy")
  /**
   * The newest "What's new" post this person has seen. Posts published after it are unread — one
   * timestamp rather than a row per post, because "have I seen everything up to now" is the only
   * question the dot beside the bell asks.
   */
  updatesSeenAt          DateTime?
  /**
   * AES-256-GCM encrypted TOTP secret (see src/lib/crypto.ts) — null until the user completes two-factor setup.
   */
  twoFactorSecretCipher  String?
  /**
   * A secret part-way through enrolment, not yet proved.
   * Separate from the live one because setup used to overwrite it and blank `twoFactorEnabledAt` in
   * the same breath — so anyone holding a session cookie could turn the account's second factor off
   * without knowing the password, then re-enrol an authenticator of their own. Held here, the
   * account keeps working on the old factor until a code from the new one proves it.
   */
  twoFactorPendingCipher String?

  /**
   * Set once two-factor setup is confirmed with a valid code; null means 2FA is off for this account.
   */
  twoFactorEnabledAt  DateTime?
  /**
   * Which dashboard widget keys (see src/lib/dashboard-widgets.ts) this user has chosen to show —
   * only meaningful when `dashboardCustomized` is true; ignored (defaults to every widget this
   * user currently has module access to) otherwise, so an un-customized dashboard tracks module
   * changes automatically instead of freezing at whatever was available when the user last saved.
   */
  dashboardWidgets    String[]  @default([])
  dashboardCustomized Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  managerId     String?
  manager       User?       @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports User[]      @relation("UserManager")

  companiesCreated           Company[]                @relation("CompanyCreatedBy")
  companiesOwned             Company[]                @relation("CompanyOwner")
  companiesAssigned          Company[]                @relation("CompanyAssignedTo")
  companiesHandedOut         Company[]                @relation("CompanyAssignedBy")
