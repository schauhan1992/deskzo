// ---------------------------------------------------------------------------------------------
// Prizes — src/lib/wins/prizes.ts
// ---------------------------------------------------------------------------------------------

enum PrizeRace {
  /**
   * Every fortnight's most active — src/lib/performance.
   */
  MOST_ACTIVE
  /**
   * Every month's top sellers, by order value booked — the wins leaderboard.
   */
  TOP_SELLERS
}

/**
 * A prize up for grabs.
 * `period` "" is the standing prize, given every period nobody has planned otherwise. "2026-10" (a
 * month, for top sellers) or "2026-10-A" (a fortnight, for the most active) plans one for that period
 * alone — slot by slot, so planning a bigger first prize for Diwali keeps the standing second and third.
 */
model Prize {
  id           String    @id @default(cuid())
  race         PrizeRace
  period       String    @default("")
  /**
   * "1", "2", "3" — and, for the most active, "sales" and "support" for the leader of each area.
   */
  slot         String
  name         String
  note         String?
  /**
   * A picture of it, shrunk in the browser before it is sent — the wall and the TV load every one.
   */
  imageDataUrl String?

  updatedById String?
  updatedBy   User?    @relation("PrizeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@unique([race, period, slot])
  @@map("prizes")
}

/**
 * Somebody who won, with what they won as it was on the day — a prize edited next month does not
 * change what was given last month. The hall of fame.
 */
model PrizeWinner {
  id          String        @id @default(cuid())
  race        PrizeRace
  period      String
  periodLabel String
  slot        String
  userId      String
  user        User          @relation("PrizeWinnerUser", fields: [userId], references: [id], onDelete: Cascade)
  /**
   * Points for the most active; rupees booked for a top seller.
   */
  score       Decimal       @db.Decimal(14, 2)
  prizeName   String?
  prizeNote   String?
  prizeImage  String?
  /**
   * Who the result was told to. Top sellers are always everybody; the most active, as their settings
   * said that fortnight — and the hall of fame shows it to the same people.
   */
  audience    AwardAudience

  handedOverAt   DateTime?
  handedOverById String?
  handedOverBy   User?     @relation("PrizeHandedOverBy", fields: [handedOverById], references: [id], onDelete: SetNull)

  announcedAt DateTime @default(now())

  @@unique([race, period, slot])
  @@index([userId])
  @@index([announcedAt])
  @@map("prize_winners")
}

/**
 * A prize list told to everybody: once automatically as a period opens, and whenever somebody presses
 * the button after changing it.
 */
model PrizeAnnouncement {
  id            String    @id @default(cuid())
  race          PrizeRace
  period        String
  /**
   * "auto:<race>:<period>" for the automatic one, so it goes out once however often the check runs.
   * Null for one sent by hand.
   */
  autoKey       String?   @unique
  announcedById String?
  announcedBy   User?     @relation("PrizeAnnouncedBy", fields: [announcedById], references: [id], onDelete: SetNull)
  announcedAt   DateTime  @default(now())

  @@index([race, announcedAt])
  @@map("prize_announcements")
}

