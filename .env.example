DATABASE_URL="postgresql://deskzo:deskzo@localhost:5432/deskzo?schema=public"

# Generate with: npx auth secret
# Before the first workspace is adopted into the control plane, stored secrets (2FA, the vault,
# mailbox tokens) are encrypted under keys derived from this. Adoption copies those keys into the
# workspace's own key bundle, after which this value can be rotated without losing anything.
AUTH_SECRET=""
# No NEXTAUTH_URL / AUTH_URL: every workspace has its own address, and sign-in uses the one the
# request came in on (src/lib/auth-session.ts). Setting either sends every workspace's sign-in to it.

# ─── Workspaces (SaaS) ────────────────────────────────────────────────────────────────────────────
# The platform's own database: which workspaces exist, where their databases are, their keys.
# npm run control:migrate, then npm run platform:adopt to make the database above workspace #1.
CONTROL_DATABASE_URL="postgresql://deskzo:deskzo@localhost:5432/deskzo_control?schema=public"
# The shared reference database: India Post's PIN directory and GeoNames' world places, one copy for
# every workspace. npm run reference:migrate; then, upgrading a database from before it,
# npm run reference:move and npx prisma migrate deploy — in that order.
REFERENCE_DATABASE_URL="postgresql://deskzo:deskzo@localhost:5432/deskzo_reference?schema=public"
# Seals every workspace's keys and database address in the control plane. Base64 of 32 random
# bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back it up with the database backups. Lose it and no workspace's secrets can be read again.
PLATFORM_MASTER_KEY=""
# Workspaces are <slug>.<PLATFORM_DOMAIN>; admin.<PLATFORM_DOMAIN> is the console. In production:
# PLATFORM_DOMAIN="deskzo.com" (and PLATFORM_PORT unset).
PLATFORM_DOMAIN="localhost"
# The port to put in links in development. Leave unset in production.
PLATFORM_PORT="3000"
# Which installation the staff console says it is: a badge on every page, a "[staging] " tab title.
# PLATFORM_ENV="staging"   # production | staging | development; empty = from NODE_ENV
# The first workspace, and the addresses it answered on before workspaces (kept working).
TENANCY_DEFAULT_SLUG="deskzo"
TENANCY_DEFAULT_NAME="Deskzo"
TENANCY_LEGACY_HOSTS="localhost:3000,127.0.0.1:3000"
# Scripts and check suites act as the first workspace when nothing else says. Never in the server.
DESKZO_TENANCY_FALLBACK="legacy"
# Behind a reverse proxy that sets X-Forwarded-Host and appends to X-Forwarded-For, and only then:
# TRUST_PROXY=1
# Without it no caller's address is believed (src/lib/client-ip.ts): IP rules match nobody and
# lockouts are per account only. With a chain of proxies (a CDN in front of nginx), how many:
# TRUST_PROXY_HOPS=2

# Setting up new workspaces (npm run platform:worker). A role with CREATEDB and CREATEROLE, connected
# to the server's maintenance database; each workspace gets a database and a login role of its own.
# Unset in development: DATABASE_URL's server and credentials are used.
# PLATFORM_PROVISIONER_URL="postgresql://deskzo_provisioner:…@localhost:5432/postgres"
# Databases made and migrated ahead of time, so a signup takes seconds.
# PLATFORM_WARM_POOL=2
# The platform's own mail: signup codes, "your workspace is ready", password resets. Unset, each
# message is written to platform-outbox/ instead of being sent.
# PLATFORM_SMTP_URL="smtps://user:password@smtp.example.com:465"
# PLATFORM_MAIL_FROM="Deskzo One <no-reply@deskzo.com>"
# Tickets by email (src/lib/support-mail, docs/deploy-coolify.md "Tickets by email"): every workspace's
# helpdesk answers at <slug>@INBOUND_MAIL_DOMAIN, received by a Cloudflare Email Worker that signs each email
# with INBOUND_MAIL_SECRET (32+ random hex). Unset, no workspace has an address.
# INBOUND_MAIL_DOMAIN="tickets.deskzo.com"
# INBOUND_MAIL_SECRET=""
# The staff console (admin.<PLATFORM_DOMAIN>) only from these networks — comma-separated CIDRs. Needs
# TRUST_PROXY=1: the address is the one the reverse proxy adds, and without one nobody is let in.
# The first owner is made on the server: npm run platform:staff -- create --email … --name … --role OWNER
# PLATFORM_CONSOLE_IP_ALLOWLIST="203.0.113.0/24"
# Contact Support's attachments and screen recordings (src/lib/support/storage.ts): a folder on this
# server, like the backups. Unset: storage/support in the app's folder. Back it up with the database;
# allow a few GB (files up to 10 MB, recordings up to 80 MB, kept 365 days after a request closes).
# SUPPORT_DIR="/var/lib/deskzo/support"

# The scheduler's secrets — a cron job calls /api/marketing/tick every five minutes and
# /api/backup/tick every few, with "Authorization: Bearer <secret>". On a workspace's address a tick
# runs that workspace; on the platform's (admin.<PLATFORM_DOMAIN>) it runs every active workspace.
# Unset, the endpoint refuses everything.
# MARKETING_TICK_SECRET=""
# BACKUP_TICK_SECRET=""
# And every hour, on the platform's address only, /api/platform/tick: trials, grace periods, holds,
# billing reminders, and once a day the gateways read back and each workspace's use recorded.
# The gateways' own keys are not set here — they are entered in the console, under Billing.
# PLATFORM_TICK_SECRET=""

# Microsoft SSO (Entra ID / Azure AD) is configured from the app itself — Settings >
# Users & Access > Security, as an admin. Nothing to set here.

# Emailing documents (the Mail button on invoices and proposals) attaches a PDF made by a headless
# Chrome, Chromium or Edge on this server. Found at the usual install paths; set the path if not.
# On a Linux server running the app as root, Chrome refuses its sandbox unless told otherwise.
# PDF_BROWSER_PATH="/usr/bin/chromium"
# PDF_BROWSER_NO_SANDBOX=true
# Where that browser can reach this app. Behind a reverse proxy, point it straight at the Node port;
# it is sent there with the workspace's own hostname (src/lib/tenancy/render-target.ts).
# INTERNAL_APP_URL="http://127.0.0.1:3000"

# Domain Intel looks customers' public domains up against these resolvers rather than the machine's
# own, which on a laptop or in a container is often a stub that refuses every query.
DNS_RESOLVERS="1.1.1.1,8.8.8.8"
# Website thumbnails. Defaults to WordPress mShots (free, no key); {url} is the encoded page URL.
# DOMAIN_SCREENSHOT_URL="https://api.example.com/screenshot?url={url}"

# TEMPORARY - shows the super admin a "Reset all data" button on Settings > Backups that empties the
# whole database back to a fresh install. For the testing phase only: never set it in production.
# ENABLE_DATA_RESET=true
