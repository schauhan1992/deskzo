# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.next-build

# database backups
# A dump is the entire system — every order, every password hash, every encrypted secret.
# Committing one puts all of it in the history of a repository that gets cloned.
#
# Anchored with a leading slash, and that slash is load-bearing. Written as `backups/` the pattern
# matches a directory of that name at ANY depth, which silently swallowed three directories of real
# source — src/app/api/backups/, src/app/(dashboard)/settings/backups/ and src/components/backups/.
# Nothing reports it: `git status` omits ignored files rather than listing them as excluded, so the
# first commit of this repository left the entire backups feature out and looked complete doing it.
/backups/
*.dump
*.dump.json
# The sealed download format. Same reasoning as a dump, and more so — it carries the AUTH_SECRET.
*.wbak

# Generated from whatever demo data this machine happens to hold — regenerate with
# npm run db:seed:reconcile rather than committing one machines copy.
public/sample-vendor-statement.csv

# Review artefacts — lists of findings passed between agents during a code review.
# Useful while a review is open, meaningless once its fixes have landed, and they
# collide between runs. Kept out of history rather than deleted.
/confirmed.json
/fix-groups.json
/followups.json

# A PIN directory download before `npm run db:reference` compresses it. The .csv.gz beside it is
# the copy that is committed; the raw file is the same data four or five times larger.
/prisma/reference/*.csv

# GeoNames' files (states, cities and postal codes outside India, CC BY 4.0) — ~55 MB, downloaded by
# Settings → World places or `npm run db:geonames:download`, never committed. The country list made
# from them is committed, as src/lib/geo/world-countries.ts.
/prisma/reference/geonames/

# The IP location database (DB-IP City Lite, CC BY 4.0). ~125 MB of downloadable reference data
# that changes monthly: replaced from Settings, never committed. Anchored for the reason /backups/ is.
/geoip/

