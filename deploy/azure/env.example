# Deskzo One — the production settings. ./make-env.sh copies this to .env and fills in every secret.
# .env is never committed. What each setting does: docs/runbook.md §2.

# ─── Addresses ────────────────────────────────────────────────────────────────────────────────────
# Workspaces are <slug>.deskzo.com; www. the website, admin. the console, cms. the CMS, partners. the
# partner portal. DNS: an A record for deskzo.com and one for *.deskzo.com, both to the VM's address.
PLATFORM_DOMAIN=deskzo.com
PLATFORM_ENV=production
# Let's Encrypt's account for the certificates: it writes here if one is about to expire.
ACME_EMAIL=

# ─── Secrets — filled by ./make-env.sh ──────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
AUTH_SECRET=
# Seals every workspace's database address and keys. Lose it and no workspace can be read again:
# copy it offline, in two places, as soon as it is made (docs/runbook.md §4).
PLATFORM_MASTER_KEY=
MARKETING_TICK_SECRET=
BACKUP_TICK_SECRET=
PLATFORM_TICK_SECRET=

# ─── The first workspace: Deskzo's own, at deskzo.deskzo.com ─────────────────────────────────────
TENANCY_DEFAULT_SLUG=deskzo
TENANCY_DEFAULT_NAME=Deskzo

# ─── The platform's own mail: signup codes, setup links, billing reminders ──────────────────────
# Azure blocks outbound port 25, so use a provider on 587 or 465 (Microsoft 365, Google Workspace,
# Zoho, Amazon SES, Azure Communication Services…). Unset, mail is written to a folder, not sent.
PLATFORM_SMTP_URL=
PLATFORM_MAIL_FROM="Deskzo One <no-reply@deskzo.com>"
# Where the website's contact form and partner applications are mailed.
PLATFORM_SALES_EMAIL=

# ─── Optional ─────────────────────────────────────────────────────────────────────────────────────
# Only these networks reach the console (comma-separated CIDRs) — your office's, your home's.
# PLATFORM_CONSOLE_IP_ALLOWLIST=203.0.113.0/24
# Databases made ahead of signups, so a new workspace is ready in seconds.
# PLATFORM_WARM_POOL=2
DNS_RESOLVERS=1.1.1.1,8.8.8.8
